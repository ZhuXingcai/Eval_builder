{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "EvaluationFailureClass": {
      "enum": [
        "CONTESTANT_FAILURE",
        "EVALUATOR_FAILURE",
        "ENVIRONMENT_FAILURE",
        "INDETERMINATE"
      ],
      "title": "EvaluationFailureClass",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/evaluator_spec.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "evaluator_spec_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Evaluator Spec Id",
      "type": "string"
    },
    "evaluator_type": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Evaluator Type",
      "type": "string"
    },
    "evaluator_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Evaluator Version",
      "type": "string"
    },
    "failure_classes": {
      "items": {
        "$ref": "#/$defs/EvaluationFailureClass"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Failure Classes",
      "type": "array",
      "uniqueItems": true
    },
    "input_contract_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "output_contract_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "rubric_set_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/evaluator-spec/v1",
      "default": "eval-factory/evaluator-spec/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "evaluator_spec_id",
    "rubric_set_ref",
    "evaluator_type",
    "evaluator_version",
    "input_contract_ref",
    "output_contract_ref",
    "failure_classes",
    "timeout_seconds",
    "audit"
  ],
  "title": "EvaluatorSpec",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task.EvaluatorSpec",
  "x-schema-version": "eval-factory/evaluator-spec/v1"
}
