  "required": [
    "invalidation_id",
    "review_record_ref",
    "reason_code",
    "source_ref",
    "policy_version",
    "invalidated_at",
    "invalidation_sha256"
  ],
  "title": "ReviewRecordInvalidation",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.quality.ReviewRecordInvalidation",
  "x-schema-version": "eval-factory/review-record-invalidation/v1"
}
