    "schema_version": {
      "const": "eval-factory/review-record-invalidation/v1",
      "default": "eval-factory/review-record-invalidation/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
