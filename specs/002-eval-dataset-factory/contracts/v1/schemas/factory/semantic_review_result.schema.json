{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "SemanticReviewRound": {
      "enum": [
        "COVERAGE_SOLVABILITY",
        "REALISM_CONSISTENCY",
        "LEAKAGE_EXECUTABILITY"
      ],
      "title": "SemanticReviewRound",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/semantic_review_result.schema.json",
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "clean_context_attestation_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "evaluated_subject_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Evaluated Subject Refs",
      "type": "array"
    },
    "finding_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Finding Refs",
      "type": "array"
    },
    "prior_typed_finding_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Prior Typed Finding Refs",
      "type": "array"
    },
    "round": {
      "$ref": "#/$defs/SemanticReviewRound"
    },
    "schema_version": {
      "const": "eval-factory/semantic-review-result/v1",
      "default": "eval-factory/semantic-review-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_review_result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Semantic Review Result Id",
      "type": "string"
    },
    "stage_run_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "semantic_review_result_id",
    "round",
    "stage_run_ref",
    "clean_context_attestation_ref",
    "evaluated_subject_refs",
    "finding_refs",
    "accepted",
    "audit"
  ],
  "title": "SemanticReviewResult",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.quality.SemanticReviewResult",
  "x-schema-version": "eval-factory/semantic-review-result/v1"
}
