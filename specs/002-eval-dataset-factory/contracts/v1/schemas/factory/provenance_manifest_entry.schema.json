{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PackageInventoryMember": {
      "additionalProperties": false,
      "properties": {
        "container_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Ref"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "member_type": {
          "enum": [
            "DIRECTORY",
            "FILE",
            "NESTED_MEMBER"
          ],
          "title": "Member Type",
          "type": "string"
        },
        "normalized_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Normalized Path",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/package-inventory-member/v1",
          "default": "eval-factory/package-inventory-member/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "normalized_path",
        "member_type",
        "size_bytes"
      ],
      "title": "PackageInventoryMember",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/provenance_manifest_entry.schema.json",
  "additionalProperties": false,
  "properties": {
    "derivation_closure_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Derivation Closure Refs",
      "type": "array"
    },
    "inventory_member": {
      "$ref": "#/$defs/PackageInventoryMember"
    },
    "provenance_decision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/provenance-manifest-entry/v1",
      "default": "eval-factory/provenance-manifest-entry/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "inventory_member",
    "provenance_decision_ref",
    "derivation_closure_refs"
  ],
  "title": "ProvenanceManifestEntry",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.safety.ProvenanceManifestEntry",
  "x-schema-version": "eval-factory/provenance-manifest-entry/v1"
}
