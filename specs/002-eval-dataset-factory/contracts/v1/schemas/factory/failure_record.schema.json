{
  "$defs": {
    "EvidencePolarity": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "UNCERTAINTY",
        "CONTRADICTION"
      ],
      "title": "EvidencePolarity",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Capability",
          "type": "string"
        },
        "capability_complete": {
          "title": "Capability Complete",
          "type": "boolean"
        },
        "evidence_ref_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Evidence Ref Id",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/EvidencePolarity"
        },
        "schema_version": {
          "const": "eval-factory/evidence-ref/v1",
          "default": "eval-factory/evidence-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpanRef"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        },
        "subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "evidence_ref_id",
        "subject_ref",
        "source_spans",
        "polarity",
        "capability",
        "capability_complete"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FailureClass": {
      "enum": [
        "CONTESTANT_FAILURE",
        "EVALUATOR_FAILURE",
        "ENVIRONMENT_FAILURE",
        "INDETERMINATE",
        "POLICY_FAILURE",
        "CAPABILITY_FAILURE",
        "INTERNAL_FAILURE"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "SourceSpanRef": {
      "additionalProperties": false,
      "properties": {
        "approximate": {
          "default": false,
          "title": "Approximate",
          "type": "boolean"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/source-span-ref/v1",
          "default": "eval-factory/source-span-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_trace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Source Trace Id",
          "type": "string"
        },
        "span_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "source_trace_id",
        "raw_sha256"
      ],
      "title": "SourceSpanRef",
      "type": "object"
    },
    "TypedAttribute": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Key",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/typed-attribute/v1",
          "default": "eval-factory/typed-attribute/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "TypedAttribute",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/failure_record.schema.json",
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Code",
      "type": "string"
    },
    "detail": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TypedAttribute"
      },
      "title": "Detail",
      "type": "array"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "failure_class": {
      "$ref": "#/$defs/FailureClass"
    },
    "message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "schema_version": {
      "const": "eval-factory/failure-record/v1",
      "default": "eval-factory/failure-record/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "failure_class",
    "code",
    "message",
    "retryable"
  ],
  "title": "FailureRecord",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.core.FailureRecord",
  "x-schema-version": "eval-factory/failure-record/v1"
}
