{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "StageName": {
      "enum": [
        "trace_index",
        "safety",
        "label",
        "task_authoring",
        "attachment",
        "item_quality",
        "batch_quality",
        "human_review",
        "release"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageRunStatus": {
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED_POLICY",
        "BLOCKED_CAPABILITY",
        "RETRYABLE_FAILURE",
        "TERMINAL_FAILURE",
        "SUCCEEDED",
        "CANCELLED"
      ],
      "title": "StageRunStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/stage_run.schema.json",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "item_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Job Id",
      "type": "string"
    },
    "principal_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "retry_of": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "eval-factory/stage-run/v1",
      "default": "eval-factory/stage-run/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/StageName"
    },
    "stage_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Stage Run Id",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/StageRunStatus"
    }
  },
  "required": [
    "stage_run_id",
    "job_id",
    "stage",
    "attempt",
    "status",
    "principal_ref",
    "input_refs",
    "idempotency_key"
  ],
  "title": "StageRun",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.orchestration.StageRun",
  "x-schema-version": "eval-factory/stage-run/v1"
}
