{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/batch_quality_report.schema.json",
  "additionalProperties": false,
  "properties": {
    "approvable": {
      "title": "Approvable",
      "type": "boolean"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "batch_finding_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Batch Finding Refs",
      "type": "array"
    },
    "batch_quality_report_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Batch Quality Report Id",
      "type": "string"
    },
    "item_quality_report_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Item Quality Report Refs",
      "type": "array"
    },
    "open_p0_count": {
      "minimum": 0,
      "title": "Open P0 Count",
      "type": "integer"
    },
    "open_p1_count": {
      "minimum": 0,
      "title": "Open P1 Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "eval-factory/batch-quality-report/v1",
      "default": "eval-factory/batch-quality-report/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "batch_quality_report_id",
    "item_quality_report_refs",
    "batch_finding_refs",
    "open_p0_count",
    "open_p1_count",
    "approvable",
    "audit"
  ],
  "title": "BatchQualityReport",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.quality.BatchQualityReport",
  "x-schema-version": "eval-factory/batch-quality-report/v1"
}
