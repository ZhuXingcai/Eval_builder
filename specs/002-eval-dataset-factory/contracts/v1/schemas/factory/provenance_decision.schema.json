{
  "$defs": {
    "ContentRiskLabel": {
      "enum": [
        "ANSWER_BEARING",
        "HIDDEN_PASS_CONDITION",
        "SECRET",
        "RESTRICTED_PII",
        "PROMPT_INJECTION",
        "UNSCANNABLE_CONTENT"
      ],
      "title": "ContentRiskLabel",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "Disposition": {
      "enum": [
        "ALLOW_INPUT_EVIDENCE",
        "ALLOW_STRUCTURE_ONLY",
        "ALLOW_EXTERNAL_LEAD_ONLY",
        "NEEDS_REVIEW",
        "QUARANTINE",
        "REJECT"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "OriginClass": {
      "enum": [
        "USER_SUPPLIED_INPUT",
        "PREEXISTING_WORKSPACE_INPUT",
        "SYSTEM_OR_HARNESS_CONTEXT",
        "AGENT_RETRIEVED_EXTERNAL",
        "AGENT_GENERATED_INTERMEDIATE",
        "AGENT_GENERATED_FINAL",
        "UNKNOWN"
      ],
      "title": "OriginClass",
      "type": "string"
    },
    "TaintLabel": {
      "enum": [
        "FINAL_OUTPUT_DERIVED",
        "PRIVATE_REFERENCE_DERIVED",
        "GRADER_RULE_DERIVED",
        "UNKNOWN_DERIVATION",
        "SENSITIVE_SOURCE_DERIVED",
        "UNTRUSTED_INSTRUCTION_DERIVED"
      ],
      "title": "TaintLabel",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    },
    "Visibility": {
      "enum": [
        "PRIVATE_STORE",
        "PRIVILEGED_AUDIT",
        "STAGE_PROJECTION",
        "EVALUATOR_PROJECTION",
        "CONTESTANT_VISIBLE",
        "PUBLIC_RELEASE"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/provenance_decision.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "content_risk_labels": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContentRiskLabel"
      },
      "title": "Content Risk Labels",
      "type": "array",
      "uniqueItems": true
    },
    "derived_from": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Derived From",
      "type": "array"
    },
    "disposition": {
      "$ref": "#/$defs/Disposition"
    },
    "origin_class": {
      "$ref": "#/$defs/OriginClass"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "provenance_decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Provenance Decision Id",
      "type": "string"
    },
    "review_required": {
      "title": "Review Required",
      "type": "boolean"
    },
    "rule_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Rule Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/provenance-decision/v1",
      "default": "eval-factory/provenance-decision/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_event_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Source Event Refs",
      "type": "array"
    },
    "subject_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "subject_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Subject Sha256",
      "type": "string"
    },
    "taint_labels": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaintLabel"
      },
      "title": "Taint Labels",
      "type": "array",
      "uniqueItems": true
    },
    "visibility": {
      "$ref": "#/$defs/Visibility"
    }
  },
  "required": [
    "provenance_decision_id",
    "subject_ref",
    "origin_class",
    "visibility",
    "disposition",
    "rule_ids",
    "confidence",
    "review_required",
    "policy_version",
    "subject_sha256",
    "audit"
  ],
  "title": "ProvenanceDecision",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.safety.ProvenanceDecision",
  "x-schema-version": "eval-factory/provenance-decision/v1"
}
