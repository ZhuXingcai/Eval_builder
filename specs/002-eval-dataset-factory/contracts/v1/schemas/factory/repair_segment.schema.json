    },
    "decoded_char_start": {
      "minimum": 0,
      "title": "Decoded Char Start",
      "type": "integer"
    },
    "exact": {
      "title": "Exact",
      "type": "boolean"
    },
    "raw_byte_end": {
      "minimum": 0,
