{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PredicateOperator": {
      "enum": [
        "EXISTS",
        "NOT_EXISTS",
        "EQUALS",
        "CONTAINS",
        "REGEX",
        "SEQUENCE",
        "WITHIN_WINDOW",
        "ERROR_SIGNATURE"
      ],
      "title": "PredicateOperator",
      "type": "string"
    },
    "SemanticResidualSpec": {
      "additionalProperties": false,
      "properties": {
        "abstain_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Abstain Conditions",
          "type": "array"
        },
        "allowed_evidence_types": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Evidence Types",
          "type": "array"
        },
        "evidence_bundle_purpose": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Evidence Bundle Purpose",
          "type": "string"
        },
        "model_profile": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Model Profile",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "residual_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Residual Id",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/semantic-residual-spec/v1",
          "default": "eval-factory/semantic-residual-spec/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "residual_id",
        "question",
        "evidence_bundle_purpose",
        "allowed_evidence_types",
        "abstain_conditions",
        "model_profile",
        "prompt_version"
      ],
      "title": "SemanticResidualSpec",
      "type": "object"
    },
    "StructuredPredicate": {
      "additionalProperties": false,
      "properties": {
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "fact_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Fact Type",
          "type": "string"
        },
        "field_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/PredicateOperator"
        },
        "predicate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Predicate Id",
          "type": "string"
        },
        "required_capability": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Required Capability",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/structured-predicate/v1",
          "default": "eval-factory/structured-predicate/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "window_events": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Events"
        }
      },
      "required": [
        "predicate_id",
        "fact_type",
        "field_path",
        "operator",
        "required_capability"
      ],
      "title": "StructuredPredicate",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/label_spec.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "decision_threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Decision Threshold",
      "type": "number"
    },
    "label_spec_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Label Spec Id",
      "type": "string"
    },
    "label_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Label Version",
      "type": "string"
    },
    "name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "negative_predicates": {
      "items": {
        "$ref": "#/$defs/StructuredPredicate"
      },
      "title": "Negative Predicates",
      "type": "array"
    },
    "positive_predicates": {
      "items": {
        "$ref": "#/$defs/StructuredPredicate"
      },
      "title": "Positive Predicates",
      "type": "array"
    },
    "requirement": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Requirement",
      "type": "string"
    },
    "review_threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Review Threshold",
      "type": "number"
    },
    "schema_version": {
      "const": "eval-factory/label-spec/v1",
      "default": "eval-factory/label-spec/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_residual": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticResidualSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "label_spec_id",
    "label_version",
    "name",
    "requirement",
    "positive_predicates",
    "negative_predicates",
    "decision_threshold",
    "review_threshold",
    "audit"
  ],
  "title": "LabelSpec",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.labeling.LabelSpec",
  "x-schema-version": "eval-factory/label-spec/v1"
}
