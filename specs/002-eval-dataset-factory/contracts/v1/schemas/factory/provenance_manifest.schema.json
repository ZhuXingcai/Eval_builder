{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PackageInventoryMember": {
      "additionalProperties": false,
      "properties": {
        "container_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Ref"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "member_type": {
          "enum": [
            "DIRECTORY",
            "FILE",
            "NESTED_MEMBER"
          ],
          "title": "Member Type",
          "type": "string"
        },
        "normalized_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Normalized Path",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/package-inventory-member/v1",
          "default": "eval-factory/package-inventory-member/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "normalized_path",
        "member_type",
        "size_bytes"
      ],
      "title": "PackageInventoryMember",
      "type": "object"
    },
    "ProvenanceManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "derivation_closure_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Derivation Closure Refs",
          "type": "array"
        },
        "inventory_member": {
          "$ref": "#/$defs/PackageInventoryMember"
        },
        "provenance_decision_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/provenance-manifest-entry/v1",
          "default": "eval-factory/provenance-manifest-entry/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "inventory_member",
        "provenance_decision_ref",
        "derivation_closure_refs"
      ],
      "title": "ProvenanceManifestEntry",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/provenance_manifest.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ProvenanceManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "exact_set_verified": {
      "title": "Exact Set Verified",
      "type": "boolean"
    },
    "inventory_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "provenance_manifest_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Provenance Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/provenance-manifest/v1",
      "default": "eval-factory/provenance-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "provenance_manifest_id",
    "package_sha256",
    "inventory_ref",
    "entries",
    "exact_set_verified",
    "policy_version",
    "audit"
  ],
  "title": "ProvenanceManifest",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.safety.ProvenanceManifest",
  "x-schema-version": "eval-factory/provenance-manifest/v1"
}
