{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "EvaluationItemComponents": {
      "additionalProperties": false,
      "properties": {
        "environment_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "evaluator_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "provenance_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "quality_report_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "query_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "reference_policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rubric_set_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/evaluation-item-components/v1",
          "default": "eval-factory/evaluation-item-components/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "query_spec_ref",
        "environment_spec_ref",
        "rubric_set_ref",
        "evaluator_spec_ref",
        "reference_policy_ref",
        "tool_policy_ref",
        "provenance_manifest_ref",
        "quality_report_ref"
      ],
      "title": "EvaluationItemComponents",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/factory/evaluation_item.schema.json",
  "additionalProperties": false,
  "properties": {
    "attachment_reconstruction_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "components": {
      "$ref": "#/$defs/EvaluationItemComponents"
    },
    "evaluation_item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Evaluation Item Id",
      "type": "string"
    },
    "item_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Item Sha256",
      "type": "string"
    },
    "item_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Item Version",
      "type": "string"
    },
    "label_decision_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Label Decision Refs",
      "type": "array"
    },
    "release_decision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/evaluation-item/v1",
      "default": "eval-factory/evaluation-item/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_trace_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Source Trace Refs",
      "type": "array"
    },
    "task_draft_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "evaluation_item_id",
    "item_version",
    "source_trace_refs",
    "label_decision_refs",
    "task_draft_ref",
    "attachment_reconstruction_result_ref",
    "components",
    "release_decision_ref",
    "item_sha256",
    "audit"
  ],
  "title": "EvaluationItem",
  "type": "object",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.release.EvaluationItem",
  "x-schema-version": "eval-factory/evaluation-item/v1"
}
