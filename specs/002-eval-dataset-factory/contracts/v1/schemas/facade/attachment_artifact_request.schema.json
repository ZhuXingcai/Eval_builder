{
  "$defs": {
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    },
    "ReconstructionMode": {
      "enum": [
        "TRACE_RICH",
        "SKELETON_GUIDED",
        "PROMPT_ONLY",
        "BLOCKED"
      ],
      "title": "ReconstructionMode",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v1/facade/attachment_artifact_request.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "build_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Build Spec Sha256",
      "type": "string"
    },
    "content_contract_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "critical": {
      "title": "Critical",
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/FacadeObjectRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "media_type": {
      "maxLength": 255,
      "minLength": 3,
      "title": "Media Type",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ReconstructionMode"
    },
    "provider_preference": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Provider Preference",
      "type": "array"
    },
    "relative_path": {
      "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
      "title": "Relative Path",
      "type": "string"
    },
    "render_contract_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "runtime_preference": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Runtime Preference",
      "type": "array"
    },
    "validator_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Validator Ids",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "build_spec_sha256",
    "relative_path",
    "media_type",
    "mode",
    "critical",
    "content_contract_ref",
    "render_contract_ref",
    "evidence_refs",
    "provider_preference",
    "runtime_preference",
    "validator_ids"
  ],
  "title": "AttachmentArtifactRequest",
  "type": "object",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.contracts.AttachmentArtifactRequest"
}
