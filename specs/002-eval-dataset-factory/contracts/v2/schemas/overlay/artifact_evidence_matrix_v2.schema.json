{
  "$defs": {
    "ArtifactEvidenceRow": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "blocking_uncertainties": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Blocking Uncertainties",
          "type": "array"
        },
        "criticality": {
          "$ref": "#/$defs/AttachmentCriticality"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "logical_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Logical Path",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Media Type",
          "type": "string"
        },
        "path_evidence": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "pre_mutation_coverage": {
          "$ref": "#/$defs/EvidenceCoverage"
        },
        "provenance_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Provenance Confidence",
          "type": "number"
        },
        "schema_version": {
          "const": "eval-factory/artifact-evidence-row/v1",
          "default": "eval-factory/artifact-evidence-row/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_mode": {
          "$ref": "#/$defs/ReconstructionMode"
        },
        "structure_coverage": {
          "$ref": "#/$defs/EvidenceCoverage"
        },
        "truncation": {
          "enum": [
            "NONE",
            "PRESENT",
            "UNKNOWN"
          ],
          "title": "Truncation",
          "type": "string"
        },
        "type_evidence": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "untainted_content_coverage": {
          "$ref": "#/$defs/EvidenceCoverage"
        }
      },
      "required": [
        "artifact_id",
        "logical_path",
        "media_type",
        "path_evidence",
        "type_evidence",
        "structure_coverage",
        "untainted_content_coverage",
        "pre_mutation_coverage",
        "provenance_confidence",
        "truncation",
        "criticality",
        "evidence",
        "selected_mode"
      ],
      "title": "ArtifactEvidenceRow",
      "type": "object"
    },
    "ArtifactEvidenceRowV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_evidence_row_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Artifact Evidence Row Id",
          "type": "string"
        },
        "artifact_evidence_row_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Evidence Row Sha256",
          "type": "string"
        },
        "artifact_evidence_target_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "attachment_dependency_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Attachment Dependency Id",
          "type": "string"
        },
        "attachment_planning_context_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "r2_policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "R2 Policy Version",
          "type": "string"
        },
        "r2_row_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "R2 Row Sha256",
          "type": "string"
        },
        "row": {
          "$ref": "#/$defs/ArtifactEvidenceRow"
        },
        "schema_version": {
          "const": "eval-factory/artifact-evidence-row/v2",
          "default": "eval-factory/artifact-evidence-row/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_evidence_row_id",
        "attachment_planning_context_ref",
        "artifact_evidence_target_ref",
        "attachment_dependency_id",
        "row",
        "r2_row_sha256",
        "r2_policy_version",
        "policy_version",
        "artifact_evidence_row_sha256",
        "audit"
      ],
      "title": "ArtifactEvidenceRowV2",
      "type": "object"
    },
    "AttachmentCriticality": {
      "enum": [
        "CRITICAL",
        "REQUIRED",
        "OPTIONAL"
      ],
      "title": "AttachmentCriticality",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "EvidenceCoverage": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "NONE",
        "UNKNOWN"
      ],
      "title": "EvidenceCoverage",
      "type": "string"
    },
    "EvidencePolarity": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "UNCERTAINTY",
        "CONTRADICTION"
      ],
      "title": "EvidencePolarity",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Capability",
          "type": "string"
        },
        "capability_complete": {
          "title": "Capability Complete",
          "type": "boolean"
        },
        "evidence_ref_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Evidence Ref Id",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/EvidencePolarity"
        },
        "schema_version": {
          "const": "eval-factory/evidence-ref/v1",
          "default": "eval-factory/evidence-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpanRef"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        },
        "subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "evidence_ref_id",
        "subject_ref",
        "source_spans",
        "polarity",
        "capability",
        "capability_complete"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceStrength": {
      "enum": [
        "DIRECT",
        "INFERRED",
        "MISSING"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ReconstructionMode": {
      "enum": [
        "TRACE_RICH",
        "SKELETON_GUIDED",
        "PROMPT_ONLY",
        "BLOCKED"
      ],
      "title": "ReconstructionMode",
      "type": "string"
    },
    "SourceSpanRef": {
      "additionalProperties": false,
      "properties": {
        "approximate": {
          "default": false,
          "title": "Approximate",
          "type": "boolean"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/source-span-ref/v1",
          "default": "eval-factory/source-span-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_trace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Source Trace Id",
          "type": "string"
        },
        "span_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "source_trace_id",
        "raw_sha256"
      ],
      "title": "SourceSpanRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/artifact_evidence_matrix_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "aggregate_mode": {
      "enum": [
        "TRACE_RICH",
        "SKELETON_GUIDED",
        "PROMPT_ONLY",
        "MIXED",
        "BLOCKED"
      ],
      "title": "Aggregate Mode",
      "type": "string"
    },
    "artifact_evidence_matrix_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Artifact Evidence Matrix Id",
      "type": "string"
    },
    "artifact_evidence_matrix_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Evidence Matrix Sha256",
      "type": "string"
    },
    "attachment_planning_context_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "producer_task_view_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "r2_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "R2 Policy Version",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ArtifactEvidenceRowV2"
      },
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "safe_evidence_bundle_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/artifact-evidence-matrix/v2",
      "default": "eval-factory/artifact-evidence-matrix/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_r2_matrix_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "artifact_evidence_matrix_id",
    "attachment_planning_context_ref",
    "producer_task_view_ref",
    "safe_evidence_bundle_ref",
    "source_r2_matrix_ref",
    "rows",
    "aggregate_mode",
    "r2_policy_version",
    "policy_version",
    "artifact_evidence_matrix_sha256",
    "audit"
  ],
  "title": "ArtifactEvidenceMatrixV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.attachment_v2.ArtifactEvidenceMatrixV2",
  "x-schema-version": "eval-factory/artifact-evidence-matrix/v2"
}
