{
  "$defs": {
    "JobStatus": {
      "enum": [
        "CREATED",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/pipeline_create_result_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "item_count": {
      "minimum": 0,
      "title": "Item Count",
      "type": "integer"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Job Id",
      "type": "string"
    },
    "job_status": {
      "$ref": "#/$defs/JobStatus"
    },
    "job_version": {
      "minimum": 0,
      "title": "Job Version",
      "type": "integer"
    },
    "resolved_plan_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/pipeline-create-result/v2",
      "default": "eval-factory/pipeline-create-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "work_control_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "work_graph_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "work_unit_count": {
      "minimum": 0,
      "title": "Work Unit Count",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "job_status",
    "job_version",
    "resolved_plan_ref",
    "work_graph_ref",
    "work_control_policy_ref",
    "item_count",
    "work_unit_count"
  ],
  "title": "PipelineCreateResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.cli_v2.PipelineCreateResultV2",
  "x-schema-version": "eval-factory/pipeline-create-result/v2"
}
