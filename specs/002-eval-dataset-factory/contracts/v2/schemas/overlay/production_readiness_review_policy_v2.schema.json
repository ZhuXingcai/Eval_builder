{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "OperationsSLOMetricNameV2": {
      "enum": [
        "THROUGHPUT_MILLIJOBS_PER_SECOND",
        "P50_LATENCY_MICROSECONDS",
        "P95_LATENCY_MICROSECONDS",
        "MODEL_REQUESTS_PER_JOB_MILLI",
        "COST_MICRO_USD_PER_JOB",
        "QUEUE_WAIT_P95_MICROSECONDS",
        "ERROR_RATE_BASIS_POINTS",
        "RESUME_SUCCESS_BASIS_POINTS"
      ],
      "title": "OperationsSLOMetricNameV2",
      "type": "string"
    },
    "ProductionReadinessReviewDomainV2": {
      "enum": [
        "SECURITY",
        "PRIVACY",
        "RELEASE_PERMISSION",
        "OPERATIONS_SLO"
      ],
      "title": "ProductionReadinessReviewDomainV2",
      "type": "string"
    },
    "ProductionReadinessReviewEvidenceClassV2": {
      "enum": [
        "PRODUCTION_ORGANIZATION_REVIEW",
        "MECHANISM_VALIDATION_ONLY",
        "REPOSITORY_PENDING_ONLY"
      ],
      "title": "ProductionReadinessReviewEvidenceClassV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/production_readiness_review_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "data_classification_policy_refs": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "$ref": "#/$defs/ObjectRef"
        }
      ],
      "title": "Data Classification Policy Refs",
      "type": "array"
    },
    "evidence_class": {
      "$ref": "#/$defs/ProductionReadinessReviewEvidenceClassV2"
    },
    "max_approvals": {
      "maximum": 1000,
      "minimum": 4,
      "title": "Max Approvals",
      "type": "integer"
    },
    "max_evidence_refs": {
      "maximum": 10000,
      "minimum": 4,
      "title": "Max Evidence Refs",
      "type": "integer"
    },
    "max_private_bytes": {
      "maximum": 1000000000000,
      "minimum": 2,
      "title": "Max Private Bytes",
      "type": "integer"
    },
    "max_report_bytes": {
      "maximum": 100000000,
      "minimum": 2,
      "title": "Max Report Bytes",
      "type": "integer"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "production-readiness-review/r8-07-v1",
      "default": "production-readiness-review/r8-07-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "release_profile_decision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "repository_pending_evidence_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "required_domains": {
      "default": [
        "SECURITY",
        "PRIVACY",
        "RELEASE_PERMISSION",
        "OPERATIONS_SLO"
      ],
      "items": {
        "$ref": "#/$defs/ProductionReadinessReviewDomainV2"
      },
      "title": "Required Domains",
      "type": "array"
    },
    "required_operations_metrics": {
      "default": [
        "THROUGHPUT_MILLIJOBS_PER_SECOND",
        "P50_LATENCY_MICROSECONDS",
        "P95_LATENCY_MICROSECONDS",
        "MODEL_REQUESTS_PER_JOB_MILLI",
        "COST_MICRO_USD_PER_JOB",
        "QUEUE_WAIT_P95_MICROSECONDS",
        "ERROR_RATE_BASIS_POINTS",
        "RESUME_SUCCESS_BASIS_POINTS"
      ],
      "items": {
        "$ref": "#/$defs/OperationsSLOMetricNameV2"
      },
      "title": "Required Operations Metrics",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/production-readiness-review-policy/v2",
      "default": "eval-factory/production-readiness-review-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "trusted_authority_registry_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "user_approval_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "policy_id",
    "data_classification_policy_refs",
    "user_approval_policy_ref",
    "release_profile_decision_ref",
    "repository_pending_evidence_ref",
    "evidence_class",
    "max_approvals",
    "max_evidence_refs",
    "max_private_bytes",
    "max_report_bytes",
    "policy_sha256",
    "audit"
  ],
  "title": "ProductionReadinessReviewPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.production_readiness_review_v2.ProductionReadinessReviewPolicyV2",
  "x-schema-version": "eval-factory/production-readiness-review-policy/v2"
}
