        "case_result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Case Result Id",
          "type": "string"
        },
        "case_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Case Result Sha256",
          "type": "string"
        },
        "child_dataset_result_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "child_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "expectation": {
          "$ref": "#/$defs/CanaryRegressionExpectationV2"
        },
        "expectation_matched": {
          "title": "Expectation Matched",
          "type": "boolean"
        },
        "highest_reached_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageNameV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
