        "instance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Instance Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "item_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Job Id",
          "type": "string"
        },
        "job_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_outcome": {
          "$ref": "#/$defs/CanaryRegressionObservedOutcomeV2"
        },
        "package_manifest_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Package Manifest Refs",
          "type": "array"
        },
        "policy_version": {
          "const": "canary-regression/r8-03-v1",
          "default": "canary-regression/r8-03-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "provider_invocation_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Provider Invocation Count",
          "type": "integer"
        },
        "quality_result_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Quality Result Refs",
          "type": "array"
        },
        "reason_code": {
          "$ref": "#/$defs/CanaryRegressionReasonCodeV2"
        },
        "resume_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Resume Count",
          "type": "integer"
        },
        "retry_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "eval-factory/canary-regression-case-result/v2",
          "default": "eval-factory/canary-regression-case-result/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "signal_quality": {
          "enum": [
            "strict_events",
            "heuristic_requires_annotation"
          ],
          "title": "Signal Quality",
          "type": "string"
        },
        "source_trace_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "stage_result_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Stage Result Refs",
          "type": "array"
        },
        "stage_run_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Stage Run Count",
          "type": "integer"
        },
        "work_lease_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Work Lease Count",
          "type": "integer"
        },
        "work_unit_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Work Unit Count",
          "type": "integer"
        }
      },
      "required": [
        "case_result_id",
        "instance_id",
        "source_trace_ref",
        "signal_quality",
        "expectation",
        "observed_outcome",
        "expectation_matched",
        "reason_code",
        "child_manifest_ref",
        "job_id",
        "work_unit_count",
        "work_lease_count",
        "stage_run_count",
        "attempt_count",
        "retry_count",
        "resume_count",
        "provider_invocation_count",
        "case_result_sha256",
        "audit"
      ],
      "title": "CanaryRegressionCaseResultV2",
      "type": "object"
    },
    "CanaryRegressionExpectationV2": {
      "enum": [
        "MUST_SUCCEED",
        "ANY_TYPED_TERMINAL"
      ],
      "title": "CanaryRegressionExpectationV2",
      "type": "string"
    },
    "CanaryRegressionObservedOutcomeV2": {
      "enum": [
        "SUCCEEDED",
        "BLOCKED",
        "FAILED",
        "INFRASTRUCTURE_ERROR",
        "INCOMPLETE"
      ],
      "title": "CanaryRegressionObservedOutcomeV2",
      "type": "string"
    },
    "CanaryRegressionOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "INCOMPLETE"
      ],
      "title": "CanaryRegressionOutcomeV2",
      "type": "string"
    },
    "CanaryRegressionReasonCodeV2": {
      "enum": [
        "NONE",
        "LABEL_NO_MATCH",
        "STAGE_BLOCKED_POLICY",
        "STAGE_BLOCKED_CAPABILITY",
        "STAGE_RETRY_EXHAUSTED",
        "RESOURCE_WAITING",
        "RESOURCE_BUDGET_EXHAUSTED",
        "RESOURCE_UNSATISFIABLE",
        "PROFILE_POLICY_ERROR",
        "LIFECYCLE_POLICY_ERROR",
        "MATERIAL_INTEGRITY_ERROR",
        "CHILD_STATE_INCOMPLETE",
        "OUTCOME_MISMATCH",
        "INTERNAL_ERROR"
      ],
      "title": "CanaryRegressionReasonCodeV2",
      "type": "string"
    },
    "CanaryRegressionStageSummaryV2": {
      "additionalProperties": false,
      "properties": {
        "reached_count": {
          "maximum": 30,
          "minimum": 0,
          "title": "Reached Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "eval-factory/canary-regression-stage-summary/v2",
          "default": "eval-factory/canary-regression-stage-summary/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/StageNameV2"
        },
        "terminal_count": {
          "maximum": 30,
          "minimum": 0,
          "title": "Terminal Count",
          "type": "integer"
        }
      },
      "required": [
        "stage",
        "reached_count",
        "terminal_count"
      ],
      "title": "CanaryRegressionStageSummaryV2",
      "type": "object"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
