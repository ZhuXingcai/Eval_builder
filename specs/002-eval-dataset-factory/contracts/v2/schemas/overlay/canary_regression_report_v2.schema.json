{
  "$defs": {
    "CanaryRegressionCaseResultV2": {
      "additionalProperties": false,
      "properties": {
        "attempt_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "audit_report_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
