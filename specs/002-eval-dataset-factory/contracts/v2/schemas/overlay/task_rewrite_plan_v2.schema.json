{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/task_rewrite_plan_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "acceptance_check_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Acceptance Check Refs",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "extracted_prompt_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "fidelity_constraints": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Fidelity Constraints",
      "type": "array"
    },
    "forbidden_transformations": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Forbidden Transformations",
      "type": "array"
    },
    "inferred_intent_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "rewrite_plan_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Rewrite Plan Id",
      "type": "string"
    },
    "rewrite_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/task-rewrite-plan/v2",
      "default": "eval-factory/task-rewrite-plan/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "target_capabilities": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Target Capabilities",
      "type": "array"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "rewrite_plan_id",
    "extracted_prompt_ref",
    "inferred_intent_ref",
    "rewrite_policy_ref",
    "target_capabilities",
    "fidelity_constraints",
    "forbidden_transformations",
    "acceptance_check_refs"
  ],
  "title": "TaskRewritePlanV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.agent_system_v2.TaskRewritePlanV2",
  "x-schema-version": "eval-factory/task-rewrite-plan/v2"
}
