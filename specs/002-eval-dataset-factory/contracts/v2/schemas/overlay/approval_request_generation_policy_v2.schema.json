{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/approval_request_generation_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "generation_policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Generation Policy Id",
      "type": "string"
    },
    "max_examples_per_plan": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Examples Per Plan",
      "type": "integer"
    },
    "max_final_sample_refs": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Final Sample Refs",
      "type": "integer"
    },
    "max_preview_characters_per_checkpoint": {
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Max Preview Characters Per Checkpoint",
      "type": "integer"
    },
    "max_preview_characters_per_request": {
      "maximum": 100000000,
      "minimum": 1,
      "title": "Max Preview Characters Per Request",
      "type": "integer"
    },
    "max_preview_refs_per_request": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Preview Refs Per Request",
      "type": "integer"
    },
    "max_requests_per_checkpoint": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Requests Per Checkpoint",
      "type": "integer"
    },
    "max_subject_refs_per_request": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Subject Refs Per Request",
      "type": "integer"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "user-approval-request/r7-04-v1",
      "default": "user-approval-request/r7-04-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/approval-request-generation-policy/v2",
      "default": "eval-factory/approval-request-generation-policy/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "generation_policy_id",
    "max_requests_per_checkpoint",
    "max_subject_refs_per_request",
    "max_preview_refs_per_request",
    "max_examples_per_plan",
    "max_preview_characters_per_request",
    "max_preview_characters_per_checkpoint",
    "max_final_sample_refs",
    "policy_sha256",
    "audit"
  ],
  "title": "ApprovalRequestGenerationPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.approval_v2.ApprovalRequestGenerationPolicyV2",
  "x-schema-version": "eval-factory/approval-request-generation-policy/v2"
}
