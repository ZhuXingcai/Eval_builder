{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PackageInventoryMember": {
      "additionalProperties": false,
      "properties": {
        "container_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Ref"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "member_type": {
          "enum": [
            "DIRECTORY",
            "FILE",
            "NESTED_MEMBER"
          ],
          "title": "Member Type",
          "type": "string"
        },
        "normalized_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Normalized Path",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/package-inventory-member/v1",
          "default": "eval-factory/package-inventory-member/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "normalized_path",
        "member_type",
        "size_bytes"
      ],
      "title": "PackageInventoryMember",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/candidate_package_inventory_entry_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_build_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "artifact_validation_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "build_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "container_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "derivation_root_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Derivation Root Refs",
      "type": "array"
    },
    "entry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Entry Sha256",
      "type": "string"
    },
    "inventory_member": {
      "$ref": "#/$defs/PackageInventoryMember"
    },
    "inventory_member_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "output_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/candidate-package-inventory-entry/v2",
      "default": "eval-factory/candidate-package-inventory-entry/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "inventory_member",
    "inventory_member_ref",
    "artifact_build_result_ref",
    "artifact_validation_result_ref",
    "output_ref",
    "build_spec_ref",
    "derivation_root_refs",
    "entry_sha256"
  ],
  "title": "CandidatePackageInventoryEntryV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.validation_v2.CandidatePackageInventoryEntryV2",
  "x-schema-version": "eval-factory/candidate-package-inventory-entry/v2"
}
