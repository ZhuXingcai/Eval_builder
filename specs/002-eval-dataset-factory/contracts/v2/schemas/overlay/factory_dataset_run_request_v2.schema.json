{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/factory_dataset_run_request_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "dataset_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Dataset Run Id",
      "type": "string"
    },
    "factory_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "gateway_registry_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Gateway Registry Refs",
      "type": "array"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "max_transitions": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Transitions",
      "type": "integer"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "output_target_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "pipeline_policy_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Pipeline Policy Refs",
      "type": "array"
    },
    "requirement_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/factory-dataset-run-request/v2",
      "default": "eval-factory/factory-dataset-run-request/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_authorization_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "dataset_run_id",
    "requirement_spec_ref",
    "manifest_ref",
    "source_authorization_ref",
    "factory_policy_ref",
    "pipeline_policy_refs",
    "gateway_registry_refs",
    "output_target_ref",
    "idempotency_key",
    "max_transitions"
  ],
  "title": "FactoryDatasetRunRequestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.dataset_runtime_v2.FactoryDatasetRunRequestV2",
  "x-schema-version": "eval-factory/factory-dataset-run-request/v2"
}
