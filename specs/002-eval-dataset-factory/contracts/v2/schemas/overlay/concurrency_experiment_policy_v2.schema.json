{
  "$defs": {
    "ConcurrencyExperimentFaultPointV2": {
      "enum": [
        "BEFORE_HANDLER",
        "AFTER_OBJECT_PERSISTENCE",
        "BEFORE_LEASE_COMPLETION",
        "AFTER_LEASE_COMPLETION"
      ],
      "title": "ConcurrencyExperimentFaultPointV2",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/concurrency_experiment_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "canary_regression_report_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "case_count_per_trial": {
      "const": 24,
      "default": 24,
      "title": "Case Count Per Trial",
      "type": "integer"
    },
    "cohort_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "fault_points": {
      "default": [
        "BEFORE_HANDLER",
        "AFTER_OBJECT_PERSISTENCE",
        "BEFORE_LEASE_COMPLETION",
        "AFTER_LEASE_COMPLETION"
      ],
      "items": {
        "$ref": "#/$defs/ConcurrencyExperimentFaultPointV2"
      },
      "title": "Fault Points",
      "type": "array"
    },
    "max_capacity_readmissions": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Capacity Readmissions",
      "type": "integer"
    },
    "max_private_bytes": {
      "maximum": 1000000000000,
      "minimum": 2,
      "title": "Max Private Bytes",
      "type": "integer"
    },
    "max_report_bytes": {
      "maximum": 100000000,
      "minimum": 2,
      "title": "Max Report Bytes",
      "type": "integer"
    },
    "p95_baseline_limit_basis_points": {
      "const": 15000,
      "default": 15000,
      "title": "P95 Baseline Limit Basis Points",
      "type": "integer"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "concurrency-experiment/r8-06-v1",
      "default": "concurrency-experiment/r8-06-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "real_trace_stability_report_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "recovery_probe_count": {
      "const": 24,
      "default": 24,
      "title": "Recovery Probe Count",
      "type": "integer"
    },
    "scheduler_load_report_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/concurrency-experiment-policy/v2",
      "default": "eval-factory/concurrency-experiment-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "throughput_efficiency_basis_points": {
      "const": 9000,
      "default": 9000,
      "title": "Throughput Efficiency Basis Points",
      "type": "integer"
    },
    "trial_count_per_level": {
      "const": 3,
      "default": 3,
      "title": "Trial Count Per Level",
      "type": "integer"
    },
    "worker_levels": {
      "default": [
        1,
        2,
        4,
        8,
        16
      ],
      "items": {
        "enum": [
          1,
          2,
          4,
          8,
          16
        ],
        "type": "integer"
      },
      "title": "Worker Levels",
      "type": "array"
    }
  },
  "required": [
    "policy_id",
    "canary_regression_report_ref",
    "real_trace_stability_report_ref",
    "scheduler_load_report_ref",
    "cohort_manifest_ref",
    "max_capacity_readmissions",
    "max_private_bytes",
    "max_report_bytes",
    "policy_sha256",
    "audit"
  ],
  "title": "ConcurrencyExperimentPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.concurrency_experiment_v2.ConcurrencyExperimentPolicyV2",
  "x-schema-version": "eval-factory/concurrency-experiment-policy/v2"
}
