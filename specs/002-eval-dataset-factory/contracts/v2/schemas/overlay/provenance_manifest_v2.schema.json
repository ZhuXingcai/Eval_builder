{
  "$defs": {
    "CandidatePackageInventoryEntryV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_build_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "artifact_validation_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "build_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "container_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derivation_root_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Derivation Root Refs",
          "type": "array"
        },
        "entry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Entry Sha256",
          "type": "string"
        },
        "inventory_member": {
          "$ref": "#/$defs/PackageInventoryMember"
        },
        "inventory_member_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "output_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/candidate-package-inventory-entry/v2",
          "default": "eval-factory/candidate-package-inventory-entry/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "inventory_member",
        "inventory_member_ref",
        "artifact_build_result_ref",
        "artifact_validation_result_ref",
        "output_ref",
        "build_spec_ref",
        "derivation_root_refs",
        "entry_sha256"
      ],
      "title": "CandidatePackageInventoryEntryV2",
      "type": "object"
    },
    "ContentRiskLabel": {
      "enum": [
        "ANSWER_BEARING",
        "HIDDEN_PASS_CONDITION",
        "SECRET",
        "RESTRICTED_PII",
        "PROMPT_INJECTION",
        "UNSCANNABLE_CONTENT"
      ],
      "title": "ContentRiskLabel",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "Disposition": {
      "enum": [
        "ALLOW_INPUT_EVIDENCE",
        "ALLOW_STRUCTURE_ONLY",
        "ALLOW_EXTERNAL_LEAD_ONLY",
        "NEEDS_REVIEW",
        "QUARANTINE",
        "REJECT"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "OriginClass": {
      "enum": [
        "USER_SUPPLIED_INPUT",
        "PREEXISTING_WORKSPACE_INPUT",
        "SYSTEM_OR_HARNESS_CONTEXT",
        "AGENT_RETRIEVED_EXTERNAL",
        "AGENT_GENERATED_INTERMEDIATE",
        "AGENT_GENERATED_FINAL",
        "UNKNOWN"
      ],
      "title": "OriginClass",
      "type": "string"
    },
    "PackageInventoryMember": {
      "additionalProperties": false,
      "properties": {
        "container_ref": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Ref"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "member_type": {
          "enum": [
            "DIRECTORY",
            "FILE",
            "NESTED_MEMBER"
          ],
          "title": "Member Type",
          "type": "string"
        },
        "normalized_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Normalized Path",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/package-inventory-member/v1",
          "default": "eval-factory/package-inventory-member/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "normalized_path",
        "member_type",
        "size_bytes"
      ],
      "title": "PackageInventoryMember",
      "type": "object"
    },
    "PackageMemberProvenanceV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_validation_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "binding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "build_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "candidate_artifact_version_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "derivation_closure_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Derivation Closure Refs",
          "type": "array"
        },
        "final_package_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "inventory_entry": {
          "$ref": "#/$defs/CandidatePackageInventoryEntryV2"
        },
        "inventory_entry_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "inventory_member_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "output_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "package_member_provenance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Package Member Provenance Id",
          "type": "string"
        },
        "policy_version": {
          "const": "item-quality/r5-10-v1",
          "default": "item-quality/r5-10-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "provenance_decision": {
          "$ref": "#/$defs/ProvenanceDecision"
        },
        "provenance_decision_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/package-member-provenance/v2",
          "default": "eval-factory/package-member-provenance/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "package_member_provenance_id",
        "final_package_manifest_ref",
        "inventory_entry",
        "inventory_entry_ref",
        "inventory_member_ref",
        "candidate_artifact_version_ref",
        "output_ref",
        "build_spec_ref",
        "artifact_validation_result_ref",
        "derivation_closure_refs",
        "provenance_decision",
        "provenance_decision_ref",
        "binding_sha256",
        "audit"
      ],
      "title": "PackageMemberProvenanceV2",
      "type": "object"
    },
    "ProvenanceDecision": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "content_risk_labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentRiskLabel"
          },
          "title": "Content Risk Labels",
          "type": "array",
          "uniqueItems": true
        },
        "derived_from": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Derived From",
          "type": "array"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "origin_class": {
          "$ref": "#/$defs/OriginClass"
        },
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "provenance_decision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Provenance Decision Id",
          "type": "string"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "rule_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/provenance-decision/v1",
          "default": "eval-factory/provenance-decision/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_event_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Source Event Refs",
          "type": "array"
        },
        "subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "subject_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        },
        "taint_labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TaintLabel"
          },
          "title": "Taint Labels",
          "type": "array",
          "uniqueItems": true
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        }
      },
      "required": [
        "provenance_decision_id",
        "subject_ref",
        "origin_class",
        "visibility",
        "disposition",
        "rule_ids",
        "confidence",
        "review_required",
        "policy_version",
        "subject_sha256",
        "audit"
      ],
      "title": "ProvenanceDecision",
      "type": "object"
    },
    "TaintLabel": {
      "enum": [
        "FINAL_OUTPUT_DERIVED",
        "PRIVATE_REFERENCE_DERIVED",
        "GRADER_RULE_DERIVED",
        "UNKNOWN_DERIVATION",
        "SENSITIVE_SOURCE_DERIVED",
        "UNTRUSTED_INSTRUCTION_DERIVED"
      ],
      "title": "TaintLabel",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    },
    "Visibility": {
      "enum": [
        "PRIVATE_STORE",
        "PRIVILEGED_AUDIT",
        "STAGE_PROJECTION",
        "EVALUATOR_PROJECTION",
        "CONTESTANT_VISIBLE",
        "PUBLIC_RELEASE"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/provenance_manifest_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "candidate_revision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/PackageMemberProvenanceV2"
      },
      "title": "Entries",
      "type": "array"
    },
    "entry_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Entry Refs",
      "type": "array"
    },
    "exact_set_verified": {
      "const": true,
      "default": true,
      "title": "Exact Set Verified",
      "type": "boolean"
    },
    "final_package_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "package_inventory_entry_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Package Inventory Entry Refs",
      "type": "array"
    },
    "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "item-quality/r5-10-v1",
      "default": "item-quality/r5-10-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "provenance_manifest_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Provenance Manifest Id",
      "type": "string"
    },
    "provenance_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provenance Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/provenance-manifest/v2",
      "default": "eval-factory/provenance-manifest/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "provenance_manifest_id",
    "final_package_manifest_ref",
    "candidate_revision_ref",
    "package_sha256",
    "package_inventory_entry_refs",
    "entries",
    "entry_refs",
    "provenance_manifest_sha256",
    "audit"
  ],
  "title": "ProvenanceManifestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.quality_v2.ProvenanceManifestV2",
  "x-schema-version": "eval-factory/provenance-manifest/v2"
}
