{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/r4_task_contract_set_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "contestant_tool_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "contract_set_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Contract Set Id",
      "type": "string"
    },
    "contract_set_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Set Sha256",
      "type": "string"
    },
    "evaluator_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "producer_storage_authorization_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "producer_task_view_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "reference_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "rubric_set_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/r4-task-contract-set/v2",
      "default": "eval-factory/r4-task-contract-set/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "task_draft_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "task_prompt_safety_gate_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "tool_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "contract_set_id",
    "task_draft_ref",
    "task_prompt_safety_gate_ref",
    "rubric_set_ref",
    "evaluator_spec_ref",
    "reference_policy_ref",
    "tool_policy_ref",
    "contestant_tool_policy_ref",
    "producer_storage_authorization_ref",
    "producer_task_view_ref",
    "contract_set_sha256",
    "audit"
  ],
  "title": "R4TaskContractSetV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.R4TaskContractSetV2",
  "x-schema-version": "eval-factory/r4-task-contract-set/v2"
}
