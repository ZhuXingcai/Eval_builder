{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "OperationsSLOAssessmentOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "INCOMPLETE"
      ],
      "title": "OperationsSLOAssessmentOutcomeV2",
      "type": "string"
    },
    "ProductionReadinessApprovalDecisionV2": {
      "enum": [
        "APPROVED",
        "REJECTED"
      ],
      "title": "ProductionReadinessApprovalDecisionV2",
      "type": "string"
    },
    "ProductionReadinessApprovalRecordV2": {
      "additionalProperties": false,
      "properties": {
        "approval_record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Approval Record Id",
          "type": "string"
        },
        "approval_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Approval Record Sha256",
          "type": "string"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "authority_registry_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "decision": {
          "$ref": "#/$defs/ProductionReadinessApprovalDecisionV2"
        },
        "domain": {
          "$ref": "#/$defs/ProductionReadinessReviewDomainV2"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "policy_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Policy Refs",
          "type": "array"
        },
        "private_proof_commitment_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Private Proof Commitment Sha256",
          "type": "string"
        },
        "review_series_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Review Series Id",
          "type": "string"
        },
        "review_version": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Review Version",
          "type": "integer"
        },
        "schema_version": {
          "const": "eval-factory/production-readiness-approval-record/v2",
          "default": "eval-factory/production-readiness-approval-record/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Subject Refs",
          "type": "array"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "approval_record_id",
        "domain",
        "decision",
        "review_series_id",
        "review_version",
        "authority_registry_ref",
        "subject_refs",
        "evidence_refs",
        "policy_refs",
        "private_proof_commitment_sha256",
        "issued_at",
        "valid_from",
        "valid_until",
        "approval_record_sha256",
        "audit"
      ],
      "title": "ProductionReadinessApprovalRecordV2",
      "type": "object"
    },
    "ProductionReadinessDomainOutcomeV2": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "APPROVAL_PENDING"
      ],
      "title": "ProductionReadinessDomainOutcomeV2",
      "type": "string"
    },
    "ProductionReadinessReasonCodeV2": {
      "enum": [
        "NONE",
        "APPROVAL_MISSING",
        "AUTHORITY_UNVERIFIED",
        "AUTHORITY_NOT_INDEPENDENT",
        "APPROVAL_EXPIRED",
        "APPROVAL_SCOPE_MISMATCH",
        "PREDECESSOR_EVIDENCE_PENDING",
        "OPERATIONS_SLO_POLICY_MISSING",
        "OPERATIONS_SLO_EVIDENCE_INCOMPLETE",
        "OPERATIONS_SLO_THRESHOLD_NOT_MET",
        "RELEASE_PERMISSION_MISSING",
        "TRUSTED_REJECTION"
      ],
      "title": "ProductionReadinessReasonCodeV2",
      "type": "string"
    },
    "ProductionReadinessReviewDomainV2": {
      "enum": [
        "SECURITY",
        "PRIVACY",
        "RELEASE_PERMISSION",
        "OPERATIONS_SLO"
      ],
      "title": "ProductionReadinessReviewDomainV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/production_readiness_domain_review_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "approval_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductionReadinessApprovalRecordV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "domain": {
      "$ref": "#/$defs/ProductionReadinessReviewDomainV2"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "operations_slo_assessment_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operations_slo_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationsSLOAssessmentOutcomeV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "$ref": "#/$defs/ProductionReadinessDomainOutcomeV2"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ProductionReadinessReasonCodeV2"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/production-readiness-domain-review/v2",
      "default": "eval-factory/production-readiness-domain-review/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    }
  },
  "required": [
    "domain",
    "evidence_refs",
    "outcome",
    "reason_codes"
  ],
  "title": "ProductionReadinessDomainReviewV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.production_readiness_review_v2.ProductionReadinessDomainReviewV2",
  "x-schema-version": "eval-factory/production-readiness-domain-review/v2"
}
