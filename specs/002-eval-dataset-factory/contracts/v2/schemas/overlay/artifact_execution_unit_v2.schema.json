        },
        "content_contract_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "criticality": {
          "$ref": "#/$defs/AttachmentCriticality"
        },
        "logical_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Logical Path",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ReconstructionMode"
        },
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "producer_task_view_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "provider_payload_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "render_contract_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "required_provider_capability_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Required Provider Capability Ids",
          "type": "array"
        },
        "required_runtime_tools": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
            "type": "string"
          },
          "title": "Required Runtime Tools",
          "type": "array"
        },
        "runtime_resume_required": {
          "title": "Runtime Resume Required",
          "type": "boolean"
        },
        "runtime_role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Runtime Role",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/artifact-build-contract/v2",
          "default": "eval-factory/artifact-build-contract/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_set_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validator_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Validator Ids",
          "type": "array"
        }
      },
      "required": [
        "artifact_build_contract_id",
        "attachment_planning_context_ref",
        "producer_task_view_ref",
        "artifact_evidence_matrix_ref",
        "artifact_evidence_row_ref",
        "artifact_evidence_target_ref",
        "attachment_dependency_id",
        "artifact_id",
        "logical_path",
        "media_type",
        "asset_type",
        "mode",
        "criticality",
        "content_contract_ref",
        "render_contract_ref",
        "required_provider_capability_ids",
        "required_runtime_tools",
        "runtime_role",
        "runtime_resume_required",
        "validator_ids",
        "policy_version",
        "artifact_build_contract_sha256",
        "audit"
      ],
      "title": "ArtifactBuildContractV2",
      "type": "object"
    },
    "ArtifactBuildSpec": {
      "additionalProperties": false,
