          "type": "string"
        },
        "runtime_preference": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Runtime Preference",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/artifact-build-spec/v1",
          "default": "eval-factory/artifact-build-spec/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "validator_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Validator Ids",
          "type": "array"
        }
      },
      "required": [
        "artifact_build_spec_id",
        "artifact_evidence_row_ref",
        "producer_task_view_ref",
        "relative_path",
        "media_type",
        "mode",
        "content_contract_ref",
        "render_contract_ref",
        "authorized_evidence_refs",
        "provider_preference",
        "runtime_preference",
        "validator_ids",
        "retry_scope",
        "build_spec_sha256",
        "audit"
      ],
      "title": "ArtifactBuildSpec",
      "type": "object"
