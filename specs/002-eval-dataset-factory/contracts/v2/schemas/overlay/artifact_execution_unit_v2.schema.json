          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Artifact Build Contract Id",
          "type": "string"
        },
        "artifact_build_contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
