          "pattern": "^[a-f0-9]{64}$",
          "title": "Build Spec Sha256",
          "type": "string"
        },
        "content_contract_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Media Type",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ReconstructionMode"
        },
        "producer_task_view_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "provider_preference": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
