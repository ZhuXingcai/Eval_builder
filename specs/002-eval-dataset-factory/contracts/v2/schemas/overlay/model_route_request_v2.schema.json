{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/model_route_request_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_definition_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "agent_task_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "allowed_model_profile_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Allowed Model Profile Refs",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "budget_reservation_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "data_classification": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Data Classification",
      "type": "string"
    },
    "failed_receipt_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "generator_model_profile_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_token_budget": {
      "maximum": 10000000,
      "minimum": 0,
      "title": "Input Token Budget",
      "type": "integer"
    },
    "max_cost_micro_usd": {
      "maximum": 10000000000000,
      "minimum": 0,
      "title": "Max Cost Micro Usd",
      "type": "integer"
    },
    "minimum_quality_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Minimum Quality Basis Points",
      "type": "integer"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "output_token_budget": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Output Token Budget",
      "type": "integer"
    },
    "predecessor_route_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_template_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "required_capabilities": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Required Capabilities",
      "type": "array"
    },
    "residency": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Residency",
      "type": "string"
    },
    "route_request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Route Request Id",
      "type": "string"
    },
    "route_version": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Route Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "eval-factory/model-route-request/v2",
      "default": "eval-factory/model-route-request/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "task_kind": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Task Kind",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "route_request_id",
    "agent_task_ref",
    "agent_definition_ref",
    "task_kind",
    "prompt_template_ref",
    "required_capabilities",
    "data_classification",
    "residency",
    "input_token_budget",
    "output_token_budget",
    "max_cost_micro_usd",
    "minimum_quality_basis_points",
    "allowed_model_profile_refs",
    "budget_reservation_ref",
    "route_version",
    "predecessor_route_ref",
    "failed_receipt_ref",
    "generator_model_profile_ref"
  ],
  "title": "ModelRouteRequestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.ai_gateway_v2.ModelRouteRequestV2",
  "x-schema-version": "eval-factory/model-route-request/v2"
}
