        "release_manifest_ref",
        "job_id",
        "channel",
        "registry",
        "item_ids",
        "item_manifest_refs",
        "export_receipt_refs",
        "published_release_decision_refs",
        "published_evaluation_item_refs",
        "bundle_sha256s",
        "published_at",
        "policy_ref",
        "entry_sha256",
        "audit"
      ],
      "title": "NonProductionRegistryEntryV2",
      "type": "object"
