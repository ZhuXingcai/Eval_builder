{
  "$defs": {
    "ApprovalCheckpoint": {
      "enum": [
        "LABEL_PLAN",
        "TASK_REWRITE_PLAN",
        "ENVIRONMENT_STRATEGY",
        "FINAL_DATASET_REVIEW"
      ],
      "title": "ApprovalCheckpoint",
      "type": "string"
    },
    "CheckpointDecisionBinding": {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/ApprovalCheckpoint"
        },
        "decision_record_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "request_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/checkpoint-decision-binding/v2",
          "default": "eval-factory/checkpoint-decision-binding/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "checkpoint",
        "request_ref",
        "decision_record_ref"
      ],
      "title": "CheckpointDecisionBinding",
      "type": "object"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "EvaluationItemComponents": {
      "additionalProperties": false,
      "properties": {
        "environment_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "evaluator_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "provenance_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "quality_report_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "query_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "reference_policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rubric_set_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/evaluation-item-components/v1",
          "default": "eval-factory/evaluation-item-components/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "query_spec_ref",
        "environment_spec_ref",
        "rubric_set_ref",
        "evaluator_spec_ref",
        "reference_policy_ref",
        "tool_policy_ref",
        "provenance_manifest_ref",
        "quality_report_ref"
      ],
      "title": "EvaluationItemComponents",
      "type": "object"
    },
    "EvaluationItemV2": {
      "additionalProperties": false,
      "properties": {
        "attachment_reconstruction_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "components": {
          "$ref": "#/$defs/EvaluationItemComponents"
        },
        "evaluation_item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Evaluation Item Id",
          "type": "string"
        },
        "item_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Item Sha256",
          "type": "string"
        },
        "item_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Item Version",
          "type": "string"
        },
        "label_decision_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Label Decision Refs",
          "type": "array"
        },
        "release_decision_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/evaluation-item/v2",
          "default": "eval-factory/evaluation-item/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_trace_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Source Trace Refs",
          "type": "array"
        },
        "task_draft_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "user_approval_policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "user_decision_record_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "User Decision Record Refs",
          "type": "array"
        }
      },
      "required": [
        "evaluation_item_id",
        "item_version",
        "source_trace_refs",
        "label_decision_refs",
        "task_draft_ref",
        "attachment_reconstruction_result_ref",
        "components",
        "user_approval_policy_ref",
        "release_decision_ref",
        "item_sha256",
        "audit"
      ],
      "title": "EvaluationItemV2",
      "type": "object"
    },
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    },
    "LHExportReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "bundle_file_count": {
          "maximum": 100003,
          "minimum": 3,
          "title": "Bundle File Count",
          "type": "integer"
        },
        "bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "bundle_total_bytes": {
          "maximum": 5000000000,
          "minimum": 1,
          "title": "Bundle Total Bytes",
          "type": "integer"
        },
        "item_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "query_yaml_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Yaml Sha256",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "release_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rubrics_json_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rubrics Json Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/lh-export-receipt/v2",
          "default": "eval-factory/lh-export-receipt/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_export_result": {
          "$ref": "#/$defs/LHWorkspaceExportResultV2"
        },
        "workspace_export_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "workspace_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Workspace Sha256",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "release_manifest_ref",
        "item_manifest_ref",
        "workspace_export_result",
        "workspace_export_result_ref",
        "query_yaml_sha256",
        "rubrics_json_sha256",
        "workspace_sha256",
        "bundle_sha256",
        "bundle_file_count",
        "bundle_total_bytes",
        "policy_ref",
        "receipt_sha256",
        "audit"
      ],
      "title": "LHExportReceiptV2",
      "type": "object"
    },
    "LHReleaseItemManifestV2": {
      "additionalProperties": false,
      "properties": {
        "approved_evaluation_item_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "approved_release_decision_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "approved_release_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "channel": {
          "$ref": "#/$defs/ReleaseChannel"
        },
        "environment_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "expected_workspace_members": {
          "items": {
            "$ref": "#/$defs/LHWorkspaceExportMemberV2"
          },
          "title": "Expected Workspace Members",
          "type": "array"
        },
        "export_profile": {
          "const": "LH",
          "default": "LH",
          "title": "Export Profile",
          "type": "string"
        },
        "export_profile_version": {
          "const": "v1",
          "default": "v1",
          "title": "Export Profile Version",
          "type": "string"
        },
        "final_package_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Item Id",
          "type": "string"
        },
        "item_manifest_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Item Manifest Id",
          "type": "string"
        },
        "item_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Item Manifest Sha256",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Job Id",
          "type": "string"
        },
        "package_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Package Sha256",
          "type": "string"
        },
        "policy_version": {
          "const": "release-publication/r7-09-v1",
          "default": "release-publication/r7-09-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "provenance_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "quality_report_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "query_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "query_yaml_included": {
          "const": true,
          "default": true,
          "title": "Query Yaml Included",
          "type": "boolean"
        },
        "query_yaml_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Yaml Sha256",
          "type": "string"
        },
        "registry": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Registry",
          "type": "string"
        },
        "release_subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rubric_set_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rubrics_json_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rubrics Json Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/lh-release-item-manifest/v2",
          "default": "eval-factory/lh-release-item-manifest/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "item_manifest_id",
        "job_id",
        "item_id",
        "approved_release_result_ref",
        "approved_evaluation_item_ref",
        "approved_release_decision_ref",
        "release_subject_ref",
        "query_spec_ref",
        "rubric_set_ref",
        "environment_spec_ref",
        "provenance_manifest_ref",
        "quality_report_ref",
        "final_package_manifest_ref",
        "package_sha256",
        "query_yaml_sha256",
        "rubrics_json_sha256",
        "expected_workspace_members",
        "channel",
        "registry",
        "item_manifest_sha256",
        "audit"
