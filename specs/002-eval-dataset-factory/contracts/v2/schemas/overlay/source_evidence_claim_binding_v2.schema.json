{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/source_evidence_claim_binding_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_evidence_target_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "attachment_dependency_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Attachment Dependency Id",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/source-evidence-claim-binding/v2",
      "default": "eval-factory/source-evidence-claim-binding/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_claim_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Claim Ids",
      "type": "array"
    },
    "usage_basis": {
      "enum": [
        "FACTS_ONLY",
        "STRUCTURE_AND_STYLE_ONLY"
      ],
      "title": "Usage Basis",
      "type": "string"
    }
  },
  "required": [
    "artifact_evidence_target_ref",
    "attachment_dependency_id",
    "supported_claim_ids",
    "usage_basis"
  ],
  "title": "SourceEvidenceClaimBindingV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.attachment_v2.SourceEvidenceClaimBindingV2",
  "x-schema-version": "eval-factory/source-evidence-claim-binding/v2"
}
