{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ResourceAdmissionOutcomeV2": {
      "enum": [
        "ADMITTED",
        "WAITING_CAPACITY",
        "BUDGET_EXHAUSTED",
        "UNSATISFIABLE_DEMAND"
      ],
      "title": "ResourceAdmissionOutcomeV2",
      "type": "string"
    },
    "ResourceKindV2": {
      "enum": [
        "PROCESS",
        "RENDERER",
        "NETWORK",
        "STORAGE"
      ],
      "title": "ResourceKindV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/resource_admission_decision_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "constrained_resources": {
      "items": {
        "$ref": "#/$defs/ResourceKindV2"
      },
      "title": "Constrained Resources",
      "type": "array"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "job_head_version_before": {
      "minimum": 0,
      "title": "Job Head Version Before",
      "type": "integer"
    },
    "job_resource_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "outcome": {
      "$ref": "#/$defs/ResourceAdmissionOutcomeV2"
    },
    "policy_version": {
      "const": "resource-control/r6-04-v1",
      "default": "resource-control/r6-04-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "pool_head_version_before": {
      "minimum": 0,
      "title": "Pool Head Version Before",
      "type": "integer"
    },
    "resource_admission_decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Resource Admission Decision Id",
      "type": "string"
    },
    "resource_admission_decision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Resource Admission Decision Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/resource-admission-decision/v2",
      "default": "eval-factory/resource-admission-decision/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "work_resource_demand_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "resource_admission_decision_id",
    "job_resource_policy_ref",
    "work_resource_demand_ref",
    "outcome",
    "constrained_resources",
    "pool_head_version_before",
    "job_head_version_before",
    "decided_at",
    "resource_admission_decision_sha256",
    "audit"
  ],
  "title": "ResourceAdmissionDecisionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.resource_v2.ResourceAdmissionDecisionV2",
  "x-schema-version": "eval-factory/resource-admission-decision/v2"
}
