{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/semantic_finding_resolution_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "current_subject_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Current Subject Refs",
      "type": "array"
    },
    "deterministic_revalidation_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "disposition": {
      "enum": [
        "CONFIRMED_RESOLVED",
        "PERSISTS"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "evidence_ref_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Evidence Ref Ids",
      "type": "array"
    },
    "facade_resolution_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "old_subject_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Old Subject Refs",
      "type": "array"
    },
    "policy_version": {
      "const": "semantic-review/r5-09-v1",
      "default": "semantic-review/r5-09-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "prior_finding_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "repair_plan_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "repair_result_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Repair Result Refs",
      "type": "array"
    },
    "resolution_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Resolution Sha256",
      "type": "string"
    },
    "resolving_stage_run_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/semantic-finding-resolution/v2",
      "default": "eval-factory/semantic-finding-resolution/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_finding_resolution_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Semantic Finding Resolution Id",
      "type": "string"
    },
    "successor_finding_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "semantic_finding_resolution_id",
    "facade_resolution_ref",
    "resolving_stage_run_ref",
    "prior_finding_ref",
    "old_subject_refs",
    "current_subject_refs",
    "repair_plan_ref",
    "repair_result_refs",
    "deterministic_revalidation_ref",
    "disposition",
    "evidence_ref_ids",
    "resolution_sha256",
    "audit"
  ],
  "title": "SemanticFindingResolutionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.review_v2.SemanticFindingResolutionV2",
  "x-schema-version": "eval-factory/semantic-finding-resolution/v2"
}
