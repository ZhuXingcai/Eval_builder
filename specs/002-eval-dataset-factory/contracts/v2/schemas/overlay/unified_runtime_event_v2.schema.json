{
  "$defs": {
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    },
    "ReportedCostV2": {
      "additionalProperties": false,
      "properties": {
        "amount_microusd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Microusd"
        },
        "availability": {
          "$ref": "#/$defs/TelemetryAvailabilityV2"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "rounding": {
          "anyOf": [
            {
              "const": "HALF_EVEN_MICRO_USD",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rounding"
        }
      },
      "required": [
        "availability"
      ],
      "title": "ReportedCostV2",
      "type": "object"
    },
    "RuntimeEventKindV2": {
      "enum": [
        "RUN_STARTED",
        "MODEL_REQUEST_STARTED",
        "MODEL_OUTPUT_DELTA",
        "MODEL_RESPONSE_AVAILABLE",
        "TOOL_CALL_STARTED",
        "TOOL_CALL_PROGRESS",
        "TOOL_CALL_COMPLETED",
        "ARTIFACT_CHANGED",
        "WARNING",
        "USAGE_REPORTED",
        "RUN_COMPLETED",
        "RUN_FAILED"
      ],
      "title": "RuntimeEventKindV2",
      "type": "string"
    },
    "RuntimeFailureCodeV2": {
      "enum": [
        "AUTHENTICATION_FAILED",
        "CANCELLED",
        "CONTEXT_OVERFLOW",
        "INVALID_REQUEST",
        "MODEL_UNAVAILABLE",
        "OVERLOADED",
        "PROTOCOL_ERROR",
        "PROVIDER_FAILED",
        "RATE_LIMITED",
        "SANDBOX_UNAVAILABLE",
        "TIMEOUT",
        "TOOL_DENIED",
        "TOOL_FAILED",
        "TRANSPORT_FAILED",
        "UNKNOWN"
      ],
      "title": "RuntimeFailureCodeV2",
      "type": "string"
    },
    "TelemetryAvailabilityV2": {
      "enum": [
        "REPORTED",
        "DERIVED",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ],
      "title": "TelemetryAvailabilityV2",
      "type": "string"
    },
    "ToolFamilyV2": {
      "enum": [
        "FILE",
        "SHELL",
        "SEARCH",
        "FETCH",
        "RENDERER",
        "OTHER"
      ],
      "title": "ToolFamilyV2",
      "type": "string"
    },
    "UnifiedRuntimeUsageV2": {
      "additionalProperties": false,
      "properties": {
        "cache_creation_input_tokens": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "duration_ms": {
          "anyOf": [
            {
              "maximum": 1000000000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "input_tokens": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_requests": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Model Requests",
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reported_cost": {
          "$ref": "#/$defs/ReportedCostV2"
        },
        "schema_version": {
          "const": "env-mock-agent/unified-runtime-usage/v2",
          "default": "env-mock-agent/unified-runtime-usage/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_calls": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "turns": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Turns",
          "type": "integer"
        }
      },
      "required": [
        "model_requests",
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "tool_calls",
        "turns",
        "reported_cost"
      ],
      "title": "UnifiedRuntimeUsageV2",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/unified_runtime_event_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "failure_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeFailureCodeV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/RuntimeEventKindV2"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "protocol_version": {
      "const": "runtime-protocol/stage5-0-v1",
      "default": "runtime-protocol/stage5-0-v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime_event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Runtime Event Id",
      "type": "string"
    },
    "runtime_event_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Event Sha256",
      "type": "string"
    },
    "runtime_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Runtime Id",
      "type": "string"
    },
    "runtime_version": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Version"
    },
    "schema_version": {
      "const": "env-mock-agent/unified-runtime-event/v2",
      "default": "env-mock-agent/unified-runtime-event/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/FacadeObjectRef"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "tool_call_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call Sha256"
    },
    "tool_family": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolFamilyV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnifiedRuntimeUsageV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "work_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "runtime_event_id",
    "runtime_event_sha256",
    "run_id",
    "work_id",
    "runtime_id",
    "sequence",
    "kind",
    "occurred_at",
    "source_refs"
  ],
  "title": "UnifiedRuntimeEventV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.runtime_v2.UnifiedRuntimeEventV2",
  "x-schema-version": "env-mock-agent/unified-runtime-event/v2"
}
