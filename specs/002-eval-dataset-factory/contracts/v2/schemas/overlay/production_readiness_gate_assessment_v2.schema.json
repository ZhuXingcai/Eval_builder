{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ProductionReadinessAttestationReasonCodeV2": {
      "enum": [
        "NONE",
        "SC_010_PENDING",
        "SC_011_PENDING",
        "SC_012_PENDING",
        "SC_013_PENDING",
        "SC_014_UNVERIFIED",
        "GATE_FAILED",
        "LIFECYCLE_APPROVAL_MISSING",
        "INCIDENT_ROUTE_MISSING",
        "ISSUER_AUTHORITY_MISSING",
        "ISSUER_AUTHORITY_EXPIRED",
        "ISSUER_SCOPE_MISMATCH",
        "VERSION_SET_DRIFT",
        "EVIDENCE_EXPIRED",
        "MECHANISM_ONLY",
        "TRUSTED_REJECTION",
        "ATTESTATION_EXPIRED",
        "ATTESTATION_INVALIDATED"
      ],
      "title": "ProductionReadinessAttestationReasonCodeV2",
      "type": "string"
    },
    "ProductionReadinessGateOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "PENDING"
      ],
      "title": "ProductionReadinessGateOutcomeV2",
      "type": "string"
    },
    "ProductionReadinessGateV2": {
      "enum": [
        "SC_010_LABEL_QUALITY",
        "SC_011_REAL_TRACE_STABILITY",
        "SC_012_RESOURCE_POLICY",
        "SC_013_ORGANIZATION_APPROVALS",
        "SC_014_ZERO_OPEN_GATES"
      ],
      "title": "ProductionReadinessGateV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/production_readiness_gate_assessment_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "assessment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Assessment Sha256",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "gate": {
      "$ref": "#/$defs/ProductionReadinessGateV2"
    },
    "outcome": {
      "$ref": "#/$defs/ProductionReadinessGateOutcomeV2"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ProductionReadinessAttestationReasonCodeV2"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/production-readiness-gate-assessment/v2",
      "default": "eval-factory/production-readiness-gate-assessment/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    }
  },
  "required": [
    "assessment_id",
    "gate",
    "outcome",
    "reason_codes",
    "evidence_refs",
    "assessment_sha256"
  ],
  "title": "ProductionReadinessGateAssessmentV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.production_attestation_v2.ProductionReadinessGateAssessmentV2",
  "x-schema-version": "eval-factory/production-readiness-gate-assessment/v2"
}
