{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "StageNameV2": {
      "enum": [
        "trace_index",
        "safety",
        "label_plan",
        "label",
        "task_rewrite_plan",
        "task_authoring",
        "environment_strategy",
        "attachment",
        "item_quality",
        "batch_quality",
        "final_dataset_review",
        "release"
      ],
      "title": "StageNameV2",
      "type": "string"
    },
    "WorkLeaseStateV2": {
      "enum": [
        "ACTIVE",
        "SUCCEEDED",
        "RETRYABLE_FAILURE",
        "TERMINAL_FAILURE",
        "EXPIRED",
        "CANCELLED"
      ],
      "title": "WorkLeaseStateV2",
      "type": "string"
    },
    "WorkReadinessV2": {
      "enum": [
        "READY",
        "WAITING",
        "BLOCKED_DEPENDENCY",
        "SKIPPED_ITEM"
      ],
      "title": "WorkReadinessV2",
      "type": "string"
    },
    "WorkRetryDecisionKindV2": {
      "enum": [
