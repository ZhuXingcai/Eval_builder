{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "LabelQualityEvidenceClassV2": {
      "enum": [
        "PRODUCTION_INDEPENDENT_TEST",
        "MECHANISM_VALIDATION_ONLY",
        "REPOSITORY_PENDING_ONLY"
      ],
      "title": "LabelQualityEvidenceClassV2",
      "type": "string"
    },
    "LabelUnresolvedReason": {
      "enum": [
        "AMBIGUOUS_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "INCOMPLETE_STRUCTURED_CAPABILITY",
        "LOW_CONFIDENCE",
        "MISSING_EVIDENCE",
        "MODEL_UNAVAILABLE",
        "USER_INSPECTION_REQUIRED"
      ],
      "title": "LabelUnresolvedReason",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/label_quality_evaluation_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "access_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "allowed_semantic_abstain_reasons": {
      "default": [
        "AMBIGUOUS_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "LOW_CONFIDENCE",
        "USER_INSPECTION_REQUIRED"
      ],
      "items": {
        "$ref": "#/$defs/LabelUnresolvedReason"
      },
      "title": "Allowed Semantic Abstain Reasons",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "bootstrap_replicate_count": {
      "const": 10000,
      "default": 10000,
      "title": "Bootstrap Replicate Count",
      "type": "integer"
    },
    "decision_policy_version": {
      "const": "label-decision-merge/r3-04-v1",
      "default": "label-decision-merge/r3-04-v1",
      "title": "Decision Policy Version",
      "type": "string"
    },
    "evidence_class": {
      "$ref": "#/$defs/LabelQualityEvidenceClassV2"
    },
    "max_members": {
      "maximum": 10000000,
      "minimum": 300,
      "title": "Max Members",
      "type": "integer"
    },
    "max_observations": {
      "maximum": 10000000,
      "minimum": 300,
      "title": "Max Observations",
      "type": "integer"
    },
    "max_private_bytes": {
      "maximum": 1000000000000,
      "minimum": 2,
      "title": "Max Private Bytes",
      "type": "integer"
    },
    "max_report_bytes": {
      "maximum": 100000000,
      "minimum": 2,
      "title": "Max Report Bytes",
      "type": "integer"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "label-quality-evaluation/r8-02-v1",
      "default": "label-quality-evaluation/r8-02-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "repository_pending_evidence_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/label-quality-evaluation-policy/v2",
      "default": "eval-factory/label-quality-evaluation-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_label_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "semantic_macro_f1_threshold_basis_points": {
      "const": 8500,
      "default": 8500,
      "title": "Semantic Macro F1 Threshold Basis Points",
      "type": "integer"
    },
    "structured_label_spec_refs": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "$ref": "#/$defs/ObjectRef"
        }
      ],
      "title": "Structured Label Spec Refs",
      "type": "array"
    },
    "structured_precision_threshold_basis_points": {
      "const": 9900,
      "default": 9900,
      "title": "Structured Precision Threshold Basis Points",
      "type": "integer"
    },
    "structured_recall_threshold_basis_points": {
      "const": 9900,
      "default": 9900,
      "title": "Structured Recall Threshold Basis Points",
      "type": "integer"
    },
    "structured_rule_version": {
      "const": "structured-labeling/r3-02-v1",
      "default": "structured-labeling/r3-02-v1",
      "title": "Structured Rule Version",
      "type": "string"
    },
    "test_set_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "policy_id",
    "test_set_policy_ref",
    "access_policy_ref",
    "structured_label_spec_refs",
    "semantic_label_spec_ref",
    "repository_pending_evidence_ref",
    "evidence_class",
    "max_members",
    "max_observations",
    "max_private_bytes",
    "max_report_bytes",
    "policy_sha256",
    "audit"
  ],
  "title": "LabelQualityEvaluationPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.label_quality_v2.LabelQualityEvaluationPolicyV2",
  "x-schema-version": "eval-factory/label-quality-evaluation-policy/v2"
}
