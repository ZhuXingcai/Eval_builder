{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PlanKindV2": {
      "enum": [
        "GLOBAL_BUILD",
        "TRACE_CLEANING",
        "TASK_REWRITE",
        "ATTACHMENT_GENERATION",
        "CRITERIA_RUBRIC",
        "GRADING_DESIGN",
        "FINAL_DELIVERY"
      ],
      "title": "PlanKindV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/dataset_build_plan_task_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "acceptance_check_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Acceptance Check Refs",
      "type": "array"
    },
    "agent_role": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Agent Role",
      "type": "string"
    },
    "dependency_task_keys": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Dependency Task Keys",
      "type": "array"
    },
    "input_object_types": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Input Object Types",
      "type": "array"
    },
    "max_attempts": {
      "maximum": 100,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_cost_micro_usd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Max Cost Micro Usd",
      "type": "integer"
    },
    "max_model_requests": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Max Model Requests",
      "type": "integer"
    },
    "max_model_tokens": {
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Max Model Tokens",
      "type": "integer"
    },
    "output_object_types": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Output Object Types",
      "type": "array"
    },
    "plan_review_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanKindV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "required_capability_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Required Capability Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/dataset-build-plan-task/v2",
      "default": "eval-factory/dataset-build-plan-task/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Stage",
      "type": "string"
    },
    "task_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Task Key",
      "type": "string"
    },
    "task_kind": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Task Kind",
      "type": "string"
    }
  },
  "required": [
    "task_key",
    "stage",
    "task_kind",
    "agent_role",
    "output_object_types",
    "required_capability_ids",
    "acceptance_check_refs",
    "max_attempts",
    "max_model_requests",
    "max_model_tokens",
    "max_cost_micro_usd"
  ],
  "title": "DatasetBuildPlanTaskV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.agent_system_v2.DatasetBuildPlanTaskV2",
  "x-schema-version": "eval-factory/dataset-build-plan-task/v2"
}
