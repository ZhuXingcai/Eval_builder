{
  "$defs": {
    "BatchFindingCategoryV2": {
      "enum": [
        "EXACT_TASK_DUPLICATE",
        "NEAR_TASK_DUPLICATE",
        "EXACT_ATTACHMENT_DUPLICATE",
        "NEAR_ATTACHMENT_DUPLICATE",
        "CROSS_ITEM_CONTAMINATION",
        "CROSS_ITEM_LEAKAGE",
        "ANSWER_REUSE",
        "LINEAGE_INCOMPLETE",
        "LINEAGE_INDETERMINATE",
        "CROSS_ITEM_LINEAGE_ALIAS"
      ],
      "title": "BatchFindingCategoryV2",
      "type": "string"
    },
    "BatchFindingScopeV2": {
      "enum": [
        "ITEM",
        "BATCH"
      ],
      "title": "BatchFindingScopeV2",
      "type": "string"
    },
    "BatchReviewerFindingV2": {
      "additionalProperties": false,
      "properties": {
        "affected_item_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Item Ids",
          "type": "array"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "batch_reviewer_finding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Batch Reviewer Finding Id",
          "type": "string"
        },
        "blocked_item_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Blocked Item Ids",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/BatchFindingCategoryV2"
        },
        "direct_evidence_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "finding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Finding Sha256",
          "type": "string"
        },
        "non_waivable": {
          "title": "Non Waivable",
          "type": "boolean"
        },
        "owner_item_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Item Id"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "release_blocking": {
          "title": "Release Blocking",
          "type": "boolean"
        },
        "restricted_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptLeakageCategoryV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "eval-factory/batch-reviewer-finding/v2",
          "default": "eval-factory/batch-reviewer-finding/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/BatchFindingScopeV2"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "const": "OPEN",
          "default": "OPEN",
          "title": "Status",
          "type": "string"
        },
        "subject_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Subject Refs",
          "type": "array"
        }
      },
      "required": [
        "batch_reviewer_finding_id",
        "scope",
        "category",
        "severity",
        "affected_item_ids",
        "subject_refs",
        "direct_evidence_ref",
        "non_waivable",
        "release_blocking",
        "policy_ref",
        "finding_sha256",
        "audit"
      ],
      "title": "BatchReviewerFindingV2",
      "type": "object"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PromptLeakageCategoryV2": {
      "enum": [
        "FINAL_ANSWER",
        "COMPLETED_DELIVERABLE",
        "PRIVATE_REFERENCE",
        "GRADER_RULE",
        "HIDDEN_PASS_CONDITION",
        "HIDDEN_SELECTION_SIGNAL",
        "TRAJECTORY_SPECIFIC_STEP"
      ],
      "title": "PromptLeakageCategoryV2",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "Severity",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/item_quality_report_revision_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "accepted_artifact_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Accepted Artifact Refs",
      "type": "array"
    },
    "approvable": {
      "const": false,
      "default": false,
      "title": "Approvable",
      "type": "boolean"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "base_item_quality_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "base_quality_report_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "environment_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "final_package_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "finding_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Finding Refs",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/BatchReviewerFindingV2"
      },
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Item Id",
      "type": "string"
    },
    "item_quality_report_revision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Item Quality Report Revision Id",
      "type": "string"
    },
    "open_p0_count": {
      "minimum": 0,
      "title": "Open P0 Count",
      "type": "integer"
    },
    "open_p1_count": {
      "minimum": 0,
      "title": "Open P1 Count",
      "type": "integer"
    },
    "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "provenance_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "release_revalidation_required": {
      "const": true,
      "default": true,
      "title": "Release Revalidation Required",
      "type": "boolean"
    },
    "revision": {
      "const": 1,
      "default": 1,
      "title": "Revision",
      "type": "integer"
    },
    "revision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Revision Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/item-quality-report-revision/v2",
      "default": "eval-factory/item-quality-report-revision/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "unresolved_non_waivable_count": {
      "minimum": 0,
      "title": "Unresolved Non Waivable Count",
      "type": "integer"
    }
  },
  "required": [
    "item_quality_report_revision_id",
    "item_id",
    "base_item_quality_result_ref",
    "base_quality_report_ref",
    "final_package_manifest_ref",
    "provenance_manifest_ref",
    "environment_spec_ref",
    "accepted_artifact_refs",
    "package_sha256",
    "findings",
    "finding_refs",
    "open_p0_count",
    "open_p1_count",
    "unresolved_non_waivable_count",
    "policy_ref",
    "revision_sha256",
    "audit"
  ],
  "title": "ItemQualityReportRevisionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.batch_quality_v2.ItemQualityReportRevisionV2",
  "x-schema-version": "eval-factory/item-quality-report-revision/v2"
}
