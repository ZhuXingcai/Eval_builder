{
  "$defs": {
    "AttachmentCrossItemSafetyScanLimitsV2": {
      "additionalProperties": false,
      "properties": {
        "max_compression_ratio_milli": {
          "maximum": 10000000,
          "minimum": 1000,
          "title": "Max Compression Ratio Milli",
          "type": "integer"
        },
        "max_expanded_bytes": {
          "maximum": 5000000000,
          "minimum": 1,
          "title": "Max Expanded Bytes",
          "type": "integer"
        },
        "max_extracted_characters": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Max Extracted Characters",
          "type": "integer"
        },
        "max_file_bytes": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_fingerprint_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Max Fingerprint Count",
          "type": "integer"
        },
        "max_inventory_members": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Inventory Members",
          "type": "integer"
        },
        "max_match_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Max Match Count",
          "type": "integer"
        },
        "max_nested_depth": {
          "maximum": 16,
          "minimum": 1,
          "title": "Max Nested Depth",
          "type": "integer"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-cross-item-safety-scan-limits/v2",
          "default": "env-mock-agent/attachment-cross-item-safety-scan-limits/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "max_file_bytes",
        "max_extracted_characters",
        "max_inventory_members",
        "max_nested_depth",
        "max_expanded_bytes",
        "max_compression_ratio_milli",
        "max_fingerprint_count",
        "max_match_count"
      ],
      "title": "AttachmentCrossItemSafetyScanLimitsV2",
      "type": "object"
    },
    "AttachmentValidationFingerprintCategoryV2": {
      "enum": [
        "FINAL_ANSWER",
        "COMPLETED_DELIVERABLE",
        "PRIVATE_REFERENCE",
        "GRADER_RULE",
        "HIDDEN_PASS_CONDITION",
        "HIDDEN_SELECTION_SIGNAL",
        "TRAJECTORY_SPECIFIC_STEP"
      ],
      "title": "AttachmentValidationFingerprintCategoryV2",
      "type": "string"
    },
    "AttachmentValidationFingerprintMatchKindV2": {
      "enum": [
        "NORMALIZED_FULL_TEXT",
        "TOKEN_WINDOW",
        "PATH_COMPONENT"
      ],
      "title": "AttachmentValidationFingerprintMatchKindV2",
      "type": "string"
    },
    "AttachmentValidationFingerprintV2": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/AttachmentValidationFingerprintCategoryV2"
        },
        "digest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest Sha256",
          "type": "string"
        },
        "fingerprint_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Fingerprint Id",
          "type": "string"
        },
        "match_kind": {
          "$ref": "#/$defs/AttachmentValidationFingerprintMatchKindV2"
        },
        "normalization_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Normalization Version",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-validation-fingerprint/v2",
          "default": "env-mock-agent/attachment-validation-fingerprint/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "token_count": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "fingerprint_id",
        "category",
        "match_kind",
        "digest_sha256",
        "token_count",
        "normalization_version"
      ],
      "title": "AttachmentValidationFingerprintV2",
      "type": "object"
    },
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/attachment_cross_item_safety_scan_request_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_validation_result_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "candidate_artifact_version_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "environment_artifact_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "foreign_fingerprints": {
      "items": {
        "$ref": "#/$defs/AttachmentValidationFingerprintV2"
      },
      "maxItems": 1000000,
      "title": "Foreign Fingerprints",
      "type": "array"
    },
    "foreign_reference_set_refs": {
      "items": {
        "$ref": "#/$defs/FacadeObjectRef"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Foreign Reference Set Refs",
      "type": "array"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "item_quality_result_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "limits": {
      "$ref": "#/$defs/AttachmentCrossItemSafetyScanLimitsV2"
    },
    "logical_path": {
      "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
      "title": "Logical Path",
      "type": "string"
    },
    "media_type": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
      "title": "Media Type",
      "type": "string"
    },
    "normalization_version": {
      "const": "task-prompt-leakage-normalization/r4-04-v1",
      "default": "task-prompt-leakage-normalization/r4-04-v1",
      "title": "Normalization Version",
      "type": "string"
    },
    "output_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "policy_version": {
      "const": "attachment-cross-item-safety/r7-02-v1",
      "default": "attachment-cross-item-safety/r7-02-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "scan_request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Scan Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "env-mock-agent/attachment-cross-item-safety-scan-request/v2",
      "default": "env-mock-agent/attachment-cross-item-safety-scan-request/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "size_bytes": {
      "maximum": 5000000000,
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "target_item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Target Item Id",
      "type": "string"
    }
  },
  "required": [
    "scan_request_id",
    "target_item_id",
    "item_quality_result_ref",
    "environment_artifact_ref",
    "candidate_artifact_version_ref",
    "output_ref",
    "artifact_validation_result_ref",
    "logical_path",
    "media_type",
    "content_sha256",
    "size_bytes",
    "foreign_reference_set_refs",
    "foreign_fingerprints",
    "limits",
    "idempotency_key",
    "request_sha256"
  ],
  "title": "AttachmentCrossItemSafetyScanRequestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.cross_item_safety_v2.AttachmentCrossItemSafetyScanRequestV2",
  "x-schema-version": "env-mock-agent/attachment-cross-item-safety-scan-request/v2"
}
