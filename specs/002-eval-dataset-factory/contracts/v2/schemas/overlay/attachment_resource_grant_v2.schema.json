  "title": "AttachmentResourceGrantV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.resource_v2.AttachmentResourceGrantV2",
  "x-schema-version": "env-mock-agent/attachment-resource-grant/v2"
}
