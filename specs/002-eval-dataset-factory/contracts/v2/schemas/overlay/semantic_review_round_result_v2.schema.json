{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "SemanticReviewRoundOutcomeV2": {
      "enum": [
        "ACCEPTED",
        "REQUIRES_REPAIR",
        "REJECTED",
        "ABSTAINED",
        "BLOCKED"
      ],
      "title": "SemanticReviewRoundOutcomeV2",
      "type": "string"
    },
    "SemanticReviewRoundV2": {
      "enum": [
        "COVERAGE_SOLVABILITY",
        "REALISM_CONSISTENCY",
        "LEAKAGE_EXECUTABILITY"
      ],
      "title": "SemanticReviewRoundV2",
      "type": "string"
    },
    "SemanticReviewerRoleV2": {
      "enum": [
        "COVERAGE_SOLVABILITY_REVIEWER",
        "REALISM_CONSISTENCY_REVIEWER",
        "LEAKAGE_EXECUTABILITY_REVIEWER"
      ],
      "title": "SemanticReviewerRoleV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/semantic_review_round_result_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "candidate_revision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "clean_context_attestation_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "context_view_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "deterministic_validation_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "facade_review_request_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "facade_review_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "finding_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Finding Refs",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/SemanticReviewRoundOutcomeV2"
    },
    "policy_version": {
      "const": "semantic-review/r5-09-v1",
      "default": "semantic-review/r5-09-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "predecessor_round_result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prior_finding_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Prior Finding Refs",
      "type": "array"
    },
    "prior_repair_plan_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Prior Repair Plan Refs",
      "type": "array"
    },
    "prior_repair_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Prior Repair Result Refs",
      "type": "array"
    },
    "resolution_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Resolution Refs",
      "type": "array"
    },
    "reviewer_role": {
      "$ref": "#/$defs/SemanticReviewerRoleV2"
    },
    "round": {
      "$ref": "#/$defs/SemanticReviewRoundV2"
    },
    "round_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Round Result Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/semantic-review-round-result/v2",
      "default": "eval-factory/semantic-review-round-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_review_round_result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Semantic Review Round Result Id",
      "type": "string"
    },
    "stage_run_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "semantic_review_round_result_id",
    "round",
    "reviewer_role",
    "stage_run_ref",
    "context_view_ref",
    "clean_context_attestation_ref",
    "facade_review_request_ref",
    "facade_review_result_ref",
    "candidate_revision_ref",
    "deterministic_validation_result_ref",
    "outcome",
    "accepted",
    "round_result_sha256",
    "audit"
  ],
  "title": "SemanticReviewRoundResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.review_v2.SemanticReviewRoundResultV2",
  "x-schema-version": "eval-factory/semantic-review-round-result/v2"
}
