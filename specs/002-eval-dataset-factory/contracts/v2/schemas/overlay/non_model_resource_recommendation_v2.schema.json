    "policy_version": {
      "const": "concurrency-experiment/r8-06-v1",
      "default": "concurrency-experiment/r8-06-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "process_capacity": {
      "default": null,
      "title": "Process Capacity",
      "type": "null"
    },
    "reason": {
      "const": "BALANCED_KNEE",
      "default": "BALANCED_KNEE",
      "title": "Reason",
      "type": "string"
    },
    "recommendation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Recommendation Id",
      "type": "string"
    },
    "recommendation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
