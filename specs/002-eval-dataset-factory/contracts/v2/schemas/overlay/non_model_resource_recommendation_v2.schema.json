    },
    "recommended_storage_bytes_per_job": {
      "maximum": 1000000000000000,
      "minimum": 1,
      "title": "Recommended Storage Bytes Per Job",
      "type": "integer"
    },
    "recommended_worker_count": {
      "enum": [
        1,
        2,
        4,
        8,
        16
      ],
      "title": "Recommended Worker Count",
      "type": "integer"
    },
    "renderer_capacity": {
      "default": null,
      "title": "Renderer Capacity",
      "type": "null"
    },
    "schema_version": {
      "const": "eval-factory/non-model-resource-recommendation/v2",
      "default": "eval-factory/non-model-resource-recommendation/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_median_throughput_millijobs_per_second": {
      "minimum": 1,
      "title": "Selected Median Throughput Millijobs Per Second",
      "type": "integer"
    },
    "selected_p95_case_latency_nanoseconds": {
      "minimum": 0,
      "title": "Selected P95 Case Latency Nanoseconds",
      "type": "integer"
    },
    "throughput_efficiency_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Throughput Efficiency Basis Points",
      "type": "integer"
    },
    "throughput_threshold_basis_points": {
      "const": 9000,
      "default": 9000,
      "title": "Throughput Threshold Basis Points",
      "type": "integer"
    }
  },
  "required": [
    "recommendation_id",
    "policy_ref",
    "recommended_worker_count",
    "recommended_storage_bytes_per_job",
    "recommended_storage_bytes_per_cohort",
    "selected_median_throughput_millijobs_per_second",
    "maximum_median_throughput_millijobs_per_second",
    "throughput_efficiency_basis_points",
    "selected_p95_case_latency_nanoseconds",
    "baseline_p95_case_latency_nanoseconds",
    "p95_baseline_ratio_basis_points",
    "recommendation_sha256",
    "audit"
  ],
  "title": "NonModelResourceRecommendationV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.concurrency_experiment_v2.NonModelResourceRecommendationV2",
  "x-schema-version": "eval-factory/non-model-resource-recommendation/v2"
}
