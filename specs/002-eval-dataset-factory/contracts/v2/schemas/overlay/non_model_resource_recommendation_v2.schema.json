    },
    "model_concurrency": {
      "default": null,
      "title": "Model Concurrency",
      "type": "null"
    },
    "model_request_budget": {
      "default": null,
      "title": "Model Request Budget",
      "type": "null"
    },
    "model_token_budget": {
      "default": null,
      "title": "Model Token Budget",
      "type": "null"
    },
    "network_capacity": {
      "default": null,
      "title": "Network Capacity",
      "type": "null"
    },
