      "const": "CANARY_WORKER_STORAGE_ONLY",
      "default": "CANARY_WORKER_STORAGE_ONLY",
      "title": "Claim Scope",
      "type": "string"
    },
    "maximum_median_throughput_millijobs_per_second": {
      "minimum": 1,
      "title": "Maximum Median Throughput Millijobs Per Second",
