{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "DeterministicRepairTargetV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "finding_codes": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Codes",
          "type": "array"
        },
        "finding_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Finding Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/deterministic-repair-target/v2",
          "default": "eval-factory/deterministic-repair-target/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "finding_refs",
        "finding_codes"
      ],
      "title": "DeterministicRepairTargetV2",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "RevisionDeterministicValidationOutcomeV2": {
      "enum": [
        "NOT_REQUIRED",
        "PASSED",
        "UPSTREAM_INCOMPLETE",
        "REQUIRES_REPAIR",
        "REJECTED",
        "BLOCKED"
      ],
      "title": "RevisionDeterministicValidationOutcomeV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/revision_deterministic_validation_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_validation_result_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Artifact Validation Result Refs",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "candidate_revision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "finding_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Finding Refs",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/RevisionDeterministicValidationOutcomeV2"
    },
    "output_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Output Refs",
      "type": "array"
    },
    "policy_version": {
      "const": "semantic-review/r5-09-v1",
      "default": "semantic-review/r5-09-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "repair_targets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeterministicRepairTargetV2"
      },
      "title": "Repair Targets",
      "type": "array"
    },
    "revision_deterministic_validation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Revision Deterministic Validation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/revision-deterministic-validation/v2",
      "default": "eval-factory/revision-deterministic-validation/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_deterministic_validation_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "validation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Validation Sha256",
      "type": "string"
    }
  },
  "required": [
    "revision_deterministic_validation_id",
    "candidate_revision_ref",
    "source_deterministic_validation_result_ref",
    "artifact_validation_result_refs",
    "finding_refs",
    "output_refs",
    "outcome",
    "validation_sha256",
    "audit"
  ],
  "title": "RevisionDeterministicValidationV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.review_v2.RevisionDeterministicValidationV2",
  "x-schema-version": "eval-factory/revision-deterministic-validation/v2"
}
