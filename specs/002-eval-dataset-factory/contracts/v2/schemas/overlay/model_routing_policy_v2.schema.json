{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/model_routing_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "allowed_agent_definition_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Allowed Agent Definition Refs",
      "type": "array"
    },
    "allowed_model_profile_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Allowed Model Profile Refs",
      "type": "array"
    },
    "allowed_provider_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Allowed Provider Ids",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "cost_weight": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Cost Weight",
      "type": "integer"
    },
    "health_weight": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Health Weight",
      "type": "integer"
    },
    "latency_weight": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Latency Weight",
      "type": "integer"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "model-routing/v1",
      "default": "model-routing/v1",
      "title": "Policy Version",
      "type": "string"
    },
    "quality_weight": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Quality Weight",
      "type": "integer"
    },
    "routing_policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Routing Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/model-routing-policy/v2",
      "default": "eval-factory/model-routing-policy/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "routing_policy_id",
    "allowed_provider_ids",
    "allowed_agent_definition_refs",
    "allowed_model_profile_refs",
    "quality_weight",
    "health_weight",
    "latency_weight",
    "cost_weight"
  ],
  "title": "ModelRoutingPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.ai_gateway_v2.ModelRoutingPolicyV2",
  "x-schema-version": "eval-factory/model-routing-policy/v2"
}
