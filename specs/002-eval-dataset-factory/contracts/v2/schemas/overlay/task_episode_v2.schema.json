{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "TaskEpisodeSegmentEvidenceBindingV2": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ref Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/task-episode-segment-evidence-binding/v2",
          "default": "eval-factory/task-episode-segment-evidence-binding/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "segment_ref",
        "evidence_ref_ids"
      ],
      "title": "TaskEpisodeSegmentEvidenceBindingV2",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/task_episode_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "evidence_bundle_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "model_profile": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Model Profile",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "rationale_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/task-episode/v2",
      "default": "eval-factory/task-episode/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_evidence_bindings": {
      "items": {
        "$ref": "#/$defs/TaskEpisodeSegmentEvidenceBindingV2"
      },
      "minItems": 1,
      "title": "Segment Evidence Bindings",
      "type": "array"
    },
    "segment_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Segment Refs",
      "type": "array"
    },
    "selection_context_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "task_episode_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Task Episode Id",
      "type": "string"
    },
    "task_episode_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Episode Sha256",
      "type": "string"
    },
    "trace_envelope_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "task_episode_id",
    "selection_context_ref",
    "trace_envelope_ref",
    "segment_refs",
    "segment_evidence_bindings",
    "rationale_ref",
    "evidence_bundle_ref",
    "model_profile",
    "prompt_version",
    "policy_version",
    "task_episode_sha256",
    "audit"
  ],
  "title": "TaskEpisodeV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.TaskEpisodeV2",
  "x-schema-version": "eval-factory/task-episode/v2"
}
