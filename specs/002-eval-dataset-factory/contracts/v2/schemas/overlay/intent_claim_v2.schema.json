{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/intent_claim_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Claim Id",
      "type": "string"
    },
    "confidence_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Confidence Basis Points",
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/intent-claim/v2",
      "default": "eval-factory/intent-claim/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "uncertain": {
      "title": "Uncertain",
      "type": "boolean"
    }
  },
  "required": [
    "claim_id",
    "summary",
    "evidence_refs",
    "confidence_basis_points",
    "uncertain"
  ],
  "title": "IntentClaimV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.agent_system_v2.IntentClaimV2",
  "x-schema-version": "eval-factory/intent-claim/v2"
}
