{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ModelRouteCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "estimated_cost_micro_usd": {
          "anyOf": [
            {
              "maximum": 10000000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Micro Usd"
        },
        "health_basis_points": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Health Basis Points"
        },
        "latency_milliseconds": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Milliseconds"
        },
        "model_profile_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "quality_basis_points": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Basis Points"
        },
        "rejection_codes": {
          "items": {
            "$ref": "#/$defs/ModelRouteRejectionCodeV2"
          },
          "title": "Rejection Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/model-route-candidate/v2",
          "default": "eval-factory/model-route-candidate/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        }
      },
      "required": [
        "model_profile_ref",
        "eligible",
        "rejection_codes",
        "score"
      ],
      "title": "ModelRouteCandidateV2",
      "type": "object"
    },
    "ModelRouteRejectionCodeV2": {
      "enum": [
        "GOVERNANCE_AGENT_NOT_ALLOWED",
        "GOVERNANCE_MODEL_NOT_ALLOWED",
        "GOVERNANCE_DATA_CLASSIFICATION",
        "GOVERNANCE_RESIDENCY",
        "CAPABILITY_MISMATCH",
        "CONTEXT_LIMIT",
        "OUTPUT_LIMIT",
        "PROVIDER_UNAVAILABLE",
        "QUALITY_BASELINE_MISSING",
        "QUALITY_BELOW_MINIMUM",
        "HEALTH_SNAPSHOT_MISSING",
        "PRICE_SCHEDULE_MISSING",
        "BUDGET_EXCEEDED",
        "GENERATOR_JUDGE_COLLISION",
        "PREDECESSOR_MODEL_EXCLUDED"
      ],
      "title": "ModelRouteRejectionCodeV2",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/model_route_decision_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "budget_reservation_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ModelRouteCandidateV2"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Candidates",
      "type": "array"
    },
    "health_snapshot_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "no_silent_fallback": {
      "const": true,
      "default": true,
      "title": "No Silent Fallback",
      "type": "boolean"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "predecessor_route_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "price_schedule_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "quality_baseline_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "request_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "route_decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Route Decision Id",
      "type": "string"
    },
    "route_version": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Route Version",
      "type": "integer"
    },
    "routing_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/model-route-decision/v2",
      "default": "eval-factory/model-route-decision/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_model_profile_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "route_decision_id",
    "request_ref",
    "route_version",
    "predecessor_route_ref",
    "selected_model_profile_ref",
    "candidates",
    "routing_policy_ref",
    "quality_baseline_ref",
    "health_snapshot_ref",
    "price_schedule_ref",
    "budget_reservation_ref"
  ],
  "title": "ModelRouteDecisionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.ai_gateway_v2.ModelRouteDecisionV2",
  "x-schema-version": "eval-factory/model-route-decision/v2"
}
