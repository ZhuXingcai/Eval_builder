{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PromptLeakageCategoryV2": {
      "enum": [
        "FINAL_ANSWER",
        "COMPLETED_DELIVERABLE",
        "PRIVATE_REFERENCE",
        "GRADER_RULE",
        "HIDDEN_PASS_CONDITION",
        "HIDDEN_SELECTION_SIGNAL",
        "TRAJECTORY_SPECIFIC_STEP"
      ],
      "title": "PromptLeakageCategoryV2",
      "type": "string"
    },
    "PromptLeakageFingerprintV2": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/PromptLeakageCategoryV2"
        },
        "classification_evidence_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "digest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest Sha256",
          "type": "string"
        },
        "fingerprint_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Fingerprint Id",
          "type": "string"
        },
        "match_kind": {
          "$ref": "#/$defs/PromptLeakageMatchKindV2"
        },
        "normalization_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Normalization Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/prompt-leakage-fingerprint/v2",
          "default": "eval-factory/prompt-leakage-fingerprint/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_provenance_decision_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "source_subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "token_count": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "fingerprint_id",
        "category",
        "source_subject_ref",
        "source_provenance_decision_ref",
        "classification_evidence_ref",
        "match_kind",
        "digest_sha256",
        "token_count",
        "normalization_version"
      ],
      "title": "PromptLeakageFingerprintV2",
      "type": "object"
    },
    "PromptLeakageMatchKindV2": {
      "enum": [
        "NORMALIZED_FULL_TEXT",
        "TOKEN_WINDOW",
        "PATH_COMPONENT"
      ],
      "title": "PromptLeakageMatchKindV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/prompt_leakage_reference_set_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "complete_categories": {
      "items": {
        "$ref": "#/$defs/PromptLeakageCategoryV2"
      },
      "title": "Complete Categories",
      "type": "array",
      "uniqueItems": true
    },
    "fingerprint_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Fingerprint Policy Version",
      "type": "string"
    },
    "fingerprints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PromptLeakageFingerprintV2"
      },
      "title": "Fingerprints",
      "type": "array"
    },
    "reference_set_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Reference Set Id",
      "type": "string"
    },
    "reference_set_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reference Set Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/prompt-leakage-reference-set/v2",
      "default": "eval-factory/prompt-leakage-reference-set/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_envelope_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "reference_set_id",
    "trace_envelope_ref",
    "complete_categories",
    "fingerprint_policy_version",
    "reference_set_sha256",
    "audit"
  ],
  "title": "PromptLeakageReferenceSetV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.PromptLeakageReferenceSetV2",
  "x-schema-version": "eval-factory/prompt-leakage-reference-set/v2"
}
