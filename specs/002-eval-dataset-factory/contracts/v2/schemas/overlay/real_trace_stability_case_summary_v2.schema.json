{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ParseQuality": {
      "enum": [
        "STRICT",
        "REPAIRED",
        "PARTIAL",
        "UNPARSEABLE"
      ],
      "title": "ParseQuality",
      "type": "string"
    },
    "RealTraceStabilityCaseOutcomeV2": {
      "enum": [
        "STABLE",
        "UNSTABLE",
        "INFRASTRUCTURE_ERROR",
        "INCOMPLETE"
      ],
      "title": "RealTraceStabilityCaseOutcomeV2",
      "type": "string"
    },
    "RealTraceStabilityFaultPointV2": {
      "enum": [
        "before_source_registration",
        "after_source_registration",
        "after_trace_store_persist",
        "before_stage_completion"
      ],
      "title": "RealTraceStabilityFaultPointV2",
      "type": "string"
    },
    "RealTraceStabilityReasonCodeV2": {
      "enum": [
        "NONE",
        "TRACE_RUN_FAILED",
        "EXPECTED_FAULT_NOT_OBSERVED",
        "RESUME_FAILED",
        "UNEXPECTED_RETRY",
        "REPLAY_MISMATCH",
        "DUPLICATE_COMPLETION",
        "MATERIAL_INTEGRITY_ERROR",
        "CHILD_STATE_INCOMPLETE",
        "INTERNAL_ERROR"
      ],
      "title": "RealTraceStabilityReasonCodeV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/real_trace_stability_case_summary_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "assigned_fault_point": {
      "$ref": "#/$defs/RealTraceStabilityFaultPointV2"
    },
    "attempt_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "case_summary_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Case Summary Id",
      "type": "string"
    },
    "case_summary_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Case Summary Sha256",
      "type": "string"
    },
    "completion_witness_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Completion Witness Count",
      "type": "integer"
    },
    "fault_observed": {
      "title": "Fault Observed",
      "type": "boolean"
    },
    "outcome": {
      "$ref": "#/$defs/RealTraceStabilityCaseOutcomeV2"
    },
    "parse_quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParseQuality"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_version": {
      "const": "real-trace-stability/r8-04-v1",
      "default": "real-trace-stability/r8-04-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "private_case_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "reason_code": {
      "$ref": "#/$defs/RealTraceStabilityReasonCodeV2"
    },
    "replay_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Replay Count",
      "type": "integer"
    },
    "replay_stable": {
      "title": "Replay Stable",
      "type": "boolean"
    },
    "resume_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Resume Count",
      "type": "integer"
    },
    "resume_succeeded": {
      "title": "Resume Succeeded",
      "type": "boolean"
    },
    "schema_version": {
      "const": "eval-factory/real-trace-stability-case-summary/v2",
      "default": "eval-factory/real-trace-stability-case-summary/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_result_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Stage Result Count",
      "type": "integer"
    },
    "threshold_matched": {
      "title": "Threshold Matched",
      "type": "boolean"
    },
    "unexpected_retry_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Unexpected Retry Count",
      "type": "integer"
    }
  },
  "required": [
    "case_summary_id",
    "private_case_result_ref",
    "outcome",
    "reason_code",
    "assigned_fault_point",
    "fault_observed",
    "resume_succeeded",
    "replay_stable",
    "attempt_count",
    "unexpected_retry_count",
    "resume_count",
    "replay_count",
    "stage_result_count",
    "completion_witness_count",
    "threshold_matched",
    "case_summary_sha256",
    "audit"
  ],
  "title": "RealTraceStabilityCaseSummaryV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.real_trace_stability_v2.RealTraceStabilityCaseSummaryV2",
  "x-schema-version": "eval-factory/real-trace-stability-case-summary/v2"
}
