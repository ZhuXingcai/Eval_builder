{
  "$defs": {
    "CandidateArtifactVersionV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_version": {
          "minimum": 1,
          "title": "Artifact Version",
          "type": "integer"
        },
        "artifact_version_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Version Sha256",
          "type": "string"
        },
        "attachment_dependency_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Attachment Dependency Id",
          "type": "string"
        },
        "base_artifact_build_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "build_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "candidate_artifact_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Candidate Artifact Version Id",
          "type": "string"
        },
        "declared_validator_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Declared Validator Ids",
          "type": "array"
        },
        "derivation_root_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Derivation Root Refs",
          "type": "array"
        },
        "execution_request_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "execution_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "logical_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Logical Path",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "output_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "output_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "policy_version": {
          "const": "candidate-revision/r5-09-v1",
          "default": "candidate-revision/r5-09-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "predecessor_artifact_version_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repaired_artifact_result_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "eval-factory/candidate-artifact-version/v2",
          "default": "eval-factory/candidate-artifact-version/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate_artifact_version_id",
        "artifact_id",
        "attachment_dependency_id",
        "artifact_version",
        "base_artifact_build_result_ref",
        "build_spec_ref",
        "execution_request_ref",
        "execution_result_ref",
        "output_ref",
        "output_sha256",
        "logical_path",
        "media_type",
        "declared_validator_ids",
        "derivation_root_refs",
        "artifact_version_sha256"
      ],
      "title": "CandidateArtifactVersionV2",
      "type": "object"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/attachment_candidate_revision_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "accepted_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Accepted Artifact Refs",
      "type": "array"
    },
    "artifact_version_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Artifact Version Refs",
      "type": "array"
    },
    "artifact_versions": {
      "items": {
        "$ref": "#/$defs/CandidateArtifactVersionV2"
      },
      "title": "Artifact Versions",
      "type": "array"
    },
    "attachment_candidate_revision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Attachment Candidate Revision Id",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "base_reconstruction_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "candidate_output_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Candidate Output Refs",
      "type": "array"
    },
    "candidate_revision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Revision Sha256",
      "type": "string"
    },
    "changed_artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Changed Artifact Ids",
      "type": "array"
    },
    "environment_spec_ref": {
      "default": null,
      "title": "Environment Spec Ref",
      "type": "null"
    },
    "input_state_only": {
      "default": null,
      "title": "Input State Only",
      "type": "null"
    },
    "package_sha256": {
      "default": null,
      "title": "Package Sha256",
      "type": "null"
    },
    "policy_version": {
      "const": "candidate-revision/r5-09-v1",
      "default": "candidate-revision/r5-09-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "predecessor_revision_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance_manifest_ref": {
      "default": null,
      "title": "Provenance Manifest Ref",
      "type": "null"
    },
    "quality_report_ref": {
      "default": null,
      "title": "Quality Report Ref",
      "type": "null"
    },
    "repair_plan_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repair_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Repair Result Refs",
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "eval-factory/attachment-candidate-revision/v2",
      "default": "eval-factory/attachment-candidate-revision/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "attachment_candidate_revision_id",
    "revision",
    "base_reconstruction_result_ref",
    "artifact_versions",
    "artifact_version_refs",
    "candidate_output_refs",
    "changed_artifact_ids",
    "candidate_revision_sha256",
    "audit"
  ],
  "title": "AttachmentCandidateRevisionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.review_v2.AttachmentCandidateRevisionV2",
  "x-schema-version": "eval-factory/attachment-candidate-revision/v2"
}
