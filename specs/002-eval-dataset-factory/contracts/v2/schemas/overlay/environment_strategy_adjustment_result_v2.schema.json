      "type": "boolean"
    },
    "invalidation_scope": {
      "$ref": "#/$defs/InvalidationScope"
    },
    "policy_version": {
      "const": "user-plan-application/r7-06-v1",
      "default": "user-plan-application/r7-06-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "replacement_strategy_ref": {
