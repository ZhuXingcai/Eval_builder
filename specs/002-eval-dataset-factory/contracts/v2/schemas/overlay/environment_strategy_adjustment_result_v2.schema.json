    "result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Result Id",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/environment-strategy-adjustment-result/v2",
      "default": "eval-factory/environment-strategy-adjustment-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_request_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "source_strategy_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "result_id",
    "source_request_ref",
    "source_strategy_ref",
    "adjustments",
    "replacement_strategy_ref",
    "invalidation_scope",
    "result_sha256",
    "audit"
  ],
  "title": "EnvironmentStrategyAdjustmentResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.approval_application_v2.EnvironmentStrategyAdjustmentResultV2",
  "x-schema-version": "eval-factory/environment-strategy-adjustment-result/v2"
}
