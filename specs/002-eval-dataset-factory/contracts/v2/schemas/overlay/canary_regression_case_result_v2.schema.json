{
  "$defs": {
    "CanaryRegressionExpectationV2": {
      "enum": [
        "MUST_SUCCEED",
        "ANY_TYPED_TERMINAL"
      ],
      "title": "CanaryRegressionExpectationV2",
      "type": "string"
    },
    "CanaryRegressionObservedOutcomeV2": {
      "enum": [
        "SUCCEEDED",
        "BLOCKED",
        "FAILED",
        "INFRASTRUCTURE_ERROR",
        "INCOMPLETE"
      ],
      "title": "CanaryRegressionObservedOutcomeV2",
      "type": "string"
    },
    "CanaryRegressionReasonCodeV2": {
      "enum": [
        "NONE",
        "LABEL_NO_MATCH",
        "STAGE_BLOCKED_POLICY",
        "STAGE_BLOCKED_CAPABILITY",
        "STAGE_RETRY_EXHAUSTED",
        "RESOURCE_WAITING",
        "RESOURCE_BUDGET_EXHAUSTED",
        "RESOURCE_UNSATISFIABLE",
        "PROFILE_POLICY_ERROR",
        "LIFECYCLE_POLICY_ERROR",
        "MATERIAL_INTEGRITY_ERROR",
        "CHILD_STATE_INCOMPLETE",
        "OUTCOME_MISMATCH",
        "INTERNAL_ERROR"
      ],
      "title": "CanaryRegressionReasonCodeV2",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ItemStatus": {
      "enum": [
        "CANDIDATE",
        "RUNNING",
        "NEEDS_REVIEW",
        "APPROVED",
        "REJECTED",
        "RELEASED",
        "REVOKED",
        "FAILED"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "CREATED",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "StageNameV2": {
      "enum": [
        "trace_index",
        "safety",
        "label_plan",
        "label",
        "task_rewrite_plan",
        "task_authoring",
        "environment_strategy",
        "attachment",
        "item_quality",
        "batch_quality",
        "final_dataset_review",
        "release"
      ],
      "title": "StageNameV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
