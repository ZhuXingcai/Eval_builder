{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/compiled_criteria_rubric_plan_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "acceptance_check_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Acceptance Check Refs",
      "type": "array"
    },
    "agent_definition_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "attachment_quality_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "capability_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Capability Refs",
      "type": "array"
    },
    "compiled_plan_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Compiled Plan Id",
      "type": "string"
    },
    "compiler_version": {
      "const": "criteria-rubric-plan-compiler/v1",
      "default": "criteria-rubric-plan-compiler/v1",
      "title": "Compiler Version",
      "type": "string"
    },
    "model_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "production_release_allowed": {
      "const": false,
      "default": false,
      "title": "Production Release Allowed",
      "type": "boolean"
    },
    "prompt_template_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/compiled-criteria-rubric-plan/v2",
      "default": "eval-factory/compiled-criteria-rubric-plan/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "solvability_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "source_plan_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "task_draft_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "tool_catalog_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "compiled_plan_id",
    "source_plan_ref",
    "policy_ref",
    "agent_definition_ref",
    "capability_refs",
    "task_draft_ref",
    "attachment_quality_ref",
    "solvability_ref",
    "tool_catalog_ref",
    "prompt_template_ref",
    "model_policy_ref",
    "acceptance_check_refs"
  ],
  "title": "CompiledCriteriaRubricPlanV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.agent_system_v2.CompiledCriteriaRubricPlanV2",
  "x-schema-version": "eval-factory/compiled-criteria-rubric-plan/v2"
}
