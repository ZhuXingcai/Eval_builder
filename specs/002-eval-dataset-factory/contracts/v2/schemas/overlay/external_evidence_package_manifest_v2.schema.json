{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "TypedAttribute": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Key",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/typed-attribute/v1",
          "default": "eval-factory/typed-attribute/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "TypedAttribute",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/external_evidence_package_manifest_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "adapter_name": {
      "enum": [
        "curated_trajectory_v1",
        "runtime_snapshot_v1"
      ],
      "title": "Adapter Name",
      "type": "string"
    },
    "adapter_version": {
      "const": "1.0.0",
      "title": "Adapter Version",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "development_partition_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "inventory_commitment_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "inventory_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Inventory Sha256",
      "type": "string"
    },
    "label_spec_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Label Spec Refs",
      "type": "array"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "observation_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "policy_version": {
      "const": "external-evidence/r8-10-v1",
      "default": "external-evidence/r8-10-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "reference_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "requirement_source_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "requirement_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "runtime_counts": {
      "items": {
        "$ref": "#/$defs/TypedAttribute"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Runtime Counts",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/external-evidence-package-manifest/v2",
      "default": "eval-factory/external-evidence-package-manifest/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_authorization_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "source_count": {
      "maximum": 100000,
      "minimum": 100,
      "title": "Source Count",
      "type": "integer"
    },
    "source_population_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "total_raw_bytes": {
      "maximum": 1000000000000,
      "minimum": 1,
      "title": "Total Raw Bytes",
      "type": "integer"
    },
    "train_partition_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "unique_raw_hash_count": {
      "maximum": 100000,
      "minimum": 100,
      "title": "Unique Raw Hash Count",
      "type": "integer"
    },
    "unique_trace_count": {
      "maximum": 100000,
      "minimum": 100,
      "title": "Unique Trace Count",
      "type": "integer"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "requirement_source_ref",
    "requirement_spec_ref",
    "source_authorization_ref",
    "source_population_ref",
    "inventory_commitment_ref",
    "train_partition_ref",
    "development_partition_ref",
    "label_spec_refs",
    "reference_policy_ref",
    "observation_policy_ref",
    "adapter_name",
    "adapter_version",
    "source_count",
    "unique_trace_count",
    "unique_raw_hash_count",
    "total_raw_bytes",
    "runtime_counts",
    "inventory_sha256"
  ],
  "title": "ExternalEvidencePackageManifestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.external_evidence_v2.ExternalEvidencePackageManifestV2",
  "x-schema-version": "eval-factory/external-evidence-package-manifest/v2"
}
