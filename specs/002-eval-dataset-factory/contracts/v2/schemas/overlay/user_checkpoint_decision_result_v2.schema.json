              "type": "null"
            }
          ],
          "default": null
        },
        "interaction_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Interaction Id",
          "type": "string"
        },
        "interaction_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Interaction Sha256",
          "type": "string"
        },
        "interaction_version": {
          "minimum": 1,
