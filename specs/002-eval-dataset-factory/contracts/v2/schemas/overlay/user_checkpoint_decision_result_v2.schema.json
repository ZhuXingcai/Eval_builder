        "interaction_id",
        "job_id",
        "chain_id",
        "interaction_version",
        "checkpoint",
        "request_compilation_ref",
        "request_ref",
        "presentation_ref",
        "source_context_ref",
        "state",
        "job_status",
        "occurred_at",
        "policy_ref",
        "interaction_sha256",
        "audit"
      ],
      "title": "UserCheckpointInteractionV2",
      "type": "object"
    },
    "UserCheckpointResumeDispositionV2": {
      "enum": [
        "DIRECT",
        "AFTER_REVALIDATION",
        "NEXT_REQUEST",
        "WAITING_REVISION",
        "DEFERRED",
        "TERMINATED"
      ],
      "title": "UserCheckpointResumeDispositionV2",
      "type": "string"
    },
    "UserDecision": {
      "enum": [
        "ACCEPT",
        "ADJUST",
        "REJECT",
        "REQUEST_MORE_EXAMPLES",
        "DEFER"
      ],
      "title": "UserDecision",
      "type": "string"
    },
    "UserDecisionAdjustmentEffectV2": {
      "additionalProperties": false,
      "properties": {
        "adjustments": {
          "items": {
            "$ref": "#/$defs/TypedAdjustment"
          },
          "minItems": 1,
          "title": "Adjustments",
          "type": "array"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "checkpoint": {
          "$ref": "#/$defs/ApprovalCheckpoint"
