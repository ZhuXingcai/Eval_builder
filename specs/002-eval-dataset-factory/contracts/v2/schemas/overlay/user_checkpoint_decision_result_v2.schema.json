          "type": "integer"
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Job Id",
          "type": "string"
        },
        "job_status": {
          "$ref": "#/$defs/JobStatus"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "predecessor_interaction_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "presentation_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "request_compilation_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "request_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/user-checkpoint-interaction/v2",
          "default": "eval-factory/user-checkpoint-interaction/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_context_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "state": {
          "$ref": "#/$defs/UserCheckpointInteractionStateV2"
