{
  "$defs": {
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    },
    "WorldLedgerFactLockV2": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Fact Id",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/world-ledger-fact-lock/v2",
          "default": "env-mock-agent/world-ledger-fact-lock/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FacadeObjectRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "value_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "value_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Value Sha256",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "value_ref",
        "value_sha256"
      ],
      "title": "WorldLedgerFactLockV2",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/world_ledger_snapshot_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "fact_locks": {
      "items": {
        "$ref": "#/$defs/WorldLedgerFactLockV2"
      },
      "title": "Fact Locks",
      "type": "array"
    },
    "ledger_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Ledger Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "artifact-execution/r5-06-v1",
      "default": "artifact-execution/r5-06-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "env-mock-agent/world-ledger-snapshot/v2",
      "default": "env-mock-agent/world-ledger-snapshot/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_request_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "snapshotted_at": {
      "format": "date-time",
      "title": "Snapshotted At",
      "type": "string"
    },
    "world_ledger_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "world_ledger_snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "World Ledger Snapshot Id",
      "type": "string"
    },
    "world_ledger_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "World Ledger Snapshot Sha256",
      "type": "string"
    }
  },
  "required": [
    "world_ledger_snapshot_id",
    "snapshot_request_ref",
    "world_ledger_ref",
    "fact_locks",
    "ledger_sha256",
    "snapshotted_at",
    "world_ledger_snapshot_sha256"
  ],
  "title": "WorldLedgerSnapshotV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.execution_v2.WorldLedgerSnapshotV2",
  "x-schema-version": "env-mock-agent/world-ledger-snapshot/v2"
}
