{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ExternalReferenceAuthoringModeV2": {
      "enum": [
        "AUTOMATIC_INDEPENDENT",
        "IMPORTED_INDEPENDENT"
      ],
      "title": "ExternalReferenceAuthoringModeV2",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/external_label_observation_summary_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "authoring_mode": {
      "$ref": "#/$defs/ExternalReferenceAuthoringModeV2"
    },
    "label_spec_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Label Spec Refs",
      "type": "array"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "observation_blocked_count": {
      "maximum": 30000000,
      "minimum": 0,
      "title": "Observation Blocked Count",
      "type": "integer"
    },
    "observation_closure_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "observation_complete_count": {
      "maximum": 30000000,
      "minimum": 0,
      "title": "Observation Complete Count",
      "type": "integer"
    },
    "observation_missing_count": {
      "maximum": 30000000,
      "minimum": 0,
      "title": "Observation Missing Count",
      "type": "integer"
    },
    "observation_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "observation_reference_access_denied": {
      "const": true,
      "default": true,
      "title": "Observation Reference Access Denied",
      "type": "boolean"
    },
    "package_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "policy_version": {
      "const": "external-evidence/r8-10-v1",
      "default": "external-evidence/r8-10-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "reference_abstained_count": {
      "maximum": 30000000,
      "minimum": 0,
      "title": "Reference Abstained Count",
      "type": "integer"
    },
    "reference_authority_committed": {
      "const": true,
      "default": true,
      "title": "Reference Authority Committed",
      "type": "boolean"
    },
    "reference_blocked_count": {
      "maximum": 30000000,
      "minimum": 0,
      "title": "Reference Blocked Count",
      "type": "integer"
    },
    "reference_closure_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "reference_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "reference_ready_count": {
      "maximum": 30000000,
      "minimum": 0,
      "title": "Reference Ready Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "eval-factory/external-label-observation-summary/v2",
      "default": "eval-factory/external-label-observation-summary/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_population_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "total_pair_count": {
      "maximum": 30000000,
      "minimum": 1,
      "title": "Total Pair Count",
      "type": "integer"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "package_manifest_ref",
    "source_population_ref",
    "reference_closure_ref",
    "observation_closure_ref",
    "label_spec_refs",
    "reference_policy_ref",
    "observation_policy_ref",
    "authoring_mode",
    "total_pair_count",
    "reference_ready_count",
    "reference_abstained_count",
    "reference_blocked_count",
    "observation_complete_count",
    "observation_missing_count",
    "observation_blocked_count"
  ],
  "title": "ExternalLabelObservationSummaryV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.external_evidence_v2.ExternalLabelObservationSummaryV2",
  "x-schema-version": "eval-factory/external-label-observation-summary/v2"
}
