{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "SchedulerLoadFaultPointV2": {
      "enum": [
        "AFTER_JOB_CREATE",
        "AFTER_WORK_GRAPH_CREATE",
        "AFTER_JOB_START",
        "AFTER_READINESS_RECORD",
        "AFTER_CONTROL_POLICY_BIND",
        "AFTER_LEASE_ACQUIRE",
        "AFTER_STAGE_COMPLETION",
        "AFTER_OBSERVABILITY_REFRESH"
      ],
      "title": "SchedulerLoadFaultPointV2",
      "type": "string"
    },
    "StageNameV2": {
      "enum": [
        "trace_index",
        "safety",
        "label_plan",
        "label",
        "task_rewrite_plan",
        "task_authoring",
        "environment_strategy",
        "attachment",
        "item_quality",
        "batch_quality",
        "final_dataset_review",
        "release"
      ],
      "title": "StageNameV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/scheduler_load_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "fault_points": {
      "default": [
        "AFTER_JOB_CREATE",
        "AFTER_WORK_GRAPH_CREATE",
        "AFTER_JOB_START",
        "AFTER_READINESS_RECORD",
        "AFTER_CONTROL_POLICY_BIND",
        "AFTER_LEASE_ACQUIRE",
        "AFTER_STAGE_COMPLETION",
        "AFTER_OBSERVABILITY_REFRESH"
      ],
      "items": {
        "$ref": "#/$defs/SchedulerLoadFaultPointV2"
      },
      "title": "Fault Points",
      "type": "array"
    },
    "heartbeat_extension_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Heartbeat Extension Seconds",
      "type": "integer"
    },
    "lease_duration_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Lease Duration Seconds",
      "type": "integer"
    },
    "max_attempts": {
      "const": 1,
      "default": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_private_bytes": {
      "maximum": 1000000000,
      "minimum": 2,
      "title": "Max Private Bytes",
      "type": "integer"
    },
    "max_report_bytes": {
      "maximum": 100000000,
      "minimum": 2,
      "title": "Max Report Bytes",
      "type": "integer"
    },
    "max_unexpected_retries": {
      "const": 0,
      "default": 0,
      "title": "Max Unexpected Retries",
      "type": "integer"
    },
    "observability_policy_version": {
      "const": "batch-observability/r6-06-v1",
      "default": "batch-observability/r6-06-v1",
      "title": "Observability Policy Version",
      "type": "string"
    },
    "plan_policy_version": {
      "const": "dataset-job-stage-policy/r6-01-v1",
      "default": "dataset-job-stage-policy/r6-01-v1",
      "title": "Plan Policy Version",
      "type": "string"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "scheduler-load/r8-05-v1",
      "default": "scheduler-load/r8-05-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "requested_stages": {
      "default": [
        "trace_index"
      ],
      "items": {
        "$ref": "#/$defs/StageNameV2"
      },
      "title": "Requested Stages",
      "type": "array"
    },
    "require_exact_replay": {
      "const": true,
      "default": true,
      "title": "Require Exact Replay",
      "type": "boolean"
    },
    "require_fault_per_job": {
      "const": true,
      "default": true,
      "title": "Require Fault Per Job",
      "type": "boolean"
    },
    "require_resume_success": {
      "const": true,
      "default": true,
      "title": "Require Resume Success",
      "type": "boolean"
    },
    "required_attempt_metrics_per_job": {
      "const": 1,
      "default": 1,
      "title": "Required Attempt Metrics Per Job",
      "type": "integer"
    },
    "required_job_count": {
      "const": 1000,
      "default": 1000,
      "title": "Required Job Count",
      "type": "integer"
    },
    "required_stage_results_per_job": {
      "const": 1,
      "default": 1,
      "title": "Required Stage Results Per Job",
      "type": "integer"
    },
    "retry_delay_seconds": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Retry Delay Seconds",
      "type": "array"
    },
    "retry_lease_expiry": {
      "const": false,
      "default": false,
      "title": "Retry Lease Expiry",
      "type": "boolean"
    },
    "schema_version": {
      "const": "eval-factory/scheduler-load-policy/v2",
      "default": "eval-factory/scheduler-load-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "work_control_policy_version": {
      "const": "work-control/r6-05-v1",
      "default": "work-control/r6-05-v1",
      "title": "Work Control Policy Version",
      "type": "string"
    },
    "work_graph_policy_version": {
      "const": "dataset-work-graph/r6-02-v1",
      "default": "dataset-work-graph/r6-02-v1",
      "title": "Work Graph Policy Version",
      "type": "string"
    },
    "worker_count": {
      "const": 1,
      "default": 1,
      "title": "Worker Count",
      "type": "integer"
    },
    "workload_seed": {
      "const": "scheduler-load/r8-05-v1",
      "default": "scheduler-load/r8-05-v1",
      "title": "Workload Seed",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "lease_duration_seconds",
    "heartbeat_extension_seconds",
    "max_private_bytes",
    "max_report_bytes",
    "policy_sha256",
    "audit"
  ],
  "title": "SchedulerLoadPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.scheduler_load_v2.SchedulerLoadPolicyV2",
  "x-schema-version": "eval-factory/scheduler-load-policy/v2"
}
