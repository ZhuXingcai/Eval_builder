{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/release_publication_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "allowed_profile": {
      "const": "LH",
      "default": "LH",
      "title": "Allowed Profile",
      "type": "string"
    },
    "allowed_profile_version": {
      "const": "v1",
      "default": "v1",
      "title": "Allowed Profile Version",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "canary_registry_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Canary Registry Ids",
      "type": "array",
      "uniqueItems": true
    },
    "internal_review_registry_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Internal Review Registry Ids",
      "type": "array",
      "uniqueItems": true
    },
    "max_items": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Items",
      "type": "integer"
    },
    "max_manifest_refs": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Manifest Refs",
      "type": "integer"
    },
    "max_workspace_bytes_per_item": {
      "maximum": 5000000000,
      "minimum": 1,
      "title": "Max Workspace Bytes Per Item",
      "type": "integer"
    },
    "max_workspace_members_per_item": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Workspace Members Per Item",
      "type": "integer"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "release-publication/r7-09-v1",
      "default": "release-publication/r7-09-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "query_policy_version": {
      "const": "lh-query-packaging/r7-09-v1",
      "default": "lh-query-packaging/r7-09-v1",
      "title": "Query Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/release-publication-policy/v2",
      "default": "eval-factory/release-publication-policy/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "max_items",
    "max_workspace_members_per_item",
    "max_workspace_bytes_per_item",
    "max_manifest_refs",
    "canary_registry_ids",
    "internal_review_registry_ids",
    "policy_sha256",
    "audit"
  ],
  "title": "ReleasePublicationPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.release_publication_v2.ReleasePublicationPolicyV2",
  "x-schema-version": "eval-factory/release-publication-policy/v2"
}
