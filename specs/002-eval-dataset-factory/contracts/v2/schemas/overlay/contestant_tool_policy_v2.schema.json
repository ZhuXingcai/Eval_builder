{
  "$defs": {
    "ContestantToolRuleV2": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "ALLOW",
          "default": "ALLOW",
          "title": "Action",
          "type": "string"
        },
        "contestant_constraint_profile_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "contestant_descriptor_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rule Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/contestant-tool-rule/v2",
          "default": "eval-factory/contestant-tool-rule/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_family": {
          "$ref": "#/$defs/ToolFamily"
        },
        "tool_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "tool_id",
        "tool_family",
        "contestant_descriptor_ref",
        "contestant_constraint_profile_ref",
        "rule_sha256"
      ],
      "title": "ContestantToolRuleV2",
      "type": "object"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ToolFamily": {
      "enum": [
        "file_read",
        "file_write",
        "file_edit",
        "file_list",
        "search",
        "fetch",
        "shell",
        "code_execution",
        "user_interaction",
        "subagent",
        "task_management",
        "unknown"
      ],
      "title": "ToolFamily",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/contestant_tool_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "contestant_tool_policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Contestant Tool Policy Id",
      "type": "string"
    },
    "contestant_tool_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contestant Tool Policy Sha256",
      "type": "string"
    },
    "default_action": {
      "const": "DENY",
      "default": "DENY",
      "title": "Default Action",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContestantToolRuleV2"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/contestant-tool-policy/v2",
      "default": "eval-factory/contestant-tool-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_task_draft_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Task Draft Sha256",
      "type": "string"
    }
  },
  "required": [
    "contestant_tool_policy_id",
    "source_task_draft_sha256",
    "policy_version",
    "contestant_tool_policy_sha256",
    "audit"
  ],
  "title": "ContestantToolPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.ContestantToolPolicyV2",
  "x-schema-version": "eval-factory/contestant-tool-policy/v2"
}
