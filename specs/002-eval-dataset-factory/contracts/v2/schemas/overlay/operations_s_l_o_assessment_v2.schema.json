{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "OperationsSLOAssessmentOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "INCOMPLETE"
      ],
      "title": "OperationsSLOAssessmentOutcomeV2",
      "type": "string"
    },
    "OperationsSLOComparatorV2": {
      "enum": [
        "GREATER_THAN_OR_EQUAL",
        "LESS_THAN_OR_EQUAL"
      ],
      "title": "OperationsSLOComparatorV2",
      "type": "string"
    },
    "OperationsSLOMetricAvailabilityV2": {
      "enum": [
        "MEASURED",
        "UNAVAILABLE",
        "INSUFFICIENT_SAMPLE"
      ],
      "title": "OperationsSLOMetricAvailabilityV2",
      "type": "string"
    },
    "OperationsSLOMetricNameV2": {
      "enum": [
        "THROUGHPUT_MILLIJOBS_PER_SECOND",
        "P50_LATENCY_MICROSECONDS",
        "P95_LATENCY_MICROSECONDS",
        "MODEL_REQUESTS_PER_JOB_MILLI",
        "COST_MICRO_USD_PER_JOB",
        "QUEUE_WAIT_P95_MICROSECONDS",
        "ERROR_RATE_BASIS_POINTS",
        "RESUME_SUCCESS_BASIS_POINTS"
      ],
      "title": "OperationsSLOMetricNameV2",
      "type": "string"
    },
    "OperationsSLOMetricV2": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/OperationsSLOMetricAvailabilityV2"
        },
        "comparator": {
          "$ref": "#/$defs/OperationsSLOComparatorV2"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 1000,
          "title": "Evidence Refs",
          "type": "array"
        },
        "meets_threshold": {
          "title": "Meets Threshold",
          "type": "boolean"
        },
        "metric": {
          "$ref": "#/$defs/OperationsSLOMetricNameV2"
        },
        "observed_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "required_sample_count": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Required Sample Count",
          "type": "integer"
        },
        "sample_count": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "eval-factory/operations-slo-metric/v2",
          "default": "eval-factory/operations-slo-metric/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "threshold_value": {
          "minimum": 0,
          "title": "Threshold Value",
          "type": "integer"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "unit",
        "comparator",
        "threshold_value",
        "sample_count",
        "required_sample_count",
        "availability",
        "meets_threshold",
        "evidence_refs"
      ],
      "title": "OperationsSLOMetricV2",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/operations_s_l_o_assessment_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "assessment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Assessment Sha256",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/OperationsSLOMetricV2"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Metrics",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/OperationsSLOAssessmentOutcomeV2"
    },
    "policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/operations-slo-assessment/v2",
      "default": "eval-factory/operations-slo-assessment/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "policy_ref",
    "metrics",
    "evidence_refs",
    "outcome",
    "assessment_sha256",
    "audit"
  ],
  "title": "OperationsSLOAssessmentV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.production_readiness_review_v2.OperationsSLOAssessmentV2",
  "x-schema-version": "eval-factory/operations-slo-assessment/v2"
}
