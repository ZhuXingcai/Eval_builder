{
  "$defs": {
    "AgentTaskStatusV2": {
      "enum": [
        "PENDING",
        "READY",
        "LEASED",
        "TERMINAL",
        "CANCELLED"
      ],
      "title": "AgentTaskStatusV2",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/agent_task_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_definition_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "agent_task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Agent Task Id",
      "type": "string"
    },
    "attempt": {
      "maximum": 100,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "compiled_plan_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "expected_output_object_types": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Expected Output Object Types",
      "type": "array"
    },
    "input_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 10000,
      "title": "Input Refs",
      "type": "array"
    },
    "max_attempts": {
      "maximum": 100,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "plan_task_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Plan Task Key",
      "type": "string"
    },
    "required_capability_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Required Capability Refs",
      "type": "array"
    },
    "run_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/agent-task/v2",
      "default": "eval-factory/agent-task/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentTaskStatusV2"
    },
    "task_kind": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Task Kind",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "agent_task_id",
    "run_ref",
    "compiled_plan_ref",
    "plan_task_key",
    "task_kind",
    "agent_definition_ref",
    "expected_output_object_types",
    "required_capability_refs",
    "status",
    "attempt",
    "max_attempts"
  ],
  "title": "AgentTaskV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.agent_system_v2.AgentTaskV2",
  "x-schema-version": "eval-factory/agent-task/v2"
}
