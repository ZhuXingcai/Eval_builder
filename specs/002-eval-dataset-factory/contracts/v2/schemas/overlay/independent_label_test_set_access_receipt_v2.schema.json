        "ACCESS_POLICY_STALE",
        "MEMBER_LIMIT_EXCEEDED",
        "MATERIAL_INTEGRITY_FAILED"
      ],
      "title": "LabelTestSetAccessReasonV2",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
