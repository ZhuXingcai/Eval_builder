          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Evaluator Binding Id",
          "type": "string"
        },
        "goal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Goal Id",
          "type": "string"
        },
        "goal_summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Goal Summary",
          "type": "string"
        },
        "judged_object_kind": {
          "$ref": "#/$defs/RubricJudgedObjectKindV2"
