{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ItemLineageAuditOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "INDETERMINATE"
      ],
      "title": "ItemLineageAuditOutcomeV2",
      "type": "string"
    },
    "LineageAuditCheckCodeV2": {
      "enum": [
        "SOURCE_TRACE_LABELS",
        "LABEL_SELECTION",
        "SELECTION_TASK",
        "TASK_R4",
        "R4_ITEM_QUALITY",
        "PACKAGE_PROVENANCE_SET",
        "PACKAGE_ENVIRONMENT_SET",
        "PACKAGE_MEMBER_DERIVATION",
        "CROSS_ITEM_LINEAGE_ALIAS"
      ],
      "title": "LineageAuditCheckCodeV2",
      "type": "string"
    },
    "LineageAuditCheckOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "SKIPPED",
        "INDETERMINATE"
      ],
      "title": "LineageAuditCheckOutcomeV2",
      "type": "string"
    },
    "LineageAuditCheckV2": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "check_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Check Sha256",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/LineageAuditCheckCodeV2"
        },
        "evaluated_count": {
          "minimum": 0,
          "title": "Evaluated Count",
          "type": "integer"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "failed_count": {
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "indeterminate_count": {
          "minimum": 0,
          "title": "Indeterminate Count",
          "type": "integer"
        },
        "item_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Item Ids",
          "type": "array"
        },
        "lineage_audit_check_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Lineage Audit Check Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/LineageAuditCheckOutcomeV2"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/lineage-audit-check/v2",
          "default": "eval-factory/lineage-audit-check/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Subject Refs",
          "type": "array"
        }
      },
      "required": [
        "lineage_audit_check_id",
        "code",
        "outcome",
        "item_ids",
        "subject_refs",
        "evaluated_count",
        "failed_count",
        "indeterminate_count",
        "policy_ref",
        "check_sha256",
        "audit"
      ],
      "title": "LineageAuditCheckV2",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/item_lineage_audit_result_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "base_quality_report_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "check_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Check Refs",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/LineageAuditCheckV2"
      },
      "title": "Checks",
      "type": "array"
    },
    "environment_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "failed_check_count": {
      "minimum": 0,
      "title": "Failed Check Count",
      "type": "integer"
    },
    "final_package_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "indeterminate_check_count": {
      "minimum": 0,
      "title": "Indeterminate Check Count",
      "type": "integer"
    },
    "item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Item Id",
      "type": "string"
    },
    "item_lineage_audit_result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Item Lineage Audit Result Id",
      "type": "string"
    },
    "item_quality_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "label_decision_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Label Decision Refs",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/ItemLineageAuditOutcomeV2"
    },
    "passed_check_count": {
      "minimum": 0,
      "title": "Passed Check Count",
      "type": "integer"
    },
    "policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "provenance_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "r4_task_contract_set_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/item-lineage-audit-result/v2",
      "default": "eval-factory/item-lineage-audit-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_context_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "skipped_check_count": {
      "minimum": 0,
      "title": "Skipped Check Count",
      "type": "integer"
    },
    "source_trace_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "task_draft_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "trace_envelope_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "item_lineage_audit_result_id",
    "item_id",
    "source_trace_ref",
    "trace_envelope_ref",
    "label_decision_refs",
    "selection_context_ref",
    "task_draft_ref",
    "r4_task_contract_set_ref",
    "item_quality_result_ref",
    "base_quality_report_ref",
    "final_package_manifest_ref",
    "provenance_manifest_ref",
    "environment_spec_ref",
    "checks",
    "check_refs",
    "outcome",
    "passed_check_count",
    "failed_check_count",
    "skipped_check_count",
    "indeterminate_check_count",
    "policy_ref",
    "result_sha256",
    "audit"
  ],
  "title": "ItemLineageAuditResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.batch_quality_v2.ItemLineageAuditResultV2",
  "x-schema-version": "eval-factory/item-lineage-audit-result/v2"
}
