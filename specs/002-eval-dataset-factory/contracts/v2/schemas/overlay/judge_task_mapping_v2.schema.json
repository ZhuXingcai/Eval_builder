{
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/judge_task_mapping_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "criterion_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Criterion Ids",
      "type": "array"
    },
    "evaluator_binding_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Evaluator Binding Id",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/judge-task-mapping/v2",
      "default": "eval-factory/judge-task-mapping/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "score_weight_basis_points": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Score Weight Basis Points",
      "type": "integer"
    },
    "task_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Task Key",
      "type": "string"
    }
  },
  "required": [
    "task_key",
    "criterion_ids",
    "evaluator_binding_id",
    "score_weight_basis_points"
  ],
  "title": "JudgeTaskMappingV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.agent_system_v2.JudgeTaskMappingV2",
  "x-schema-version": "eval-factory/judge-task-mapping/v2"
}
