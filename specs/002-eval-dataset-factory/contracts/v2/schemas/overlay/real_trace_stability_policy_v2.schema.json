{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "RealTraceStabilityFaultPointV2": {
      "enum": [
        "before_source_registration",
        "after_source_registration",
        "after_trace_store_persist",
        "before_stage_completion"
      ],
      "title": "RealTraceStabilityFaultPointV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/real_trace_stability_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "const": "raw_traj_v1/1.0.0",
      "default": "raw_traj_v1/1.0.0",
      "title": "Adapter Version",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "fault_points": {
      "default": [
        "before_source_registration",
        "after_source_registration",
        "after_trace_store_persist",
        "before_stage_completion"
      ],
      "items": {
        "$ref": "#/$defs/RealTraceStabilityFaultPointV2"
      },
      "title": "Fault Points",
      "type": "array"
    },
    "file_observation_policy_version": {
      "const": "raw-traj-file-observation/v1",
      "default": "raw-traj-file-observation/v1",
      "title": "File Observation Policy Version",
      "type": "string"
    },
    "max_private_bytes": {
      "maximum": 1000000000,
      "minimum": 2,
      "title": "Max Private Bytes",
      "type": "integer"
    },
    "max_report_bytes": {
      "maximum": 100000000,
      "minimum": 2,
      "title": "Max Report Bytes",
      "type": "integer"
    },
    "max_source_bytes": {
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Max Source Bytes",
      "type": "integer"
    },
    "max_sources": {
      "maximum": 100000,
      "minimum": 100,
      "title": "Max Sources",
      "type": "integer"
    },
    "max_total_source_bytes": {
      "maximum": 1000000000000,
      "minimum": 1,
      "title": "Max Total Source Bytes",
      "type": "integer"
    },
    "max_unexpected_retries": {
      "const": 0,
      "default": 0,
      "title": "Max Unexpected Retries",
      "type": "integer"
    },
    "normalization_policy_version": {
      "const": "raw-traj-event-normalization/v1",
      "default": "raw-traj-event-normalization/v1",
      "title": "Normalization Policy Version",
      "type": "string"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "real-trace-stability/r8-04-v1",
      "default": "real-trace-stability/r8-04-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "recovery_policy_version": {
      "const": "raw-traj-streaming-recovery/v1",
      "default": "raw-traj-streaming-recovery/v1",
      "title": "Recovery Policy Version",
      "type": "string"
    },
    "repair_policy_version": {
      "const": "raw-traj-local-repair/v1",
      "default": "raw-traj-local-repair/v1",
      "title": "Repair Policy Version",
      "type": "string"
    },
    "require_expected_fault": {
      "const": true,
      "default": true,
      "title": "Require Expected Fault",
      "type": "boolean"
    },
    "require_replay_stability": {
      "const": true,
      "default": true,
      "title": "Require Replay Stability",
      "type": "boolean"
    },
    "require_resume_success": {
      "const": true,
      "default": true,
      "title": "Require Resume Success",
      "type": "boolean"
    },
    "require_typed_result": {
      "const": true,
      "default": true,
      "title": "Require Typed Result",
      "type": "boolean"
    },
    "required_completion_witnesses": {
      "const": 1,
      "default": 1,
      "title": "Required Completion Witnesses",
      "type": "integer"
    },
    "required_stable_rate_bps": {
      "const": 10000,
      "default": 10000,
      "title": "Required Stable Rate Bps",
      "type": "integer"
    },
    "required_unique_real_traces": {
      "const": 100,
      "default": 100,
      "title": "Required Unique Real Traces",
      "type": "integer"
    },
    "runner_version": {
      "const": "serial-trace-runner/r1-09-v1",
      "default": "serial-trace-runner/r1-09-v1",
      "title": "Runner Version",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/real-trace-stability-policy/v2",
      "default": "eval-factory/real-trace-stability-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "segmentation_policy_version": {
      "const": "deterministic-interaction-segments/v1",
      "default": "deterministic-interaction-segments/v1",
      "title": "Segmentation Policy Version",
      "type": "string"
    },
    "source_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "storage_policy_version": {
      "const": "stored-manifest/v1",
      "default": "stored-manifest/v1",
      "title": "Storage Policy Version",
      "type": "string"
    },
    "tool_family_policy_version": {
      "const": "raw-traj-tool-family/v1",
      "default": "raw-traj-tool-family/v1",
      "title": "Tool Family Policy Version",
      "type": "string"
    },
    "trace_ir_version": {
      "const": "v1",
      "default": "v1",
      "title": "Trace Ir Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "source_manifest_ref",
    "max_sources",
    "max_source_bytes",
    "max_total_source_bytes",
    "max_private_bytes",
    "max_report_bytes",
    "policy_sha256",
    "audit"
  ],
  "title": "RealTraceStabilityPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.real_trace_stability_v2.RealTraceStabilityPolicyV2",
  "x-schema-version": "eval-factory/real-trace-stability-policy/v2"
}
