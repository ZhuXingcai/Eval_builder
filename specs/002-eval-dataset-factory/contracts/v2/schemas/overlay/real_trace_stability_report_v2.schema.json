      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ParseQuality": {
      "enum": [
        "STRICT",
        "REPAIRED",
        "PARTIAL",
        "UNPARSEABLE"
      ],
      "title": "ParseQuality",
      "type": "string"
    },
    "RealTraceStabilityCaseOutcomeV2": {
      "enum": [
        "STABLE",
        "UNSTABLE",
        "INFRASTRUCTURE_ERROR",
        "INCOMPLETE"
      ],
      "title": "RealTraceStabilityCaseOutcomeV2",
      "type": "string"
    },
