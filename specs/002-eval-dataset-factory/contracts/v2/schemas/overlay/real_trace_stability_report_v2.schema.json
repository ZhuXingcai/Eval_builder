        "unique_instance_count",
        "unique_raw_hash_count",
        "shortfall_count",
        "sample_status",
        "total_raw_bytes",
        "minimum_raw_bytes",
        "maximum_raw_bytes",
        "category_counts",
        "corpus_summary_sha256",
