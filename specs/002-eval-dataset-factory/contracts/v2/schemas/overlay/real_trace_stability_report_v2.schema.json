        "private_case_result_ref",
        "outcome",
        "reason_code",
        "assigned_fault_point",
        "fault_observed",
        "resume_succeeded",
        "replay_stable",
        "attempt_count",
        "unexpected_retry_count",
        "resume_count",
        "replay_count",
        "stage_result_count",
        "completion_witness_count",
        "threshold_matched",
        "case_summary_sha256",
        "audit"
