{
  "$defs": {
    "AttachmentValidationFingerprintCategoryV2": {
      "enum": [
        "FINAL_ANSWER",
        "COMPLETED_DELIVERABLE",
        "PRIVATE_REFERENCE",
        "GRADER_RULE",
        "HIDDEN_PASS_CONDITION",
        "HIDDEN_SELECTION_SIGNAL",
        "TRAJECTORY_SPECIFIC_STEP"
      ],
      "title": "AttachmentValidationFingerprintCategoryV2",
      "type": "string"
    },
    "AttachmentValidationFingerprintMatchKindV2": {
      "enum": [
        "NORMALIZED_FULL_TEXT",
        "TOKEN_WINDOW",
        "PATH_COMPONENT"
      ],
      "title": "AttachmentValidationFingerprintMatchKindV2",
      "type": "string"
    },
    "AttachmentValidationFingerprintV2": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/AttachmentValidationFingerprintCategoryV2"
        },
        "digest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest Sha256",
          "type": "string"
        },
        "fingerprint_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Fingerprint Id",
          "type": "string"
        },
        "match_kind": {
          "$ref": "#/$defs/AttachmentValidationFingerprintMatchKindV2"
        },
        "normalization_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Normalization Version",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-validation-fingerprint/v2",
          "default": "env-mock-agent/attachment-validation-fingerprint/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "token_count": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "fingerprint_id",
        "category",
        "match_kind",
        "digest_sha256",
        "token_count",
        "normalization_version"
      ],
      "title": "AttachmentValidationFingerprintV2",
      "type": "object"
    },
    "AttachmentValidationPiiRuleV2": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-validation-pii-rule/v2",
          "default": "env-mock-agent/attachment-validation-pii-rule/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "pattern"
      ],
      "title": "AttachmentValidationPiiRuleV2",
      "type": "object"
    },
    "AttachmentValidationScanLimitsV2": {
      "additionalProperties": false,
      "properties": {
        "max_compression_ratio": {
          "default": 1000.0,
          "exclusiveMinimum": 0,
          "title": "Max Compression Ratio",
          "type": "number"
        },
        "max_expanded_bytes": {
          "default": 500000000,
          "minimum": 1,
          "title": "Max Expanded Bytes",
          "type": "integer"
        },
        "max_extracted_characters": {
          "default": 2000000,
          "minimum": 1,
          "title": "Max Extracted Characters",
          "type": "integer"
        },
        "max_file_bytes": {
          "default": 100000000,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_inventory_members": {
          "default": 20000,
          "minimum": 1,
          "title": "Max Inventory Members",
          "type": "integer"
        },
        "max_nested_depth": {
          "default": 4,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Nested Depth",
          "type": "integer"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-validation-scan-limits/v2",
          "default": "env-mock-agent/attachment-validation-scan-limits/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "AttachmentValidationScanLimitsV2",
      "type": "object"
    },
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/attachment_validation_request_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_result_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "build_spec_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "complete_leakage_categories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AttachmentValidationFingerprintCategoryV2"
      },
      "title": "Complete Leakage Categories",
      "type": "array"
    },
    "configured_pii_rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AttachmentValidationPiiRuleV2"
      },
      "title": "Configured Pii Rules",
      "type": "array"
    },
    "declared_validator_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Declared Validator Ids",
      "type": "array"
    },
    "execution_request_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "execution_result_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "forbidden_output_values": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Forbidden Output Values",
      "type": "array"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "leakage_fingerprints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AttachmentValidationFingerprintV2"
      },
      "title": "Leakage Fingerprints",
      "type": "array"
    },
    "leakage_reference_set_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "logical_path": {
      "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
      "title": "Logical Path",
      "type": "string"
    },
    "media_type": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
      "title": "Media Type",
      "type": "string"
    },
    "output_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "attachment-validation/r5-08-v1",
      "default": "attachment-validation/r5-08-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "producer_task_view_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "scan_limits": {
      "$ref": "#/$defs/AttachmentValidationScanLimitsV2"
    },
    "schema_version": {
      "const": "env-mock-agent/attachment-validation-request/v2",
      "default": "env-mock-agent/attachment-validation-request/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "validation_request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Validation Request Id",
      "type": "string"
    },
    "validation_request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Validation Request Sha256",
      "type": "string"
    }
  },
  "required": [
    "validation_request_id",
    "artifact_id",
    "artifact_result_ref",
    "execution_request_ref",
    "execution_result_ref",
    "build_spec_ref",
    "producer_task_view_ref",
    "output_ref",
    "output_sha256",
    "logical_path",
    "media_type",
    "declared_validator_ids",
    "leakage_reference_set_ref",
    "forbidden_output_values",
    "idempotency_key",
    "validation_request_sha256"
  ],
  "title": "AttachmentValidationRequestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.validation_v2.AttachmentValidationRequestV2",
  "x-schema-version": "env-mock-agent/attachment-validation-request/v2"
}
