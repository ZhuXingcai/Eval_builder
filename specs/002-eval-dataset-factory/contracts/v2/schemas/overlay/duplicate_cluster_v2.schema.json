{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "DuplicateSubjectKindV2": {
      "enum": [
        "TASK",
        "ATTACHMENT"
      ],
      "title": "DuplicateSubjectKindV2",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/duplicate_cluster_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "cluster_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cluster Sha256",
      "type": "string"
    },
    "clustering_mode": {
      "const": "CONNECTED_COMPONENTS",
      "default": "CONNECTED_COMPONENTS",
      "title": "Clustering Mode",
      "type": "string"
    },
    "direct_pair_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Direct Pair Refs",
      "type": "array"
    },
    "duplicate_cluster_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Duplicate Cluster Id",
      "type": "string"
    },
    "exact_pair_count": {
      "minimum": 0,
      "title": "Exact Pair Count",
      "type": "integer"
    },
    "member_item_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 2,
      "title": "Member Item Ids",
      "type": "array"
    },
    "member_subject_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 2,
      "title": "Member Subject Refs",
      "type": "array"
    },
    "near_pair_count": {
      "minimum": 0,
      "title": "Near Pair Count",
      "type": "integer"
    },
    "policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/duplicate-cluster/v2",
      "default": "eval-factory/duplicate-cluster/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_kind": {
      "$ref": "#/$defs/DuplicateSubjectKindV2"
    }
  },
  "required": [
    "duplicate_cluster_id",
    "subject_kind",
    "member_item_ids",
    "member_subject_refs",
    "direct_pair_refs",
    "exact_pair_count",
    "near_pair_count",
    "policy_ref",
    "cluster_sha256",
    "audit"
  ],
  "title": "DuplicateClusterV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.duplicate_v2.DuplicateClusterV2",
  "x-schema-version": "eval-factory/duplicate-cluster/v2"
}
