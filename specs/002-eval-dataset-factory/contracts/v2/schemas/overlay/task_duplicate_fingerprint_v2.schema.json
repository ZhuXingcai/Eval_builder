{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/task_duplicate_fingerprint_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "exact_task_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Exact Task Sha256",
      "type": "string"
    },
    "fingerprint_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Fingerprint Sha256",
      "type": "string"
    },
    "item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Item Id",
      "type": "string"
    },
    "normalization_version": {
      "const": "task-duplicate-normalization/r7-01-v1",
      "default": "task-duplicate-normalization/r7-01-v1",
      "title": "Normalization Version",
      "type": "string"
    },
    "policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "r4_task_contract_set_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/task-duplicate-fingerprint/v2",
      "default": "eval-factory/task-duplicate-fingerprint/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "shingle_count": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Shingle Count",
      "type": "integer"
    },
    "similarity_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Similarity Fingerprint",
      "type": "string"
    },
    "task_draft_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "token_count": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Token Count",
      "type": "integer"
    }
  },
  "required": [
    "item_id",
    "task_draft_ref",
    "r4_task_contract_set_ref",
    "exact_task_sha256",
    "similarity_fingerprint",
    "token_count",
    "shingle_count",
    "policy_ref",
    "fingerprint_sha256",
    "audit"
  ],
  "title": "TaskDuplicateFingerprintV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.duplicate_v2.TaskDuplicateFingerprintV2",
  "x-schema-version": "eval-factory/task-duplicate-fingerprint/v2"
}
