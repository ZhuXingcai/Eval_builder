{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/work_dispatch_decision_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "eligible_at": {
      "format": "date-time",
      "title": "Eligible At",
      "type": "string"
    },
    "policy_version": {
      "const": "work-control/r6-05-v1",
      "default": "work-control/r6-05-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "resolved_job_work_graph_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "retry_decision_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "eval-factory/work-dispatch-decision/v2",
      "default": "eval-factory/work-dispatch-decision/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "work_control_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "work_dispatch_decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Work Dispatch Decision Id",
      "type": "string"
    },
    "work_dispatch_decision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Work Dispatch Decision Sha256",
      "type": "string"
    },
    "work_readiness_snapshot_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "work_unit_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "work_dispatch_decision_id",
    "resolved_job_work_graph_ref",
    "work_unit_ref",
    "work_readiness_snapshot_ref",
    "work_control_policy_ref",
    "attempt",
    "eligible_at",
    "work_dispatch_decision_sha256",
    "audit"
  ],
  "title": "WorkDispatchDecisionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.orchestration_v2.WorkDispatchDecisionV2",
  "x-schema-version": "eval-factory/work-dispatch-decision/v2"
}
