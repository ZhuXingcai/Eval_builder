{
  "$defs": {
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/world_ledger_snapshot_request_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "policy_version": {
      "const": "artifact-execution/r5-06-v1",
      "default": "artifact-execution/r5-06-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "required_fact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Required Fact Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "env-mock-agent/world-ledger-snapshot-request/v2",
      "default": "env-mock-agent/world-ledger-snapshot-request/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Snapshot Request Id",
      "type": "string"
    },
    "snapshot_request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Request Sha256",
      "type": "string"
    },
    "world_ledger_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    }
  },
  "required": [
    "snapshot_request_id",
    "world_ledger_ref",
    "required_fact_ids",
    "idempotency_key",
    "snapshot_request_sha256"
  ],
  "title": "WorldLedgerSnapshotRequestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.execution_v2.WorldLedgerSnapshotRequestV2",
  "x-schema-version": "env-mock-agent/world-ledger-snapshot-request/v2"
}
