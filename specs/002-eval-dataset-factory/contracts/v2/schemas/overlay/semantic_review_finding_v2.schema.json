{
  "$defs": {
    "AttachmentSemanticReviewFindingCodeV2": {
      "enum": [
        "REQUIRED_COVERAGE_MISSING",
        "DEPENDENCY_NOT_SOLVABLE",
        "PUBLIC_RUBRIC_UNREACHABLE",
        "SAFE_EVIDENCE_INSUFFICIENT",
        "CAPABILITY_CONTRACT_MISMATCH",
        "WORLD_FACT_INCONSISTENT",
        "SOURCE_EVIDENCE_INCONSISTENT",
        "ARTIFACT_CONTENT_UNREALISTIC",
        "CROSS_ARTIFACT_INCONSISTENT",
        "ARTIFACT_METADATA_INCONSISTENT",
        "ANSWER_BEARING_CONTENT",
        "COMPLETED_DELIVERABLE_EXPOSED",
        "PRIVATE_REFERENCE_DERIVATION",
        "GRADER_RULE_DISCLOSURE",
        "HIDDEN_PASS_CONDITION_DISCLOSURE",
        "ORIGINAL_FINAL_OUTPUT_DERIVATION",
        "EXECUTABILITY_FAILURE",
        "EVALUATOR_CONTRACT_MISMATCH",
        "TOOL_POLICY_MISMATCH"
      ],
      "title": "AttachmentSemanticReviewFindingCodeV2",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "SemanticFindingScopeV2": {
      "enum": [
        "ITEM",
        "ARTIFACT"
      ],
      "title": "SemanticFindingScopeV2",
      "type": "string"
    },
    "SemanticReviewRoundV2": {
      "enum": [
        "COVERAGE_SOLVABILITY",
        "REALISM_CONSISTENCY",
        "LEAKAGE_EXECUTABILITY"
      ],
      "title": "SemanticReviewRoundV2",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "Severity",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/semantic_review_finding_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "artifact_repair_allowed": {
      "title": "Artifact Repair Allowed",
      "type": "boolean"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "candidate_revision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "code": {
      "$ref": "#/$defs/AttachmentSemanticReviewFindingCodeV2"
    },
    "evidence_ref_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Evidence Ref Ids",
      "type": "array"
    },
    "facade_finding_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "facade_review_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "finding_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Finding Sha256",
      "type": "string"
    },
    "non_waivable": {
      "title": "Non Waivable",
      "type": "boolean"
    },
    "policy_version": {
      "const": "semantic-review/r5-09-v1",
      "default": "semantic-review/r5-09-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "predecessor_finding_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "round": {
      "$ref": "#/$defs/SemanticReviewRoundV2"
    },
    "schema_version": {
      "const": "eval-factory/semantic-review-finding/v2",
      "default": "eval-factory/semantic-review-finding/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/SemanticFindingScopeV2"
    },
    "semantic_review_finding_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Semantic Review Finding Id",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "const": "OPEN",
      "default": "OPEN",
      "title": "Status",
      "type": "string"
    },
    "subject_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Subject Refs",
      "type": "array"
    }
  },
  "required": [
    "semantic_review_finding_id",
    "facade_finding_ref",
    "facade_review_result_ref",
    "round",
    "scope",
    "code",
    "candidate_revision_ref",
    "subject_refs",
    "artifact_ids",
    "evidence_ref_ids",
    "severity",
    "non_waivable",
    "artifact_repair_allowed",
    "finding_sha256",
    "audit"
  ],
  "title": "SemanticReviewFindingV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.review_v2.SemanticReviewFindingV2",
  "x-schema-version": "eval-factory/semantic-review-finding/v2"
}
