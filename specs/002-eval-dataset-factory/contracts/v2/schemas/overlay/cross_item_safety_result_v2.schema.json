          "minItems": 1,
          "title": "Match Kinds",
          "type": "array"
        },
        "matched_fingerprint_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Matched Fingerprint Refs",
          "type": "array"
        },
        "non_waivable": {
          "const": true,
          "default": true,
          "title": "Non Waivable",
          "type": "boolean"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/cross-item-visible-match-evidence/v2",
          "default": "eval-factory/cross-item-visible-match-evidence/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Source Item Id",
          "type": "string"
        },
        "source_reference_set_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "source_subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "target_item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Target Item Id",
          "type": "string"
        },
        "target_subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "target_surface": {
          "$ref": "#/$defs/CrossItemSafetySurfaceKindV2"
