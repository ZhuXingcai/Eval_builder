        "direct_evidence_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Direct Evidence Refs",
          "type": "array"
        },
        "member_item_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Member Item Ids",
          "type": "array"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/cross-item-safety-cluster/v2",
          "default": "eval-factory/cross-item-safety-cluster/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "cross_item_safety_cluster_id",
        "cluster_kind",
        "member_item_ids",
        "direct_evidence_refs",
        "policy_ref",
        "cluster_sha256",
        "audit"
      ],
      "title": "CrossItemSafetyClusterV2",
      "type": "object"
    },
    "CrossItemSafetyEvidenceKindV2": {
      "enum": [
        "LEAKAGE",
        "CONTAMINATION"
      ],
      "title": "CrossItemSafetyEvidenceKindV2",
      "type": "string"
    },
    "CrossItemSafetySurfaceKindV2": {
      "enum": [
        "PROMPT",
        "ATTACHMENT"
      ],
      "title": "CrossItemSafetySurfaceKindV2",
      "type": "string"
