{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "LabelTestSetPartitionKindV2": {
      "enum": [
        "TRAIN",
        "DEVELOPMENT"
      ],
      "title": "LabelTestSetPartitionKindV2",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/independent_label_partition_manifest_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "partition_kind": {
      "$ref": "#/$defs/LabelTestSetPartitionKindV2"
    },
    "partition_manifest_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Partition Manifest Id",
      "type": "string"
    },
    "partition_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Partition Manifest Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "independent-label-test-set/r8-01-v1",
      "default": "independent-label-test-set/r8-01-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "private_material_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/independent-label-partition-manifest/v2",
      "default": "eval-factory/independent-label-partition-manifest/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_authority_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Source Authority Refs",
      "type": "array"
    },
    "trace_count": {
      "maximum": 10000000,
      "minimum": 0,
      "title": "Trace Count",
      "type": "integer"
    },
    "unique_raw_hash_count": {
      "maximum": 10000000,
      "minimum": 0,
      "title": "Unique Raw Hash Count",
      "type": "integer"
    }
  },
  "required": [
    "partition_manifest_id",
    "partition_kind",
    "private_material_ref",
    "trace_count",
    "unique_raw_hash_count",
    "source_authority_refs",
    "partition_manifest_sha256",
    "audit"
  ],
  "title": "IndependentLabelPartitionManifestV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.statistics_v2.IndependentLabelPartitionManifestV2",
  "x-schema-version": "eval-factory/independent-label-partition-manifest/v2"
}
