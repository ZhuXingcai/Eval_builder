{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ProductionReadinessInvalidationTriggerV2": {
      "enum": [
        "SYSTEM_VERSION_CHANGED",
        "BASE_CONTRACT_MANIFEST_CHANGED",
        "OVERLAY_CONTRACT_MANIFEST_CHANGED",
        "SCHEMA_SET_CHANGED",
        "POLICY_SET_CHANGED",
        "EVIDENCE_SUPERSEDED",
        "ISSUER_REGISTRY_CHANGED",
        "ISSUER_REVOKED_OR_EXPIRED",
        "ATTESTATION_EXPIRED",
        "EXPLICIT_INCIDENT_REVOCATION",
        "EXPLICIT_RELEASE_REVOCATION"
      ],
      "title": "ProductionReadinessInvalidationTriggerV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/production_readiness_invalidation_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "max_invalidation_refs": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Invalidation Refs",
      "type": "integer"
    },
    "max_projection_revisions": {
      "maximum": 1000000,
      "minimum": 2,
      "title": "Max Projection Revisions",
      "type": "integer"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "production-readiness-attestation/r8-08-v1",
      "default": "production-readiness-attestation/r8-08-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "required_triggers": {
      "default": [
        "SYSTEM_VERSION_CHANGED",
        "BASE_CONTRACT_MANIFEST_CHANGED",
        "OVERLAY_CONTRACT_MANIFEST_CHANGED",
        "SCHEMA_SET_CHANGED",
        "POLICY_SET_CHANGED",
        "EVIDENCE_SUPERSEDED",
        "ISSUER_REGISTRY_CHANGED",
        "ISSUER_REVOKED_OR_EXPIRED",
        "ATTESTATION_EXPIRED",
        "EXPLICIT_INCIDENT_REVOCATION",
        "EXPLICIT_RELEASE_REVOCATION"
      ],
      "items": {
        "$ref": "#/$defs/ProductionReadinessInvalidationTriggerV2"
      },
      "title": "Required Triggers",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/production-readiness-invalidation-policy/v2",
      "default": "eval-factory/production-readiness-invalidation-policy/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "max_projection_revisions",
    "max_invalidation_refs",
    "policy_sha256",
    "audit"
  ],
  "title": "ProductionReadinessInvalidationPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.production_attestation_v2.ProductionReadinessInvalidationPolicyV2",
  "x-schema-version": "eval-factory/production-readiness-invalidation-policy/v2"
}
