{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "RewriteFidelity": {
      "enum": [
        "TRACE_FAITHFUL",
        "CAPABILITY_PRESERVING",
        "STANDARD_ENVIRONMENT"
      ],
      "title": "RewriteFidelity",
      "type": "string"
    },
    "TaskRewriteExamplePreviewV2": {
      "additionalProperties": false,
      "properties": {
        "example_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Example Id",
          "type": "string"
        },
        "expected_treatment": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Expected Treatment",
          "type": "string"
        },
        "input_summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Input Summary",
          "type": "string"
        },
        "kind": {
          "const": "REWRITE",
          "default": "REWRITE",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/task-rewrite-example-preview/v2",
          "default": "eval-factory/task-rewrite-example-preview/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "example_id",
        "input_summary",
        "expected_treatment"
      ],
      "title": "TaskRewriteExamplePreviewV2",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/task_rewrite_plan_preview_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "examples": {
      "items": {
        "$ref": "#/$defs/TaskRewriteExamplePreviewV2"
      },
      "minItems": 1,
      "title": "Examples",
      "type": "array"
    },
    "expected_capability_impact": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Expected Capability Impact",
      "type": "string"
    },
    "fidelity": {
      "$ref": "#/$defs/RewriteFidelity"
    },
    "forbidden_content_rules": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Forbidden Content Rules",
      "type": "array"
    },
    "operational_noise_policy": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Operational Noise Policy",
      "type": "string"
    },
    "preview_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Preview Id",
      "type": "string"
    },
    "preview_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Preview Sha256",
      "type": "string"
    },
    "projection_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Projection Policy Version",
      "type": "string"
    },
    "rewrite_style": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Rewrite Style",
      "type": "string"
    },
    "safety_gate_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/task-rewrite-plan-preview/v2",
      "default": "eval-factory/task-rewrite-plan-preview/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_plan_version_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "target_capability": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Target Capability",
      "type": "string"
    }
  },
  "required": [
    "preview_id",
    "source_plan_version_ref",
    "target_capability",
    "rewrite_style",
    "fidelity",
    "operational_noise_policy",
    "examples",
    "forbidden_content_rules",
    "expected_capability_impact",
    "safety_gate_ref",
    "projection_policy_version",
    "preview_sha256",
    "audit"
  ],
  "title": "TaskRewritePlanPreviewV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.TaskRewritePlanPreviewV2",
  "x-schema-version": "eval-factory/task-rewrite-plan-preview/v2"
}
