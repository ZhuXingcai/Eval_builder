{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/public_source_retrieval_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "allowed_host_suffixes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Host Suffixes",
      "type": "array"
    },
    "allowed_schemes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Schemes",
      "type": "array"
    },
    "approved_fetch_provider_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Approved Fetch Provider Ids",
      "type": "array"
    },
    "approved_search_provider_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Approved Search Provider Ids",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "license_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "max_fetch_bytes": {
      "minimum": 1,
      "title": "Max Fetch Bytes",
      "type": "integer"
    },
    "max_search_results": {
      "maximum": 100,
      "minimum": 1,
      "title": "Max Search Results",
      "type": "integer"
    },
    "network_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "public_source_retrieval_policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Public Source Retrieval Policy Id",
      "type": "string"
    },
    "public_source_retrieval_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Public Source Retrieval Policy Sha256",
      "type": "string"
    },
    "query_egress_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "safety_scan_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/public-source-retrieval-policy/v2",
      "default": "eval-factory/public-source-retrieval-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_usage_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "public_source_retrieval_policy_id",
    "approved_fetch_provider_ids",
    "allowed_schemes",
    "allowed_host_suffixes",
    "max_search_results",
    "max_fetch_bytes",
    "query_egress_policy_ref",
    "network_policy_ref",
    "source_usage_policy_ref",
    "safety_scan_policy_ref",
    "license_policy_ref",
    "policy_version",
    "public_source_retrieval_policy_sha256",
    "audit"
  ],
  "title": "PublicSourceRetrievalPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.attachment_v2.PublicSourceRetrievalPolicyV2",
  "x-schema-version": "eval-factory/public-source-retrieval-policy/v2"
}
