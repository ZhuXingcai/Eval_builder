{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/artifact_routing_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "approved_provider_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Approved Provider Ids",
      "type": "array"
    },
    "artifact_routing_policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Artifact Routing Policy Id",
      "type": "string"
    },
    "artifact_routing_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Routing Policy Sha256",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "deterministic_provider_first": {
      "const": true,
      "title": "Deterministic Provider First",
      "type": "boolean"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "provider_capability_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "runtime_capability_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "runtime_model_profile_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Runtime Model Profile Refs",
      "type": "array"
    },
    "runtime_order": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Runtime Order",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/artifact-routing-policy/v2",
      "default": "eval-factory/artifact-routing-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "silent_degradation_allowed": {
      "const": false,
      "title": "Silent Degradation Allowed",
      "type": "boolean"
    },
    "validator_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "artifact_routing_policy_id",
    "deterministic_provider_first",
    "approved_provider_ids",
    "runtime_order",
    "runtime_model_profile_refs",
    "provider_capability_policy_ref",
    "runtime_capability_policy_ref",
    "validator_policy_ref",
    "silent_degradation_allowed",
    "policy_version",
    "artifact_routing_policy_sha256",
    "audit"
  ],
  "title": "ArtifactRoutingPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.attachment_v2.ArtifactRoutingPolicyV2",
  "x-schema-version": "eval-factory/artifact-routing-policy/v2"
}
