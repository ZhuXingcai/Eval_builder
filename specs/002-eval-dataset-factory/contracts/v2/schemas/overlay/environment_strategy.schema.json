{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "EnvironmentAlternative": {
      "additionalProperties": false,
      "properties": {
        "blocking_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocking Reason"
        },
        "capability_impact": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Capability Impact",
          "type": "string"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "schema_version": {
          "const": "eval-factory/environment-alternative/v2",
          "default": "eval-factory/environment-alternative/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/EnvironmentStrategyChoice"
        }
      },
      "required": [
        "strategy",
        "feasible",
        "capability_impact"
      ],
      "title": "EnvironmentAlternative",
      "type": "object"
    },
    "EnvironmentRequirement": {
      "additionalProperties": false,
      "properties": {
        "affected_subject_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Affected Subject Refs",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/EnvironmentAlternative"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Alternatives",
          "type": "array"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "requires_nonstandard_environment": {
          "title": "Requires Nonstandard Environment",
          "type": "boolean"
        },
        "requires_special_account": {
          "title": "Requires Special Account",
          "type": "boolean"
        },
        "schema_version": {
          "const": "eval-factory/environment-requirement/v2",
          "default": "eval-factory/environment-requirement/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "affected_subject_refs",
        "description",
        "requires_special_account",
        "requires_nonstandard_environment",
        "evidence_refs",
        "alternatives"
      ],
      "title": "EnvironmentRequirement",
      "type": "object"
    },
    "EnvironmentStrategyChoice": {
      "enum": [
        "TRACE_FAITHFUL_MOCK",
        "REWRITE_STANDARD_ENV",
        "EXCLUDE_TASK"
      ],
      "title": "EnvironmentStrategyChoice",
      "type": "string"
    },
    "EvidencePolarity": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "UNCERTAINTY",
        "CONTRADICTION"
      ],
      "title": "EvidencePolarity",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Capability",
          "type": "string"
        },
        "capability_complete": {
          "title": "Capability Complete",
          "type": "boolean"
        },
        "evidence_ref_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Evidence Ref Id",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/EvidencePolarity"
        },
        "schema_version": {
          "const": "eval-factory/evidence-ref/v1",
          "default": "eval-factory/evidence-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpanRef"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        },
        "subject_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "evidence_ref_id",
        "subject_ref",
        "source_spans",
        "polarity",
        "capability",
        "capability_complete"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "QueryPackagingChoice": {
      "enum": [
        "INCLUDE_QUERY_YAML",
        "OMIT_QUERY_YAML",
        "ASK_PER_TASK"
      ],
      "title": "QueryPackagingChoice",
      "type": "string"
    },
    "SourceSpanRef": {
      "additionalProperties": false,
      "properties": {
        "approximate": {
          "default": false,
          "title": "Approximate",
          "type": "boolean"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/source-span-ref/v1",
          "default": "eval-factory/source-span-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_trace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Source Trace Id",
          "type": "string"
        },
        "span_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "source_trace_id",
        "raw_sha256"
      ],
      "title": "SourceSpanRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/environment_strategy.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "credential_fabrication_forbidden": {
      "const": true,
      "default": true,
      "title": "Credential Fabrication Forbidden",
      "type": "boolean"
    },
    "environment_strategy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Environment Strategy Id",
      "type": "string"
    },
    "query_packaging_options": {
      "items": {
        "$ref": "#/$defs/QueryPackagingChoice"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Query Packaging Options",
      "type": "array",
      "uniqueItems": true
    },
    "recommendation_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation Reason"
    },
    "recommended_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentStrategyChoice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/EnvironmentRequirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/environment-strategy/v2",
      "default": "eval-factory/environment-strategy/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "environment_strategy_id",
    "requirements",
    "query_packaging_options",
    "audit"
  ],
  "title": "EnvironmentStrategy",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.approval.EnvironmentStrategy",
  "x-schema-version": "eval-factory/environment-strategy/v2"
}
