  "required": [
    "work_model_cancellation_result_id",
    "cancellation_request_ref",
    "facade_cancellation_result_ref",
    "outcome",
    "completed_at",
    "work_model_cancellation_result_sha256",
    "audit"
  ],
  "title": "WorkModelCancellationResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.model_control_v2.WorkModelCancellationResultV2",
  "x-schema-version": "eval-factory/work-model-cancellation-result/v2"
}
