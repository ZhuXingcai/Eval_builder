    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "facade_cancellation_result_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "outcome": {
      "$ref": "#/$defs/WorkModelCancellationOutcomeV2"
    },
    "policy_version": {
      "const": "model-control/r6-03-v1",
      "default": "model-control/r6-03-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/work-model-cancellation-result/v2",
      "default": "eval-factory/work-model-cancellation-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "work_model_cancellation_result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Work Model Cancellation Result Id",
      "type": "string"
    },
    "work_model_cancellation_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
