    "status": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "work_unit_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
