    "related_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Related Refs",
      "type": "array"
    },
    "result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Result Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/batch-audit-event/v2",
      "default": "eval-factory/batch-audit-event/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_family": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Source Family",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "source_version": {
      "minimum": 0,
      "title": "Source Version",
      "type": "integer"
    },
    "stage": {
