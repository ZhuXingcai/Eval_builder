          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outbox Event Id"
    },
    "policy_version": {
      "const": "batch-observability/r6-06-v1",
      "default": "batch-observability/r6-06-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
