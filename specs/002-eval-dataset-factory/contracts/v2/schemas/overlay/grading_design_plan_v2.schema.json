      "type": "array"
    },
    "rubric_set_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "run_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/grading-design-plan/v2",
      "default": "eval-factory/grading-design-plan/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "specialist_tool_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Specialist Tool Ids",
      "type": "array"
    },
    "tool_policy_ref": {
