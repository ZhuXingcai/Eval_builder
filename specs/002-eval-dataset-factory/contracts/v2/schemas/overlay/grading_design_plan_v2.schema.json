      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Data Classifications",
      "type": "array"
    },
    "data_purpose": {
      "const": "grading-design-authoring",
      "default": "grading-design-authoring",
      "title": "Data Purpose",
      "type": "string"
    },
    "escalate_on_reference_unavailable": {
      "title": "Escalate On Reference Unavailable",
      "type": "boolean"
    },
    "evaluator_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "generator_model_profile_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "judge_input_schema_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "judge_output_schema_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "judge_prompt_template_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "judge_tasks": {
      "items": {
        "$ref": "#/$defs/JudgeTaskMappingV2"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Judge Tasks",
      "type": "array"
    },
    "max_attempts": {
      "maximum": 100,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_cost_micro_usd": {
      "maximum": 1000000000000,
      "minimum": 1,
      "title": "Max Cost Micro Usd",
      "type": "integer"
    },
    "max_model_requests": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Model Requests",
      "type": "integer"
    },
    "max_model_tokens": {
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Max Model Tokens",
      "type": "integer"
    },
    "minimum_confidence_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Minimum Confidence Basis Points",
      "type": "integer"
    },
    "model_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "passing_score_basis_points": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Passing Score Basis Points",
      "type": "integer"
    },
    "plan_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_version": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "predecessor_plan_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "required_capability_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Required Capability Ids",
      "type": "array"
    },
    "required_output_fields": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{1,127}$",
        "type": "string"
