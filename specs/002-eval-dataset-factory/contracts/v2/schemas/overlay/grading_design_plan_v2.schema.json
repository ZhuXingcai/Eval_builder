      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Agent Role",
      "type": "string"
    },
    "aggregation_mode": {
      "$ref": "#/$defs/JudgeAggregationModeV2"
    },
    "allowed_judge_model_profile_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Allowed Judge Model Profile Refs",
      "type": "array"
    },
    "audit": {
