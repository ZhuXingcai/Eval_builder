{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    },
    "WorkReadinessV2": {
      "enum": [
        "READY",
        "WAITING",
        "BLOCKED_DEPENDENCY",
        "SKIPPED_ITEM"
      ],
      "title": "WorkReadinessV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/work_readiness_snapshot_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_group_fanout_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "policy_version": {
      "const": "dataset-work-graph/r6-02-v1",
      "default": "dataset-work-graph/r6-02-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "readiness": {
      "$ref": "#/$defs/WorkReadinessV2"
    },
    "resolved_job_work_graph_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "retryable_dependency_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Retryable Dependency Result Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/work-readiness-snapshot/v2",
      "default": "eval-factory/work-readiness-snapshot/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_review_fanout_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "skipped_item_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Skipped Item Refs",
      "type": "array"
    },
    "succeeded_dependency_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Succeeded Dependency Result Refs",
      "type": "array"
    },
    "terminal_non_success_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Terminal Non Success Result Refs",
      "type": "array"
    },
    "waiting_dependency_work_unit_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Waiting Dependency Work Unit Refs",
      "type": "array"
    },
    "work_readiness_snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Work Readiness Snapshot Id",
      "type": "string"
    },
    "work_readiness_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Work Readiness Snapshot Sha256",
      "type": "string"
    },
    "work_unit_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "work_readiness_snapshot_id",
    "resolved_job_work_graph_ref",
    "work_unit_ref",
    "readiness",
    "work_readiness_snapshot_sha256",
    "audit"
  ],
  "title": "WorkReadinessSnapshotV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.orchestration_v2.WorkReadinessSnapshotV2",
  "x-schema-version": "eval-factory/work-readiness-snapshot/v2"
}
