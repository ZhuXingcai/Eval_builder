        "span_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "source_trace_id",
        "raw_sha256"
      ],
      "title": "AttachmentExecutionSourceSpanV2",
      "type": "object"
    },
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
