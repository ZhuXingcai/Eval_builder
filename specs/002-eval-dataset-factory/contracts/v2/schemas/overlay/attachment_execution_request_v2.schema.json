      "title": "AttachmentExecutionEvidenceGrantV2",
      "type": "object"
    },
    "AttachmentExecutionRouteKindV2": {
      "enum": [
        "PROVIDER",
        "RUNTIME"
      ],
      "title": "AttachmentExecutionRouteKindV2",
      "type": "string"
    },
    "AttachmentExecutionSourceSpanV2": {
      "additionalProperties": false,
      "properties": {
        "approximate": {
          "default": false,
          "title": "Approximate",
          "type": "boolean"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-execution-source-span/v2",
