        "polarity": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "UNCERTAINTY",
            "CONTRADICTION"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-execution-evidence-grant/v2",
          "default": "env-mock-agent/attachment-execution-evidence-grant/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_spans": {
          "items": {
