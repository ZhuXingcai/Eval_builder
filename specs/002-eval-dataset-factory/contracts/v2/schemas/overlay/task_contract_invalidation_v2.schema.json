{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "TaskRewriteRebuildStageV2": {
      "enum": [
        "TASK_DRAFT",
        "PROMPT_SAFETY",
        "RUBRIC",
        "EVALUATOR_REFERENCE",
        "TOOL_POLICY",
        "PRODUCER_VIEW"
      ],
      "title": "TaskRewriteRebuildStageV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/task_contract_invalidation_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "changed_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Changed Paths",
      "type": "array"
    },
    "hard_gate_revalidation_required": {
      "const": true,
      "default": true,
      "title": "Hard Gate Revalidation Required",
      "type": "boolean"
    },
    "invalidated_object_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 9,
      "minItems": 9,
      "title": "Invalidated Object Refs",
      "type": "array"
    },
    "invalidation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Invalidation Id",
      "type": "string"
    },
    "invalidation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Invalidation Sha256",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "preserved_object_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Preserved Object Refs",
      "type": "array"
    },
    "replacement_plan_version_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "required_rebuild_stages": {
      "items": {
        "$ref": "#/$defs/TaskRewriteRebuildStageV2"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Required Rebuild Stages",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/task-contract-invalidation/v2",
      "default": "eval-factory/task-contract-invalidation/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_contract_set_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "source_plan_version_ref": {
      "$ref": "#/$defs/ObjectRef"
    }
  },
  "required": [
    "invalidation_id",
    "source_plan_version_ref",
    "replacement_plan_version_ref",
    "source_contract_set_ref",
    "changed_paths",
    "invalidated_object_refs",
    "preserved_object_refs",
    "required_rebuild_stages",
    "policy_version",
    "invalidation_sha256",
    "audit"
  ],
  "title": "TaskContractInvalidationV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.TaskContractInvalidationV2",
  "x-schema-version": "eval-factory/task-contract-invalidation/v2"
}
