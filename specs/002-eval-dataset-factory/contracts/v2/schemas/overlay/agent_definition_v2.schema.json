{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/agent_definition_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_definition_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Agent Definition Id",
      "type": "string"
    },
    "agent_role": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Agent Role",
      "type": "string"
    },
    "agent_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Version",
      "type": "string"
    },
    "allowed_data_classifications": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Allowed Data Classifications",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "capability_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Capability Refs",
      "type": "array"
    },
    "data_purpose": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Data Purpose",
      "type": "string"
    },
    "max_attempts": {
      "maximum": 100,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_cost_micro_usd": {
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Max Cost Micro Usd",
      "type": "integer"
    },
    "max_model_requests": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Max Model Requests",
      "type": "integer"
    },
    "max_model_tokens": {
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Max Model Tokens",
      "type": "integer"
    },
    "model_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "network_allowed": {
      "title": "Network Allowed",
      "type": "boolean"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "prompt_template_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/agent-definition/v2",
      "default": "eval-factory/agent-definition/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Tool Ids",
      "type": "array"
    },
    "validator_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Validator Refs",
      "type": "array"
    },
    "workspace_isolated": {
      "const": true,
      "default": true,
      "title": "Workspace Isolated",
      "type": "boolean"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "agent_definition_id",
    "agent_role",
    "agent_version",
    "capability_refs",
    "prompt_template_ref",
    "model_policy_ref",
    "data_purpose",
    "allowed_data_classifications",
    "validator_refs",
    "max_attempts",
    "max_model_requests",
    "max_model_tokens",
    "max_cost_micro_usd",
    "network_allowed"
  ],
  "title": "AgentDefinitionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.agent_system_v2.AgentDefinitionV2",
  "x-schema-version": "eval-factory/agent-definition/v2"
}
