{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ResolvedWorkUnitV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_execution_group_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "depends_on_work_unit_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Depends On Work Unit Refs",
          "type": "array"
        },
        "item_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Job Id",
          "type": "string"
        },
        "join_mode": {
          "$ref": "#/$defs/WorkDependencyJoinModeV2"
        },
        "policy_version": {
          "const": "dataset-work-graph/r6-02-v1",
          "default": "dataset-work-graph/r6-02-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "resolved_work_unit_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Resolved Work Unit Id",
          "type": "string"
        },
        "resolved_work_unit_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Resolved Work Unit Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/resolved-work-unit/v2",
          "default": "eval-factory/resolved-work-unit/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/WorkUnitScopeV2"
        },
        "semantic_review_round": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticReviewRoundV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_trace_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stage": {
          "$ref": "#/$defs/StageNameV2"
        }
      },
      "required": [
        "resolved_work_unit_id",
        "scope",
        "stage",
        "job_id",
        "join_mode",
        "resolved_work_unit_sha256"
      ],
      "title": "ResolvedWorkUnitV2",
      "type": "object"
    },
    "SemanticReviewRoundV2": {
      "enum": [
        "COVERAGE_SOLVABILITY",
        "REALISM_CONSISTENCY",
        "LEAKAGE_EXECUTABILITY"
      ],
      "title": "SemanticReviewRoundV2",
      "type": "string"
    },
    "StageNameV2": {
      "enum": [
        "trace_index",
        "safety",
        "label_plan",
        "label",
        "task_rewrite_plan",
        "task_authoring",
        "environment_strategy",
        "attachment",
        "item_quality",
        "batch_quality",
        "final_dataset_review",
        "release"
      ],
      "title": "StageNameV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    },
    "WorkDependencyJoinModeV2": {
      "enum": [
        "ALL_SUCCEEDED",
        "ALL_TERMINAL"
      ],
      "title": "WorkDependencyJoinModeV2",
      "type": "string"
    },
    "WorkUnitScopeV2": {
      "enum": [
        "JOB",
        "ITEM",
        "ARTIFACT_GROUP"
      ],
      "title": "WorkUnitScopeV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/artifact_group_fanout_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_execution_plan_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "artifact_group_fanout_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Artifact Group Fanout Id",
      "type": "string"
    },
    "artifact_group_fanout_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Group Fanout Sha256",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "group_work_units": {
      "items": {
        "$ref": "#/$defs/ResolvedWorkUnitV2"
      },
      "minItems": 1,
      "title": "Group Work Units",
      "type": "array"
    },
    "parent_attachment_work_unit_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "policy_version": {
      "const": "dataset-work-graph/r6-02-v1",
      "default": "dataset-work-graph/r6-02-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "resolved_job_work_graph_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/artifact-group-fanout/v2",
      "default": "eval-factory/artifact-group-fanout/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_group_fanout_id",
    "resolved_job_work_graph_ref",
    "parent_attachment_work_unit_ref",
    "artifact_execution_plan_ref",
    "group_work_units",
    "artifact_group_fanout_sha256",
    "audit"
  ],
  "title": "ArtifactGroupFanoutV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.orchestration_v2.ArtifactGroupFanoutV2",
  "x-schema-version": "eval-factory/artifact-group-fanout/v2"
}
