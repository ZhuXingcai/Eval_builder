        "failed_count": {
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "indeterminate_count": {
          "minimum": 0,
          "title": "Indeterminate Count",
          "type": "integer"
        },
        "item_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Item Ids",
          "type": "array"
        },
        "lineage_audit_check_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Lineage Audit Check Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/LineageAuditCheckOutcomeV2"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
