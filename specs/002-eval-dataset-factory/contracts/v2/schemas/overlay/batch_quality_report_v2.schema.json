{
  "$defs": {
    "BatchFindingCategoryV2": {
      "enum": [
        "EXACT_TASK_DUPLICATE",
        "NEAR_TASK_DUPLICATE",
        "EXACT_ATTACHMENT_DUPLICATE",
        "NEAR_ATTACHMENT_DUPLICATE",
        "CROSS_ITEM_CONTAMINATION",
        "CROSS_ITEM_LEAKAGE",
        "ANSWER_REUSE",
        "LINEAGE_INCOMPLETE",
        "LINEAGE_INDETERMINATE",
        "CROSS_ITEM_LINEAGE_ALIAS"
      ],
      "title": "BatchFindingCategoryV2",
      "type": "string"
    },
    "BatchFindingScopeV2": {
      "enum": [
        "ITEM",
        "BATCH"
      ],
      "title": "BatchFindingScopeV2",
      "type": "string"
    },
    "BatchReviewerFindingV2": {
      "additionalProperties": false,
      "properties": {
        "affected_item_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Item Ids",
          "type": "array"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "batch_reviewer_finding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Batch Reviewer Finding Id",
          "type": "string"
        },
        "blocked_item_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Blocked Item Ids",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/BatchFindingCategoryV2"
        },
        "direct_evidence_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "finding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Finding Sha256",
          "type": "string"
        },
        "non_waivable": {
          "title": "Non Waivable",
          "type": "boolean"
        },
        "owner_item_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Item Id"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "release_blocking": {
          "title": "Release Blocking",
          "type": "boolean"
        },
        "restricted_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptLeakageCategoryV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "eval-factory/batch-reviewer-finding/v2",
          "default": "eval-factory/batch-reviewer-finding/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/BatchFindingScopeV2"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "const": "OPEN",
          "default": "OPEN",
          "title": "Status",
          "type": "string"
        },
        "subject_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Subject Refs",
          "type": "array"
        }
      },
      "required": [
        "batch_reviewer_finding_id",
        "scope",
        "category",
        "severity",
        "affected_item_ids",
        "subject_refs",
        "direct_evidence_ref",
        "non_waivable",
        "release_blocking",
        "policy_ref",
        "finding_sha256",
        "audit"
      ],
      "title": "BatchReviewerFindingV2",
      "type": "object"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ItemLineageAuditOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "INDETERMINATE"
      ],
      "title": "ItemLineageAuditOutcomeV2",
      "type": "string"
    },
    "ItemLineageAuditResultV2": {
      "additionalProperties": false,
