        "item_quality_report_revision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Item Quality Report Revision Id",
          "type": "string"
        },
        "open_p0_count": {
          "minimum": 0,
          "title": "Open P0 Count",
          "type": "integer"
        },
        "open_p1_count": {
          "minimum": 0,
          "title": "Open P1 Count",
          "type": "integer"
        },
        "package_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Package Sha256",
          "type": "string"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "provenance_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "release_revalidation_required": {
          "const": true,
