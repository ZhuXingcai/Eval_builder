    "LineageAuditCheckV2": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "check_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Check Sha256",
          "type": "string"
