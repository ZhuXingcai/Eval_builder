    "LineageAuditCheckCodeV2": {
      "enum": [
        "SOURCE_TRACE_LABELS",
        "LABEL_SELECTION",
        "SELECTION_TASK",
        "TASK_R4",
        "R4_ITEM_QUALITY",
        "PACKAGE_PROVENANCE_SET",
        "PACKAGE_ENVIRONMENT_SET",
        "PACKAGE_MEMBER_DERIVATION",
        "CROSS_ITEM_LINEAGE_ALIAS"
      ],
      "title": "LineageAuditCheckCodeV2",
      "type": "string"
    },
    "LineageAuditCheckOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "SKIPPED",
        "INDETERMINATE"
