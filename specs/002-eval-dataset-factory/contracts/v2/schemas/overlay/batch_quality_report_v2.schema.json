        "base_item_quality_result_ref",
        "base_quality_report_ref",
        "final_package_manifest_ref",
        "provenance_manifest_ref",
        "environment_spec_ref",
        "accepted_artifact_refs",
        "package_sha256",
        "findings",
        "finding_refs",
        "open_p0_count",
        "open_p1_count",
        "unresolved_non_waivable_count",
        "policy_ref",
        "revision_sha256",
        "audit"
      ],
