          "title": "Check Refs",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/LineageAuditCheckV2"
          },
          "title": "Checks",
          "type": "array"
        },
        "environment_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "failed_check_count": {
          "minimum": 0,
          "title": "Failed Check Count",
          "type": "integer"
        },
        "final_package_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "indeterminate_check_count": {
          "minimum": 0,
          "title": "Indeterminate Check Count",
          "type": "integer"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Item Id",
          "type": "string"
        },
        "item_lineage_audit_result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Item Lineage Audit Result Id",
          "type": "string"
        },
        "item_quality_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "label_decision_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Label Decision Refs",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/ItemLineageAuditOutcomeV2"
        },
        "passed_check_count": {
          "minimum": 0,
          "title": "Passed Check Count",
          "type": "integer"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "provenance_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "r4_task_contract_set_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/item-lineage-audit-result/v2",
          "default": "eval-factory/item-lineage-audit-result/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_context_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "skipped_check_count": {
          "minimum": 0,
          "title": "Skipped Check Count",
          "type": "integer"
        },
        "source_trace_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "task_draft_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "trace_envelope_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "item_lineage_audit_result_id",
        "item_id",
        "source_trace_ref",
        "trace_envelope_ref",
        "label_decision_refs",
        "selection_context_ref",
        "task_draft_ref",
        "r4_task_contract_set_ref",
        "item_quality_result_ref",
        "base_quality_report_ref",
        "final_package_manifest_ref",
        "provenance_manifest_ref",
        "environment_spec_ref",
        "checks",
        "check_refs",
        "outcome",
        "passed_check_count",
        "failed_check_count",
        "skipped_check_count",
        "indeterminate_check_count",
        "policy_ref",
        "result_sha256",
        "audit"
      ],
      "title": "ItemLineageAuditResultV2",
      "type": "object"
    },
    "ItemQualityReportRevisionV2": {
      "additionalProperties": false,
      "properties": {
        "accepted_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Accepted Artifact Refs",
          "type": "array"
        },
        "approvable": {
          "const": false,
          "default": false,
          "title": "Approvable",
          "type": "boolean"
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "base_item_quality_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "base_quality_report_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "environment_spec_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "final_package_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "finding_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Finding Refs",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/BatchReviewerFindingV2"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Item Id",
          "type": "string"
