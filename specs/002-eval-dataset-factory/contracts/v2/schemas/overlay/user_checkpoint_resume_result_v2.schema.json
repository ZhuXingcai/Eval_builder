{
  "$defs": {
    "ApprovalCheckpoint": {
      "enum": [
        "LABEL_PLAN",
        "TASK_REWRITE_PLAN",
        "ENVIRONMENT_STRATEGY",
        "FINAL_DATASET_REVIEW"
      ],
      "title": "ApprovalCheckpoint",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "CREATED",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "UserCheckpointInteractionStateV2": {
      "enum": [
        "PENDING_DECISION",
        "RESUMABLE",
        "WAITING_REVISION",
        "WAITING_REVALIDATION",
        "DEFERRED",
        "RESUMED",
        "TERMINATED",
        "SUPERSEDED"
      ],
      "title": "UserCheckpointInteractionStateV2",
      "type": "string"
    },
    "UserCheckpointInteractionV2": {
      "additionalProperties": false,
      "properties": {
        "application_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audit": {
          "$ref": "#/$defs/ContractAudit"
        },
        "chain_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Chain Id",
          "type": "string"
        },
        "checkpoint": {
          "$ref": "#/$defs/ApprovalCheckpoint"
        },
        "decision_commit_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interaction_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Interaction Id",
          "type": "string"
        },
        "interaction_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Interaction Sha256",
          "type": "string"
        },
        "interaction_version": {
          "minimum": 1,
          "title": "Interaction Version",
          "type": "integer"
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Job Id",
          "type": "string"
        },
        "job_status": {
          "$ref": "#/$defs/JobStatus"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "policy_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "predecessor_interaction_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "presentation_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "request_compilation_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "request_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "schema_version": {
          "const": "eval-factory/user-checkpoint-interaction/v2",
          "default": "eval-factory/user-checkpoint-interaction/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_context_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "state": {
          "$ref": "#/$defs/UserCheckpointInteractionStateV2"
        }
      },
      "required": [
        "interaction_id",
        "job_id",
        "chain_id",
        "interaction_version",
        "checkpoint",
        "request_compilation_ref",
        "request_ref",
        "presentation_ref",
        "source_context_ref",
        "state",
        "job_status",
        "occurred_at",
        "policy_ref",
        "interaction_sha256",
        "audit"
      ],
      "title": "UserCheckpointInteractionV2",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/user_checkpoint_resume_result_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "application_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "decision_commit_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "incomplete_work_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Incomplete Work Refs",
      "type": "array"
    },
    "interaction": {
      "$ref": "#/$defs/UserCheckpointInteractionV2"
    },
    "job_status": {
      "const": "RUNNING",
      "default": "RUNNING",
      "title": "Job Status",
      "type": "string"
    },
    "job_version": {
      "minimum": 0,
      "title": "Job Version",
      "type": "integer"
    },
    "predecessor_interaction_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Result Id",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "revalidation_ready_work_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Revalidation Ready Work Refs",
      "type": "array"
    },
    "revalidation_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "eval-factory/user-checkpoint-resume-result/v2",
      "default": "eval-factory/user-checkpoint-resume-result/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "predecessor_interaction_ref",
    "interaction",
    "decision_commit_ref",
    "job_version",
    "result_sha256",
    "audit"
  ],
  "title": "UserCheckpointResumeResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.checkpoint_interaction_v2.UserCheckpointResumeResultV2",
  "x-schema-version": "eval-factory/user-checkpoint-resume-result/v2"
}
