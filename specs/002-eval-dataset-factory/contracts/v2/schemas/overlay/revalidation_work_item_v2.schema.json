{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "RevalidationWorkScopeV2": {
      "enum": [
        "JOB",
        "ITEM"
      ],
      "title": "RevalidationWorkScopeV2",
      "type": "string"
    },
    "StageNameV2": {
      "enum": [
        "trace_index",
        "safety",
        "label_plan",
        "label",
        "task_rewrite_plan",
        "task_authoring",
        "environment_strategy",
        "attachment",
        "item_quality",
        "batch_quality",
        "final_dataset_review",
        "release"
      ],
      "title": "StageNameV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/revalidation_work_item_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "application_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "depends_on_work_item_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Depends On Work Item Refs",
      "type": "array"
    },
    "hard_gate_required": {
      "title": "Hard Gate Required",
      "type": "boolean"
    },
    "invalidated_input_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Invalidated Input Refs",
      "type": "array"
    },
    "item_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "policy_version": {
      "const": "user-plan-application/r7-06-v1",
      "default": "user-plan-application/r7-06-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "replacement_input_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Replacement Input Refs",
      "type": "array"
    },
    "required_output_types": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Output Types",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/revalidation-work-item/v2",
      "default": "eval-factory/revalidation-work-item/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/RevalidationWorkScopeV2"
    },
    "stage": {
      "$ref": "#/$defs/StageNameV2"
    },
    "work_item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Work Item Id",
      "type": "string"
    },
    "work_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Work Sha256",
      "type": "string"
    }
  },
  "required": [
    "work_item_id",
    "application_ref",
    "scope",
    "stage",
    "invalidated_input_refs",
    "required_output_types",
    "hard_gate_required",
    "work_sha256"
  ],
  "title": "RevalidationWorkItemV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.approval_application_v2.RevalidationWorkItemV2",
  "x-schema-version": "eval-factory/revalidation-work-item/v2"
}
