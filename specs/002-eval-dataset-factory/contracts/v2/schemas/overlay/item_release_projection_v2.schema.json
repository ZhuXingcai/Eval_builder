{
  "$defs": {
    "ApprovalCheckpoint": {
      "enum": [
        "LABEL_PLAN",
        "TASK_REWRITE_PLAN",
        "ENVIRONMENT_STRATEGY",
        "FINAL_DATASET_REVIEW"
      ],
      "title": "ApprovalCheckpoint",
      "type": "string"
    },
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ItemStatus": {
      "enum": [
        "CANDIDATE",
        "RUNNING",
        "NEEDS_REVIEW",
        "APPROVED",
        "REJECTED",
        "RELEASED",
        "REVOKED",
        "FAILED"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ReleaseStateV2": {
      "enum": [
        "CANDIDATE",
        "REJECTED",
        "APPROVED",
        "RELEASED",
        "REVOKED"
      ],
      "title": "ReleaseStateV2",
      "type": "string"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/item_release_projection_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "chain_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Chain Id",
      "type": "string"
    },
    "evaluation_item_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Item Id",
      "type": "string"
    },
    "item_status": {
      "$ref": "#/$defs/ItemStatus"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Job Id",
      "type": "string"
    },
    "pending_checkpoints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ApprovalCheckpoint"
      },
      "title": "Pending Checkpoints",
      "type": "array"
    },
    "policy_version": {
      "const": "release-projection/r7-08-v1",
      "default": "release-projection/r7-08-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "previous_projection_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "projection_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Projection Id",
      "type": "string"
    },
    "projection_revision": {
      "minimum": 1,
      "title": "Projection Revision",
      "type": "integer"
    },
    "projection_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Projection Sha256",
      "type": "string"
    },
    "release_decision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "release_state": {
      "$ref": "#/$defs/ReleaseStateV2"
    },
    "release_subject_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/item-release-projection/v2",
      "default": "eval-factory/item-release-projection/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "projection_id",
    "job_id",
    "item_id",
    "projection_revision",
    "chain_id",
    "release_subject_ref",
    "evaluation_item_ref",
    "release_decision_ref",
    "release_state",
    "item_status",
    "projection_sha256",
    "audit"
  ],
  "title": "ItemReleaseProjectionV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.release_projection_v2.ItemReleaseProjectionV2",
  "x-schema-version": "eval-factory/item-release-projection/v2"
}
