{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/producer_storage_authorization_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "authorization_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Authorization Id",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "authorized_subject_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Authorized Subject Refs",
      "type": "array"
    },
    "canonical_store_access": {
      "const": false,
      "default": false,
      "title": "Canonical Store Access",
      "type": "boolean"
    },
    "credentials_issued": {
      "const": false,
      "default": false,
      "title": "Credentials Issued",
      "type": "boolean"
    },
    "evidence_bundle_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Evidence Bundle Refs",
      "type": "array"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "private_reference_store_access": {
      "const": false,
      "default": false,
      "title": "Private Reference Store Access",
      "type": "boolean"
    },
    "producer_principal_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Producer Principal Id",
      "type": "string"
    },
    "projection_policy_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "purpose": {
      "const": "ATTACHMENT_PRODUCTION",
      "default": "ATTACHMENT_PRODUCTION",
      "title": "Purpose",
      "type": "string"
    },
    "quarantine_store_access": {
      "const": false,
      "default": false,
      "title": "Quarantine Store Access",
      "type": "boolean"
    },
    "raw_store_access": {
      "const": false,
      "default": false,
      "title": "Raw Store Access",
      "type": "boolean"
    },
    "schema_version": {
      "const": "eval-factory/producer-storage-authorization/v2",
      "default": "eval-factory/producer-storage-authorization/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_task_draft_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Task Draft Sha256",
      "type": "string"
    }
  },
  "required": [
    "authorization_id",
    "producer_principal_id",
    "source_task_draft_sha256",
    "projection_policy_ref",
    "evidence_bundle_refs",
    "policy_version",
    "authorization_sha256",
    "audit"
  ],
  "title": "ProducerStorageAuthorizationV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.ProducerStorageAuthorizationV2",
  "x-schema-version": "eval-factory/producer-storage-authorization/v2"
}
