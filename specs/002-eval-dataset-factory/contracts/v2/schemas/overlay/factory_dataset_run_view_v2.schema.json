{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "FactoryDatasetNextActionV2": {
      "enum": [
        "ADVANCE",
        "REVIEW_PLAN",
        "INSPECT_OUTPUT",
        "NONE"
      ],
      "title": "FactoryDatasetNextActionV2",
      "type": "string"
    },
    "FactoryRunStatusV2": {
      "enum": [
        "CREATED",
        "PLANNING",
        "WAITING_REVIEW",
        "RUNNING",
        "BLOCKED",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "FactoryRunStatusV2",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/factory_dataset_run_view_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "aggregate_result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "blocked_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Blocked Count",
      "type": "integer"
    },
    "candidate_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "dataset_run_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "delivery_manifest_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "incomplete_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Incomplete Count",
      "type": "integer"
    },
    "item_binding_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1000000,
      "title": "Item Binding Refs",
      "type": "array"
    },
    "next_action": {
      "$ref": "#/$defs/FactoryDatasetNextActionV2"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Object Sha256",
      "type": "string"
    },
    "pending_review_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 10000,
      "title": "Pending Review Refs",
      "type": "array"
    },
    "rejected_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Rejected Count",
      "type": "integer"
    },
    "request_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/factory-dataset-run-view/v2",
      "default": "eval-factory/factory-dataset-run-view/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/FactoryRunStatusV2"
    }
  },
  "required": [
    "object_id",
    "object_sha256",
    "audit",
    "request_ref",
    "dataset_run_ref",
    "status",
    "candidate_count",
    "rejected_count",
    "blocked_count",
    "incomplete_count",
    "next_action"
  ],
  "title": "FactoryDatasetRunViewV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.dataset_runtime_v2.FactoryDatasetRunViewV2",
  "x-schema-version": "eval-factory/factory-dataset-run-view/v2"
}
