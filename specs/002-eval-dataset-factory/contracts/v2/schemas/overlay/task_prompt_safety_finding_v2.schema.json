{
  "$defs": {
    "PromptLeakageCategoryV2": {
      "enum": [
        "FINAL_ANSWER",
        "COMPLETED_DELIVERABLE",
        "PRIVATE_REFERENCE",
        "GRADER_RULE",
        "HIDDEN_PASS_CONDITION",
        "HIDDEN_SELECTION_SIGNAL",
        "TRAJECTORY_SPECIFIC_STEP"
      ],
      "title": "PromptLeakageCategoryV2",
      "type": "string"
    },
    "PromptLeakageDetectorV2": {
      "enum": [
        "DETERMINISTIC_FINGERPRINT",
        "SEMANTIC_RESIDUAL"
      ],
      "title": "PromptLeakageDetectorV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/task_prompt_safety_finding_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "category": {
      "$ref": "#/$defs/PromptLeakageCategoryV2"
    },
    "detector": {
      "$ref": "#/$defs/PromptLeakageDetectorV2"
    },
    "finding_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Finding Id",
      "type": "string"
    },
    "matched_fingerprint_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Matched Fingerprint Ids",
      "type": "array"
    },
    "non_waivable": {
      "const": true,
      "default": true,
      "title": "Non Waivable",
      "type": "boolean"
    },
    "prompt_span_end": {
      "exclusiveMinimum": 0,
      "title": "Prompt Span End",
      "type": "integer"
    },
    "prompt_span_start": {
      "minimum": 0,
      "title": "Prompt Span Start",
      "type": "integer"
    },
    "rule_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": "eval-factory/task-prompt-safety-finding/v2",
      "default": "eval-factory/task-prompt-safety-finding/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "category",
    "detector",
    "prompt_span_start",
    "prompt_span_end",
    "rule_id"
  ],
  "title": "TaskPromptSafetyFindingV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.TaskPromptSafetyFindingV2",
  "x-schema-version": "eval-factory/task-prompt-safety-finding/v2"
}
