          ],
          "default": null,
          "title": "Media Type"
        },
        "member_type": {
          "$ref": "#/$defs/LHWorkspaceExportMemberTypeV2"
        },
        "normalized_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Normalized Path",
          "type": "string"
        },
        "output_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "schema_version": {
          "const": "env-mock-agent/lh-workspace-export-member/v2",
          "default": "env-mock-agent/lh-workspace-export-member/v2",
          "title": "Schema Version",
          "type": "string"
