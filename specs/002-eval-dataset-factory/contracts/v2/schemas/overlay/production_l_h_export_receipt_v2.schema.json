{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "FacadeObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "FacadeObjectRef",
      "type": "object"
    },
    "LHWorkspaceExportFailureCodeV2": {
      "enum": [
        "MATERIAL_NOT_FOUND",
        "MATERIAL_MISMATCH",
        "SOURCE_PATH_VIOLATION",
        "DESTINATION_PATH_VIOLATION",
        "SYMLINK_UNSUPPORTED",
        "SPECIAL_FILE_UNSUPPORTED",
        "SOURCE_HASH_MISMATCH",
        "COPIED_HASH_MISMATCH",
        "INVENTORY_MISMATCH",
        "EXPORT_LIMIT_EXCEEDED",
        "CONTAINER_UNSUPPORTED"
      ],
      "title": "LHWorkspaceExportFailureCodeV2",
      "type": "string"
    },
    "LHWorkspaceExportMemberTypeV2": {
      "enum": [
        "DIRECTORY",
        "FILE",
        "NESTED_MEMBER"
      ],
      "title": "LHWorkspaceExportMemberTypeV2",
      "type": "string"
    },
    "LHWorkspaceExportMemberV2": {
      "additionalProperties": false,
      "properties": {
        "container_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/FacadeObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "member_type": {
          "$ref": "#/$defs/LHWorkspaceExportMemberTypeV2"
        },
        "normalized_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Normalized Path",
          "type": "string"
        },
        "output_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "schema_version": {
          "const": "env-mock-agent/lh-workspace-export-member/v2",
          "default": "env-mock-agent/lh-workspace-export-member/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 5000000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "normalized_path",
        "member_type",
        "size_bytes",
        "output_ref"
      ],
      "title": "LHWorkspaceExportMemberV2",
      "type": "object"
    },
    "LHWorkspaceExportOutcomeV2": {
      "enum": [
        "EXPORTED",
        "BLOCKED"
      ],
