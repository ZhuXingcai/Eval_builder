          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/LHWorkspaceExportOutcomeV2"
        },
        "policy_version": {
          "const": "lh-release-export/r7-09-v1",
          "default": "lh-release-export/r7-09-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "request_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Result Id",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/lh-workspace-export-result/v2",
          "default": "env-mock-agent/lh-workspace-export-result/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_file_count": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Workspace File Count",
          "type": "integer"
        },
        "workspace_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Sha256"
        },
        "workspace_total_bytes": {
          "default": 0,
          "maximum": 5000000000,
          "minimum": 0,
          "title": "Workspace Total Bytes",
          "type": "integer"
        }
      },
      "required": [
        "result_id",
        "request_ref",
        "outcome",
        "result_sha256"
      ],
      "title": "LHWorkspaceExportResultV2",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
