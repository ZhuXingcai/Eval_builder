        "context_view_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "denied_data_families": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Denied Data Families",
          "type": "array"
        },
        "fresh_context": {
          "const": true,
          "default": true,
          "title": "Fresh Context",
          "type": "boolean"
        },
        "hidden_reasoning_included": {
          "const": false,
          "default": false,
          "title": "Hidden Reasoning Included",
          "type": "boolean"
        },
        "included_ref_inventory": {
          "items": {
            "$ref": "#/$defs/FacadeObjectRef"
          },
          "title": "Included Ref Inventory",
          "type": "array"
        },
        "policy_version": {
          "const": "semantic-review/r5-09-v1",
          "default": "semantic-review/r5-09-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "raw_private_reference_included": {
          "const": false,
          "default": false,
          "title": "Raw Private Reference Included",
          "type": "boolean"
        },
        "reviewer_role": {
          "$ref": "#/$defs/AttachmentSemanticReviewerRoleV2"
        },
        "round": {
          "$ref": "#/$defs/AttachmentSemanticReviewRoundV2"
        },
        "runtime_resume_used": {
          "const": false,
          "default": false,
          "title": "Runtime Resume Used",
          "type": "boolean"
        },
        "schema_version": {
          "const": "env-mock-agent/semantic-clean-context-attestation/v2",
          "default": "env-mock-agent/semantic-clean-context-attestation/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_review_request_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "stage_run_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        }
      },
      "required": [
        "attestation_id",
        "semantic_review_request_ref",
        "stage_run_ref",
        "round",
        "reviewer_role",
        "context_view_ref",
        "included_ref_inventory",
        "denied_data_families",
        "attestation_sha256"
      ],
      "title": "SemanticCleanContextAttestationV2",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/attachment_semantic_review_result_v2.schema.json",
