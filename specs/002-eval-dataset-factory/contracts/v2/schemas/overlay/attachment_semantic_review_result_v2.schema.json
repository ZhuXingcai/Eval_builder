  "required": [
    "semantic_review_result_id",
    "semantic_review_request_ref",
    "candidate_revision_ref",
    "deterministic_validation_result_ref",
    "round",
    "reviewer_role",
    "outcome",
    "clean_context_attestation",
    "semantic_review_result_sha256"
  ],
  "title": "AttachmentSemanticReviewResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.semantic_review_v2.AttachmentSemanticReviewResultV2",
  "x-schema-version": "env-mock-agent/attachment-semantic-review-result/v2"
