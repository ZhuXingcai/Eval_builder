    "policy_version": {
      "const": "semantic-review/r5-09-v1",
      "default": "semantic-review/r5-09-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "resolutions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AttachmentSemanticFindingResolutionV2"
      },
      "title": "Resolutions",
      "type": "array"
    },
    "reviewer_role": {
      "$ref": "#/$defs/AttachmentSemanticReviewerRoleV2"
    },
    "round": {
      "$ref": "#/$defs/AttachmentSemanticReviewRoundV2"
    },
    "schema_version": {
      "const": "env-mock-agent/attachment-semantic-review-result/v2",
      "default": "env-mock-agent/attachment-semantic-review-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_review_request_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "semantic_review_result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Semantic Review Result Id",
      "type": "string"
    },
    "semantic_review_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Semantic Review Result Sha256",
      "type": "string"
    }
