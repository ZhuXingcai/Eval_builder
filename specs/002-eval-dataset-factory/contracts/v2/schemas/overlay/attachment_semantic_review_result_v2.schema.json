      "required": [
        "finding_id",
        "semantic_review_request_ref",
        "round",
        "scope",
        "code",
        "candidate_revision_ref",
        "subject_refs",
        "artifact_ids",
        "evidence_ref_ids",
        "severity",
        "non_waivable",
        "artifact_repair_allowed",
        "finding_sha256"
      ],
      "title": "AttachmentSemanticReviewFindingV2",
      "type": "object"
    },
    "AttachmentSemanticReviewOutcomeV2": {
      "enum": [
        "ACCEPTED",
        "REQUIRES_REPAIR",
        "REJECTED",
        "ABSTAINED",
        "BLOCKED"
      ],
      "title": "AttachmentSemanticReviewOutcomeV2",
      "type": "string"
    },
    "AttachmentSemanticReviewRoundV2": {
      "enum": [
        "COVERAGE_SOLVABILITY",
        "REALISM_CONSISTENCY",
        "LEAKAGE_EXECUTABILITY"
      ],
      "title": "AttachmentSemanticReviewRoundV2",
      "type": "string"
    },
    "AttachmentSemanticReviewSeverityV2": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "AttachmentSemanticReviewSeverityV2",
      "type": "string"
    },
    "AttachmentSemanticReviewerRoleV2": {
      "enum": [
        "COVERAGE_SOLVABILITY_REVIEWER",
        "REALISM_CONSISTENCY_REVIEWER",
        "LEAKAGE_EXECUTABILITY_REVIEWER"
      ],
      "title": "AttachmentSemanticReviewerRoleV2",
      "type": "string"
