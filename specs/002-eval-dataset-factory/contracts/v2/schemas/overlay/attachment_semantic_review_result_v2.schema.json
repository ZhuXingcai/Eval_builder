          "title": "Current Subject Refs",
          "type": "array"
        },
        "deterministic_revalidation_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "disposition": {
          "$ref": "#/$defs/AttachmentSemanticResolutionDispositionV2"
        },
        "evidence_ref_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
            "type": "string"
          },
          "title": "Evidence Ref Ids",
          "type": "array"
        },
        "old_subject_refs": {
          "items": {
            "$ref": "#/$defs/FacadeObjectRef"
          },
          "title": "Old Subject Refs",
          "type": "array"
        },
        "prior_finding_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "repair_plan_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "repair_result_refs": {
          "items": {
            "$ref": "#/$defs/FacadeObjectRef"
          },
          "title": "Repair Result Refs",
          "type": "array"
        },
        "resolution_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Resolution Id",
          "type": "string"
        },
        "resolution_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Resolution Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "env-mock-agent/attachment-semantic-finding-resolution/v2",
          "default": "env-mock-agent/attachment-semantic-finding-resolution/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_review_request_ref": {
          "$ref": "#/$defs/FacadeObjectRef"
        },
        "successor_finding_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/FacadeObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "resolution_id",
        "semantic_review_request_ref",
        "prior_finding_ref",
        "old_subject_refs",
        "current_subject_refs",
        "repair_plan_ref",
        "repair_result_refs",
        "deterministic_revalidation_ref",
        "disposition",
        "evidence_ref_ids",
        "resolution_sha256"
      ],
      "title": "AttachmentSemanticFindingResolutionV2",
      "type": "object"
    },
    "AttachmentSemanticFindingScopeV2": {
      "enum": [
        "ITEM",
        "ARTIFACT"
      ],
      "title": "AttachmentSemanticFindingScopeV2",
      "type": "string"
    },
    "AttachmentSemanticResolutionDispositionV2": {
      "enum": [
        "CONFIRMED_RESOLVED",
        "PERSISTS"
      ],
      "title": "AttachmentSemanticResolutionDispositionV2",
      "type": "string"
    },
    "AttachmentSemanticReviewFailureCodeV2": {
      "enum": [
        "INSUFFICIENT_EVIDENCE",
        "MODEL_UNAVAILABLE",
        "CONTEXT_MISSING",
        "CONTEXT_MISMATCH",
        "BACKEND_FAILED",
        "BACKEND_OUTPUT_INVALID",
        "OUTPUT_HASH_MISMATCH"
      ],
      "title": "AttachmentSemanticReviewFailureCodeV2",
      "type": "string"
    },
    "AttachmentSemanticReviewFindingCodeV2": {
      "enum": [
        "REQUIRED_COVERAGE_MISSING",
        "DEPENDENCY_NOT_SOLVABLE",
        "PUBLIC_RUBRIC_UNREACHABLE",
        "SAFE_EVIDENCE_INSUFFICIENT",
        "CAPABILITY_CONTRACT_MISMATCH",
        "WORLD_FACT_INCONSISTENT",
        "SOURCE_EVIDENCE_INCONSISTENT",
        "ARTIFACT_CONTENT_UNREALISTIC",
        "CROSS_ARTIFACT_INCONSISTENT",
        "ARTIFACT_METADATA_INCONSISTENT",
        "ANSWER_BEARING_CONTENT",
        "COMPLETED_DELIVERABLE_EXPOSED",
        "PRIVATE_REFERENCE_DERIVATION",
        "GRADER_RULE_DISCLOSURE",
        "HIDDEN_PASS_CONDITION_DISCLOSURE",
        "ORIGINAL_FINAL_OUTPUT_DERIVATION",
        "EXECUTABILITY_FAILURE",
        "EVALUATOR_CONTRACT_MISMATCH",
        "TOOL_POLICY_MISMATCH"
      ],
      "title": "AttachmentSemanticReviewFindingCodeV2",
      "type": "string"
    },
    "AttachmentSemanticReviewFindingV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
