{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "EnvironmentArtifactV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "artifact_validation_result_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "attachment_dependency_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Attachment Dependency Id",
          "type": "string"
        },
        "candidate_artifact_version_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "logical_path": {
          "pattern": "^[A-Za-z0-9._ -][A-Za-z0-9._/ -]{0,511}$",
          "title": "Logical Path",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Media Type",
          "type": "string"
        },
        "output_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "package_inventory_entry_refs": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "minItems": 1,
          "title": "Package Inventory Entry Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/environment-artifact/v2",
          "default": "eval-factory/environment-artifact/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "attachment_dependency_id",
        "candidate_artifact_version_ref",
        "output_ref",
        "logical_path",
        "media_type",
        "content_sha256",
        "size_bytes",
        "artifact_validation_result_ref",
        "package_inventory_entry_refs",
        "artifact_sha256"
      ],
      "title": "EnvironmentArtifactV2",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/environment_spec_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EnvironmentArtifactV2"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "candidate_artifact_version_refs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Candidate Artifact Version Refs",
      "type": "array"
    },
    "candidate_revision_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "environment_spec_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Environment Spec Id",
      "type": "string"
    },
    "environment_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Environment Spec Sha256",
      "type": "string"
    },
    "final_package_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "input_state_only": {
      "const": true,
      "default": true,
      "title": "Input State Only",
      "type": "boolean"
    },
    "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "policy_version": {
      "const": "item-quality/r5-10-v1",
      "default": "item-quality/r5-10-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "provenance_manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "schema_version": {
      "const": "eval-factory/environment-spec/v2",
      "default": "eval-factory/environment-spec/v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "environment_spec_id",
    "candidate_revision_ref",
    "final_package_manifest_ref",
    "provenance_manifest_ref",
    "candidate_artifact_version_refs",
    "artifacts",
    "artifact_refs",
    "package_sha256",
    "environment_spec_sha256",
    "audit"
  ],
  "title": "EnvironmentSpecV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.quality_v2.EnvironmentSpecV2",
  "x-schema-version": "eval-factory/environment-spec/v2"
}
