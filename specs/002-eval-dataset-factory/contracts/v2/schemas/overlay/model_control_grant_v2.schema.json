      "type": "integer"
    },
    "invocation_handle_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "model_control_grant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Model Control Grant Id",
      "type": "string"
    },
    "model_control_grant_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Control Grant Sha256",
      "type": "string"
    },
    "model_profile_ref": {
      "$ref": "#/$defs/FacadeObjectRef"
    },
    "output_token_limit": {
      "minimum": 1,
      "title": "Output Token Limit",
      "type": "integer"
    },
    "policy_version": {
      "const": "attachment-model-control/r6-03-v1",
      "default": "attachment-model-control/r6-03-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "request_allowance": {
      "minimum": 1,
      "title": "Request Allowance",
