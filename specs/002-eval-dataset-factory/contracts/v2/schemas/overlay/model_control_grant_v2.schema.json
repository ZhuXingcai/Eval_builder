  "required": [
    "model_control_grant_id",
    "reservation_ref",
    "invocation_handle_ref",
    "descriptor_ref",
    "model_profile_ref",
    "fencing_token",
    "request_allowance",
    "token_allowance",
    "output_token_limit",
    "model_control_grant_sha256"
