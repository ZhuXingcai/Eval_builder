{
  "$defs": {
    "ContractAudit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Created By",
          "type": "string"
        },
        "governing_versions": {
          "items": {
            "$ref": "#/$defs/VersionBinding"
          },
          "minItems": 1,
          "title": "Governing Versions",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "eval-factory/contract-audit/v1",
          "default": "eval-factory/contract-audit/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "governing_versions"
      ],
      "title": "ContractAudit",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ToolDenyReasonV2": {
      "enum": [
        "NOT_REQUIRED",
        "CATALOG_POLICY_DENIED"
      ],
      "title": "ToolDenyReasonV2",
      "type": "string"
    },
    "ToolFamily": {
      "enum": [
        "file_read",
        "file_write",
        "file_edit",
        "file_list",
        "search",
        "fetch",
        "shell",
        "code_execution",
        "user_interaction",
        "subagent",
        "task_management",
        "unknown"
      ],
      "title": "ToolFamily",
      "type": "string"
    },
    "ToolRuleActionV2": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "ToolRuleActionV2",
      "type": "string"
    },
    "ToolRuleV2": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ToolRuleActionV2"
        },
        "capability_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "constraint_profile_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "deny_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolDenyReasonV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enforcement_profile_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rule Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/tool-rule/v2",
          "default": "eval-factory/tool-rule/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_family": {
          "$ref": "#/$defs/ToolFamily"
        },
        "tool_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "tool_id",
        "tool_family",
        "action",
        "capability_ref",
        "enforcement_profile_ref",
        "constraint_profile_ref",
        "rule_sha256"
      ],
      "title": "ToolRuleV2",
      "type": "object"
    },
    "VersionBinding": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Component",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/version-binding/v1",
          "default": "eval-factory/version-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/tool_policy_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit": {
      "$ref": "#/$defs/ContractAudit"
    },
    "contestant_projection_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "control_boundary_enforcement_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "default_action": {
      "const": "DENY",
      "default": "DENY",
      "title": "Default Action",
      "type": "string"
    },
    "evaluator_spec_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "rubric_set_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/ToolRuleV2"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/tool-policy/v2",
      "default": "eval-factory/tool-policy/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes_tool_policy_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_draft_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "tool_catalog_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "tool_policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Tool Policy Id",
      "type": "string"
    },
    "tool_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Tool Policy Sha256",
      "type": "string"
    },
    "tool_policy_version": {
      "minimum": 1,
      "title": "Tool Policy Version",
      "type": "integer"
    }
  },
  "required": [
    "tool_policy_id",
    "tool_policy_version",
    "task_draft_ref",
    "rubric_set_ref",
    "evaluator_spec_ref",
    "tool_catalog_ref",
    "control_boundary_enforcement_ref",
    "rules",
    "contestant_projection_ref",
    "policy_version",
    "tool_policy_sha256",
    "audit"
  ],
  "title": "ToolPolicyV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.task_v2.ToolPolicyV2",
  "x-schema-version": "eval-factory/tool-policy/v2"
}
