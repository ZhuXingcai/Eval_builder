{
  "$defs": {
    "PromptLeakageCategoryV2": {
      "enum": [
        "FINAL_ANSWER",
        "COMPLETED_DELIVERABLE",
        "PRIVATE_REFERENCE",
        "GRADER_RULE",
        "HIDDEN_PASS_CONDITION",
        "HIDDEN_SELECTION_SIGNAL",
        "TRAJECTORY_SPECIFIC_STEP"
      ],
      "title": "PromptLeakageCategoryV2",
      "type": "string"
    },
    "TaskPromptSafetyCheckOutcomeV2": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_EVALUATED"
      ],
      "title": "TaskPromptSafetyCheckOutcomeV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/task_prompt_safety_check_v2.schema.json",
  "additionalProperties": false,
