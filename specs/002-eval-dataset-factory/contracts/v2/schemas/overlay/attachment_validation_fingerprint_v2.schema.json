{
  "$defs": {
    "AttachmentValidationFingerprintCategoryV2": {
      "enum": [
        "FINAL_ANSWER",
        "COMPLETED_DELIVERABLE",
        "PRIVATE_REFERENCE",
        "GRADER_RULE",
        "HIDDEN_PASS_CONDITION",
        "HIDDEN_SELECTION_SIGNAL",
        "TRAJECTORY_SPECIFIC_STEP"
      ],
      "title": "AttachmentValidationFingerprintCategoryV2",
      "type": "string"
    },
    "AttachmentValidationFingerprintMatchKindV2": {
      "enum": [
        "NORMALIZED_FULL_TEXT",
        "TOKEN_WINDOW",
        "PATH_COMPONENT"
      ],
      "title": "AttachmentValidationFingerprintMatchKindV2",
      "type": "string"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/attachment_validation_fingerprint_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "category": {
      "$ref": "#/$defs/AttachmentValidationFingerprintCategoryV2"
    },
    "digest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Digest Sha256",
      "type": "string"
    },
    "fingerprint_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Fingerprint Id",
      "type": "string"
    },
    "match_kind": {
      "$ref": "#/$defs/AttachmentValidationFingerprintMatchKindV2"
    },
    "normalization_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Normalization Version",
      "type": "string"
    },
    "schema_version": {
      "const": "env-mock-agent/attachment-validation-fingerprint/v2",
      "default": "env-mock-agent/attachment-validation-fingerprint/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "token_count": {
      "maximum": 20000,
      "minimum": 1,
      "title": "Token Count",
      "type": "integer"
    }
  },
  "required": [
    "fingerprint_id",
    "category",
    "match_kind",
    "digest_sha256",
    "token_count",
    "normalization_version"
  ],
  "title": "AttachmentValidationFingerprintV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "facade",
  "x-python-type": "env_mock_agent.facade.validation_v2.AttachmentValidationFingerprintV2",
  "x-schema-version": "env-mock-agent/attachment-validation-fingerprint/v2"
}
