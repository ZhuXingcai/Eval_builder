{
  "$defs": {
    "BatchAuditOutcomeV2": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ],
      "title": "BatchAuditOutcomeV2",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "CREATED",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
          "title": "Object Type",
          "type": "string"
        },
        "object_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_version": {
          "const": "eval-factory/object-ref/v1",
          "default": "eval-factory/object-ref/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_version",
        "object_sha256"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.eval-factory.local/contracts/v2/overlay/r6_canary_dataset_result_v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit_outcome": {
      "$ref": "#/$defs/BatchAuditOutcomeV2"
    },
    "audit_report_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "blocked_item_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Blocked Item Ids",
      "type": "array"
    },
    "claim_scope": {
      "const": "DEVELOPMENT_CANARY_ONLY",
      "default": "DEVELOPMENT_CANARY_ONLY",
      "title": "Claim Scope",
      "type": "string"
    },
    "failed_item_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Failed Item Ids",
      "type": "array"
    },
    "item_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Item Ids",
      "type": "array"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
      "title": "Job Id",
      "type": "string"
    },
    "job_status": {
      "$ref": "#/$defs/JobStatus"
    },
    "manifest_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "package_manifest_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Package Manifest Refs",
      "type": "array"
    },
    "policy_version": {
      "const": "r6-canary-execution/r6-parent-v1",
      "default": "r6-canary-execution/r6-parent-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "quality_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Quality Result Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "eval-factory/r6-canary-dataset-result/v2",
      "default": "eval-factory/r6-canary-dataset-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "succeeded_item_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$",
        "type": "string"
      },
      "title": "Succeeded Item Ids",
      "type": "array"
    }
  },
  "required": [
    "manifest_ref",
    "job_id",
    "job_status",
    "item_ids",
    "audit_report_ref",
    "audit_outcome"
  ],
  "title": "R6CanaryDatasetResultV2",
  "type": "object",
  "x-contract-layer": "v2-overlay",
  "x-contract-owner": "factory",
  "x-python-type": "eval_factory.contracts.canary_execution_v2.R6CanaryDatasetResultV2",
  "x-schema-version": "eval-factory/r6-canary-dataset-result/v2"
}
